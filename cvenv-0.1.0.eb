# author: Richard Topouchian
easyblock = 'Bundle'

name = 'cvenv'
version = '0.1.0'

homepage = 'https://github.com/TopRichard/cvenv'

lic = 'MIT'

docurls = ['https://github.com/TopRichard/cvenv#readme']

whatis = ['Description: Transparent compressed Python and conda venvs for parallel filesystems']

description = """Compressed Python and Conda Virtual Environments

This module keeps an expanded Python virtual environment or conda environment
in job-local scratch and stores it as one compressed tar archive on the
parallel filesystem.

Typical use:

  module load cvenv
  python -m venv myenv
  source myenv/bin/activate
  pip install numpy pytest
  deactivate

If uv is available, uv venv and uv init are also supported:

  module load cvenv
  uv venv myenv
  source myenv/bin/activate
  uv pip install numpy pytest
  deactivate

An existing archive can be activated with the same command:

  source myenv/bin/activate

Environment variables:

  CV_ARCHIVE_DIR   Archive directory. If unset before module load, the current
                  directory at creation/activation time is used. Do not use
                  /tmp!
  CV_JOB_SCRATCH   Expansion directory. Uses CV_JOB_SCRATCH, then
                   $LOCALSCRATCH, then a private /tmp directory. Each node
                   decompresses into its own node-local scratch path.
  CV_JOB_CACHE     Absolute pip/uv cache directory. If set, overrides
                   PIP_CACHE_DIR and UV_CACHE_DIR, including changes made
                   after module load. Defaults to $LOCALSCRATCH if defined,
                   otherwise $SCRATCH if defined; pip then uses its default,
                   while uv falls back to ${CV_JOB_SCRATCH}/uv-cache only
                   when neither is defined.  Successful mutating commands save
                   immediately on writer nodes.
  CVENV_RO         Set to 1 to skip recompression on deactivation.  Successful
                   mutating commands (pip install, python -m pip install,
                   uv add/remove/sync/run, conda install/remove) save
                   immediately regardless.  Auto-activated uv run uses 1 for
                   its final deactivation unless CVENV_RO=0 is already set;
                   an auto-set value is unset afterward.
  CV_COMPRESS_CPUS  Positive compression thread count.  Uses this value when
                   set before module load; otherwise derives it from
                   SLURM_CPUS_ON_NODE, OMP_NUM_THREADS, or nproc.
  CVENV_ARCHIVE_NAME  Exact archive basename for portable activation when
                   multiple portable archives share a display name.
  CV_DEBUG         Set to 1 to enable additional diagnostic messages.
  Other CV_* variables set by the module are internal and may change between
  releases.

Env-var persistence:
  When the environment is compressed (at creation, after pip/uv/conda
  mutations, or on deactivation), cvenv snapshots environment variables
  into .cvenv-envvars.sh inside the archive.  On the next activation
  those variables are restored automatically.  Variables already set in
  the shell take precedence over saved values, so you can override by
  exporting before activating.

  The minimal built-in allow-list covers PYTHONHASHSEED and
  PYTHONUNBUFFERED. Job-local and framework-specific variables are excluded.

  Note: HF_TOKEN and other secrets are intentionally excluded from the
  allow-list; set them manually after activation or use CV_USER_ prefix.

  To persist your own variables, prefix them with CV_USER_ (e.g.
  export CV_USER_MY_CONFIG=/path/to/config).  All CV_USER_* variables
  are automatically saved and restored.

Notes:
  * The initial archive is written when an environment is created. It is
    updated after successful mutating commands and at deactivation.
  * If compression is interrupted, a .cvenv-lock-<archive-name> directory can
    remain. Remove it only after confirming that no cvenv process is saving
    that archive.
  * If multi-node propagation is interrupted, a .cvenv-propagate.*.sh file can
    remain next to the archive. Remove it only after confirming that no cvenv
    propagation is running.
  * A <archive-name>.README.md is written next to the archive when possible;
    write failures are logged and do not prevent the archive from being saved.
    It lists the Lmod modules that were loaded (from $LOADEDMODULES) and shows
    the exact commands to reload them and reactivate the environment in a new job.
  * The implementation is intended for Bash.
  * Only activate archives from trusted sources; archives can contain executable environment content.
  * Multi-node Slurm allocations are supported.  Each node decompresses
    its own independent copy of the environment into node-local scratch.
    To avoid concurrent-write corruption of the shared archive, only the
    head node (SLURM_NODEID 0) may update the archive.  Archive updates are
    disabled on all other nodes: they can decompress and use the environment,
    but pip install / uv add / deactivate on a non-head node will NOT persist
    changes to the archive.  Install packages on the head node only.
  * In multi-node jobs the environment is automatically propagated to all
    nodes when you activate it on the head node (source myenv/bin/activate
    or conda activate myenv).  After activation, plain 'srun python
    script.py' works on every node because each node already has the venv
    in its own /tmp.
  * Always run deactivate before leaving a job when practical.
  * Deactivate active environments and archive expanded uv environments before
    unloading the cvenv module.
  * Do not activate the same archive concurrently from multiple jobs. The
    last writer would otherwise replace changes made by another job.
  * Archives and scratch directories use deterministic identities derived
    from the canonical environment path or conda identity.  A manifest inside
    each archive detects hash collisions, and creation refuses an existing
    identity instead of overwriting it.
  * cvenv_export <environment-path> <output-directory> creates a portable copy
    with a random identity.  Recipients
    can copy and activate the archive alone; the manifest carries the identity
    and does not retain the original environment path.
  * uv support (venv, init, run) is enabled automatically when uv is found
    on PATH at module load time.  uv's cache uses CV_JOB_CACHE, then
    $LOCALSCRATCH or $SCRATCH, then ${CV_JOB_SCRATCH}/uv-cache.
    Mutating uv commands (pip install, add, remove, sync) and uv run
    auto-activate a local .venv if one exists, so manual
    "source .venv/bin/activate" is optional.  Auto-activated uv run saves
    once before auto-deactivation; active environments auto-deactivate when
    you cd away from the owning directory.  Read-only commands use uv's own
    .venv discovery.
  * conda / miniconda support is enabled automatically when conda is found
    on PATH at module load time.  "conda create", "conda env create", and
    "conda activate" are intercepted so the environment lives in job-local
    scratch while only a compressed archive is stored on the parallel
    filesystem.  "conda install" / "conda remove" against an active
    environment recompress the archive automatically.  "conda deactivate"
    archives and cleans up the scratch copy.  Environments created with
    "conda create -n <name>" use the conda name as their identity; prefix and
    environment-file creations use their canonical paths, so equal basenames
    in different directories remain distinct.
"""

toolchain = SYSTEM

moduleclass = 'tools'

# Embed the Lua implementation in the generated module file, including multi-node Slurm support.
modluafooter = r"""
if mode() == "unload" and (os.getenv("_CV_ACTIVE_NAME") or os.getenv("_CV_EXPANDED_DIR")) then
    LmodError("cvenv: deactivate or archive the expanded environment before unloading the module")
end

-- Configuration -------------------------------------------------------
local user = os.getenv("USER") or os.getenv("LOGNAME") or ""
if user == "" then
    user = (capture("id -un 2>/dev/null") or ""):gsub("%s+$", "")
end
if user == "" then
    user = "unknown"
end
if not user:match("^[A-Za-z0-9._-]+$") then
    user = "unknown"
end
local job_id = os.getenv("SLURM_JOB_ID")
local slurm_num_nodes =
    os.getenv("SLURM_JOB_NUM_NODES") or
    os.getenv("SLURM_NNODES")
local cpus = tonumber(os.getenv("CV_COMPRESS_CPUS"))
    or tonumber(os.getenv("SLURM_CPUS_ON_NODE"))
    or tonumber(os.getenv("OMP_NUM_THREADS"))
    or tonumber(capture("nproc 2>/dev/null") or "") or 1
local module_version = myModuleVersion() or os.getenv("EBVERSIONCVENV") or "unknown"

local requested_cpus = os.getenv("CV_COMPRESS_CPUS")

local function positive_integer(value)
    local number = tonumber(value)
    return number ~= nil and number == math.floor(number) and number > 0
end

local function nonnegative_integer(value)
    local number = tonumber(value)
    return number ~= nil and number == math.floor(number) and number >= 0
end

local multi_node = false
local is_writer = true
if mode() == "load" then
    if os.getenv("VIRTUAL_ENV") or os.getenv("CONDA_PREFIX") then
        LmodError("cvenv: deactivate the active environment before loading the module")
    end

    -- The expanded environment is stored under /tmp on every node; each node extracts its own copy.
    if job_id and job_id ~= "" then
        if not job_id:match("^[0-9]+$") then
            LmodError("cvenv: invalid Slurm job id: " .. tostring(job_id))
        end
        if not slurm_num_nodes or slurm_num_nodes == "" then
            LmodError(
                "cvenv: unable to determine the number of nodes in Slurm job "
                .. job_id
            )
        end

        if not positive_integer(slurm_num_nodes) then
            LmodError(
                "cvenv: invalid Slurm node count: "
                .. tostring(slurm_num_nodes)
            )
        end
    end

    -- In multi-node allocations only the head node (SLURM_NODEID 0) may write the shared archive.
    if job_id and job_id ~= "" then
        local num_nodes = tonumber(slurm_num_nodes) or 1
        if positive_integer(num_nodes) and num_nodes > 1 then
            multi_node = true
            local node_id_raw = os.getenv("SLURM_NODEID")
            if node_id_raw == nil or node_id_raw == "" then
                LmodError("cvenv: SLURM_NODEID is required in a multi-node allocation")
            elseif not nonnegative_integer(node_id_raw) then
                LmodError("cvenv: SLURM_NODEID is invalid in a multi-node allocation")
            else
                local node_id = tonumber(node_id_raw)
                if node_id >= num_nodes then
                    LmodError("cvenv: SLURM_NODEID is outside the allocation")
                end
                is_writer = node_id == 0
            end
        end
    end
end

-- Command detection ---------------------------------------------------
local function command_path(name)
    local p = capture("command -v " .. name .. " 2>/dev/null") or ""
    return (p:gsub("%s+$", ""))
end

local pzstd = command_path("pzstd")
local python = command_path("python")
local python3 = command_path("python3")
local uv = command_path("uv")
local conda = command_path("conda")
local hash_tool = command_path("sha256sum")
local backend_ext

if hash_tool == "" then
    hash_tool = command_path("shasum")
end
if mode() == "load" and hash_tool == "" then
    LmodError("cvenv: neither sha256sum nor shasum is available")
end

if pzstd ~= "" then
    backend_ext = ".tar.zst"
else
    backend_ext = ".tar.gz"
end

if python == "" then
    python = python3
end
if python3 == "" then
    python3 = python
end
if mode() == "load" and python == "" then
    LmodError("cvenv: neither python nor python3 is available")
end

local configured_scratch = os.getenv("CV_JOB_SCRATCH") or os.getenv("LOCALSCRATCH") or ""
local archive_dir = os.getenv("CV_ARCHIVE_DIR") or ""
local job_cache = os.getenv("CV_JOB_CACHE") or os.getenv("LOCALSCRATCH") or os.getenv("SCRATCH") or ""

if mode() == "load" then
    if requested_cpus ~= nil and requested_cpus ~= "" and
       (not requested_cpus:match("^[1-9][0-9]*$") or not positive_integer(requested_cpus)) then
        LmodError("cvenv: CV_COMPRESS_CPUS must be a positive integer")
    end
    if configured_scratch ~= "" and configured_scratch:sub(1, 1) ~= "/" then
        LmodError("cvenv: CV_JOB_SCRATCH must be an absolute path")
    end
    if archive_dir ~= "" and archive_dir:sub(1, 1) ~= "/" then
        LmodError("cvenv: CV_ARCHIVE_DIR must be an absolute path")
    end
    if job_cache ~= "" and job_cache:sub(1, 1) ~= "/" then
        LmodError("cvenv: CV_JOB_CACHE must be an absolute path")
    end
    if not positive_integer(cpus) then
        LmodError("cvenv: CPU count must be a positive integer")
    end
end

local default_scratch
local generated_scratch = false
if configured_scratch ~= "" then
    default_scratch = configured_scratch
elseif mode() == "load" then
    if job_id and job_id ~= "" then
        default_scratch = (capture("mktemp -d /tmp/cvenv-" .. job_id .. "-XXXXXX 2>/dev/null") or ""):gsub("%s+$", "")
    else
        default_scratch = (capture("mktemp -d /tmp/cvenv-" .. user .. "-XXXXXX 2>/dev/null") or ""):gsub("%s+$", "")
    end
    generated_scratch = true
    if default_scratch == "" then
        LmodError("cvenv: unable to create a private job-scratch directory")
    end
else
    default_scratch = configured_scratch ~= "" and configured_scratch or "/tmp/cvenv"
end

local job_scratch = configured_scratch ~= "" and configured_scratch or default_scratch

if mode() == "unload" then
    local unload_scratch = os.getenv("_CV_DEFAULT_SCRATCH") or ""
    if unload_scratch ~= "" and unload_scratch:match("^/tmp/cvenv%-[A-Za-z0-9._-]+$") then
        execute{cmd="rmdir -- " .. unload_scratch, modeA={"unload"}}
    end
end

pushenv("CV_JOB_SCRATCH", job_scratch)
pushenv("_CV_DEFAULT_SCRATCH", generated_scratch and job_scratch or "")
setenv("CV_MODULE_VERSION", module_version)
setenv("CV_MULTI_NODE", multi_node and "1" or "0")
setenv("CV_IS_WRITER", is_writer and "1" or "0")
pushenv("CV_ARCHIVE_DIR", archive_dir)
setenv("CV_BACKEND_EXT", backend_ext)
setenv("CV_PZSTD", pzstd)
pushenv("CV_COMPRESS_CPUS", string.format("%d", cpus))
setenv("CV_ORIGINAL_PYTHON", python)
setenv("CV_ORIGINAL_PYTHON3", python3)
setenv("CV_UV", uv)
setenv("CV_CONDA", conda)
pushenv("CV_JOB_CACHE", job_cache)
if job_cache ~= "" then
    pushenv("PIP_CACHE_DIR", job_cache)
    pushenv("UV_CACHE_DIR", job_cache)
end

-- Bash helper functions -----------------------------------------------
set_shell_function("_cv_log", [==[
printf '\033[1;34m[cvenv]\033[0m %s\n' "$*" >&2
]==], "")

set_shell_function("_cv_validate_public_link", [==[
local link_path="$1" target="$2" allow_stub="${3:-0}" resolved
[ -e "$link_path" ] || [ -L "$link_path" ] || return 0
if [ "$allow_stub" = "1" ] && [ -d "$link_path" ] && [ ! -L "$link_path" ] && \
   [ -f "$link_path/bin/activate" ] && \
   grep -q 'CVENV_STUB' "$link_path/bin/activate" 2>/dev/null; then
    return 0
fi
[ -L "$link_path" ] || return 1
resolved=$(readlink -f -- "$link_path" 2>/dev/null) || resolved=""
if [ -e "$link_path" ]; then
    [ "$resolved" = "$target" ] || return 1
elif [[ "$resolved" == "${CV_JOB_SCRATCH}"/* ]]; then
    return 0
else
    return 1
fi
]==], "")

set_shell_function("_cv_validate_component", [==[
local value="$1"
[ -n "$value" ] || return 1
[[ "$value" =~ [[:cntrl:]] ]] && return 1
case "$value" in
    "."|".."|*/*) return 1 ;;
esac
printf '%s\n' "$value"
]==], "")

set_shell_function("_cv_validate_identity", [==[
local value="$1"
[[ "$value" =~ ^[[:xdigit:]]{64}$ ]] || return 1
printf '%s\n' "$value"
]==], "")

set_shell_function("_cv_validate_source_kind", [==[
local value="$1"
case "$value" in
    path|conda-name|conda-prefix|conda-env-file|portable|stub|legacy) ;;
    *) return 1 ;;
esac
printf '%s\n' "$value"
]==], "")

set_shell_function("_cv_validate_source_path", [==[
local value="$1"
[ -n "$value" ] || return 1
[[ "$value" =~ [[:cntrl:]] ]] && return 1
printf '%s\n' "$value"
]==], "")

set_shell_function("_cv_positive_integer", [==[
local value="$1"
[[ "$value" =~ ^[0-9]+$ ]] || return 1
[ "$value" -gt 0 ] || return 1
printf '%s\n' "$value"
]==], "")

set_shell_function("_cv_require_inactive", [==[
if [ "${CV_IS_WRITER:-1}" = "0" ]; then
    _cv_log "ERROR: environment creation is unavailable on a read-only cvenv node"
    return 1
fi
if [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; then
    _cv_log "ERROR: deactivate the active environment before creating another one"
    return 1
fi
]==], "")

set_shell_function("_cv_apply_job_cache", [==[
if [ -n "${CV_JOB_CACHE:-}" ]; then
    case "$CV_JOB_CACHE" in
        /*) ;;
        *)
            _cv_log "ERROR: CV_JOB_CACHE must be an absolute path"
            return 1
            ;;
    esac
    export PIP_CACHE_DIR="$CV_JOB_CACHE" UV_CACHE_DIR="$CV_JOB_CACHE"
fi
]==], "")

set_shell_function("_cv_escape_glob", [==[
local value="$1" escaped="" char
while [ -n "$value" ]; do
    char="${value:0:1}"
    case "$char" in
        '*'|'?'|'['|']') escaped+="\\$char" ;;
        *) escaped+="$char" ;;
    esac
    value="${value:1}"
done
printf '%s\n' "$escaped"
]==], "")

set_shell_function("_cv_check_archive_location", [==[
local requested="$1" archive_dir tmp_dir scratch_dir
case "$requested" in
    /*) ;;
    *)
        _cv_log "ERROR: CV_ARCHIVE_DIR must be an absolute path"
        return 1
        ;;
esac
archive_dir=$(builtin cd "$requested" 2>/dev/null && pwd -P) || return 1
tmp_dir=$(builtin cd /tmp 2>/dev/null && pwd -P) || tmp_dir="/tmp"
if [ -n "${CV_JOB_SCRATCH:-}" ]; then
    case "$CV_JOB_SCRATCH" in
        /*) ;;
        *)
            _cv_log "ERROR: CV_JOB_SCRATCH must be an absolute path"
            return 1
            ;;
    esac
    scratch_dir=$(readlink -f -- "$CV_JOB_SCRATCH" 2>/dev/null) || scratch_dir="$CV_JOB_SCRATCH"
fi
if [ "$archive_dir" = "$tmp_dir" ] || [[ "$archive_dir" == "${tmp_dir}"/* ]] || \
   { [ -n "${scratch_dir:-}" ] && \
     { [ "$archive_dir" = "$scratch_dir" ] || [[ "$archive_dir" == "${scratch_dir}"/* ]]; }; }; then
    _cv_log "ERROR: archive directory must be outside /tmp and CV_JOB_SCRATCH: $archive_dir"
    return 1
fi
printf '%s\n' "$archive_dir"
]==], "")

set_shell_function("_cv_archive_dir", [==[
_cv_check_archive_location "${CV_ARCHIVE_DIR:-$PWD}"
]==], "")

set_shell_function("_cv_archive_conflict", [==[
local archive_dir="$1" archive_name="$2"
if [ -f "${archive_dir}/${archive_name}.tar.zst" ] && \
   [ -f "${archive_dir}/${archive_name}.tar.gz" ]; then
    _cv_log "ERROR: conflicting zstd and gzip archives exist: $archive_name"
    return 1
fi
]==], "")

set_shell_function("_cv_find_archive", [==[
local archive_dir="$1" venv_name="$2"
local candidate pattern
pattern=$(_cv_escape_glob "${archive_dir}/${venv_name}") || return 1
if [ -f "${archive_dir}/${venv_name}.tar.zst" ]; then
    printf '%s\n' "${archive_dir}/${venv_name}.tar.zst"
    return 0
elif [ -f "${archive_dir}/${venv_name}.tar.gz" ]; then
    printf '%s\n' "${archive_dir}/${venv_name}.tar.gz"
    return 0
fi
for candidate in "${pattern}-"*.tar.zst "${pattern}-"*.tar.gz; do
    [ -f "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
done
return 1
]==], "")
set_shell_function("_cv_validate_archive_members", [==[
local tarball="$1" decompressor python validator rc=0 had_pipefail=0
python="${CV_ORIGINAL_PYTHON3:-${CV_ORIGINAL_PYTHON:-python3}}"
command -v "$python" >/dev/null 2>&1 || {
    _cv_log "ERROR: archive validation interpreter is unavailable: $python"
    return 1
}
case "$tarball" in
    *.tar.zst)
        [ -n "${CV_PZSTD:-}" ] || { _cv_log "ERROR: pzstd is required to read $tarball"; return 127; }
        decompressor=("$CV_PZSTD" --quiet -p "${CV_COMPRESS_CPUS:-1}" -dc -- "$tarball")
        ;;
    *.tar.gz)
        decompressor=(gzip -dc -- "$tarball")
        ;;
    *)
        _cv_log "ERROR: unsupported archive format: $tarball"
        return 2
        ;;
esac
validator=$(mktemp) || {
    _cv_log "ERROR: cannot create a temporary archive validator"
    return 1
}
if ! cat > "$validator" <<'PY'
import pathlib
import sys
import tarfile


def fail(message):
    sys.stderr.write("cvenv: unsafe archive member: {}\n".format(message))
    raise SystemExit(1)


def clean(parts):
    result = []
    for part in parts:
        if part in ("", "."):
            continue
        if part == "..":
            return None
        result.append(part)
    return tuple(result)


def resolve(parts):
    result = []
    for part in parts:
        if part in ("", "."):
            continue
        if part == "..":
            if not result:
                return None
            result.pop()
        else:
            result.append(part)
    return tuple(result)


def has_control_chars(value):
    return any(ord(char) < 32 or ord(char) == 127 for char in value)


root = None
seen = set()
symlinks = set()
hardlink_targets = set()
try:
    with tarfile.open(fileobj=sys.stdin.buffer, mode="r|") as archive:
        for member in archive:
            if has_control_chars(member.name):
                fail(member.name)
            path = pathlib.PurePosixPath(member.name)
            if path.is_absolute():
                fail(member.name)
            parts = clean(path.parts)
            if not parts:
                fail(member.name)
            if root is None:
                root = parts[0]
                if len(parts) == 1 and not member.isdir():
                    fail(member.name)
            elif parts[0] != root:
                fail(member.name)
            normalized = "/".join(parts)
            if normalized in seen:
                fail(member.name)
            seen.add(normalized)
            if not (member.isdir() or member.isfile() or member.issym() or member.islnk()):
                fail(member.name)
            if member.issym():
                if has_control_chars(member.linkname):
                    fail(member.linkname)
                target = pathlib.PurePosixPath(member.linkname)
                if not target.is_absolute():
                    resolved = resolve(parts[:-1] + target.parts)
                    if not resolved or resolved[0] != root:
                        fail(member.linkname)
                symlinks.add(normalized)
            elif member.islnk():
                if has_control_chars(member.linkname):
                    fail(member.linkname)
                target = pathlib.PurePosixPath(member.linkname)
                target_parts = clean(target.parts)
                if target.is_absolute() or target_parts is None:
                    fail(member.linkname)
                hardlink_targets.add("/".join(target_parts))
except Exception as error:
    fail(str(error))

for path in seen:
    for symlink in symlinks:
        if path.startswith(symlink + "/"):
            fail(path)
for target in hardlink_targets:
    if target not in seen:
        fail(target)
PY
then
    command rm -f -- "$validator"
    _cv_log "ERROR: cannot write the temporary archive validator"
    return 1
fi
[[ ":${SHELLOPTS}:" == *:pipefail:* ]] && had_pipefail=1
set -o pipefail
"${decompressor[@]}" | "$python" "$validator"
rc=$?
command rm -f -- "$validator"
[ "$had_pipefail" = "1" ] || set +o pipefail
return "$rc"
]==], "")

set_shell_function("_cv_extract_archive_strip", [==[
local tarball="$1" destination="$2" rc=0 had_pipefail=0
_cv_validate_archive_members "$tarball" || return $?
[[ ":${SHELLOPTS}:" == *:pipefail:* ]] && had_pipefail=1
case "$tarball" in
    *.tar.zst)
        [ -n "${CV_PZSTD:-}" ] || { _cv_log "ERROR: pzstd is required to read $tarball"; return 127; }
        set -o pipefail
        "$CV_PZSTD" -v -p "${CV_COMPRESS_CPUS:-1}" -dc -- "$tarball" | tar -xf - -C "$destination" --strip-components=1 || rc=$?
        ;;
    *.tar.gz)
        set -o pipefail
        gzip -dc -- "$tarball" | tar -xf - -C "$destination" --strip-components=1 || rc=$?
        ;;
    *)
        _cv_log "ERROR: unsupported archive format: $tarball"
        rc=2
        ;;
esac
[ "$had_pipefail" = "1" ] || set +o pipefail
return "$rc"
]==], "")
set_shell_function("_cv_scratch_cleanup", [==[
# Remove the job-scratch root when empty (last venv deactivated).
[ -n "${CV_JOB_SCRATCH:-}" ] || return 0
[ -d "$CV_JOB_SCRATCH" ] || return 0
rmdir "$CV_JOB_SCRATCH" 2>/dev/null || true
]==], "")

set_shell_function("_cv_base_name", [==[
local requested="$1"
basename -- "${requested%/}"
]==], "")

set_shell_function("_cv_hash", [==[
local value="$1" digest
if command -v sha256sum >/dev/null 2>&1; then
    digest=$(printf '%s' "$value" | sha256sum 2>/dev/null) || return $?
elif command -v shasum >/dev/null 2>&1; then
    digest=$(printf '%s' "$value" | shasum -a 256 2>/dev/null) || return $?
else
    return 127
fi
digest="${digest%% *}"
[[ "$digest" =~ ^[[:xdigit:]]{64}$ ]] || return 1
printf '%s\n' "$digest"
]==], "")

set_shell_function("_cv_canonical_path", [==[
local requested="${1%/}"
local base parent
case "$requested" in
    *[$'\n\r']*) return 1 ;;
esac
base=$(basename -- "$requested") || return 1
parent=$(dirname -- "$requested") || return 1
parent=$(builtin cd "$parent" 2>/dev/null && pwd -P) || return 1
printf '%s/%s\n' "$parent" "$base"
]==], "")

set_shell_function("_cv_identity", [==[
local source_kind="$1" source_path="$2"
_cv_hash "$(printf '%s\036%s' "$source_kind" "$source_path")"
]==], "")

set_shell_function("_cv_portable_identity", [==[
local random
[ -r /dev/urandom ] || return 127
random=$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | od -An -tx1 | tr -d '[:space:]')
[ "${#random}" -eq 64 ] || return 1
printf '%s\n' "$random"
]==], "")

set_shell_function("_cv_archive_name", [==[
local identity="$1" display_name="$2"
local hash
hash=$(_cv_hash "$identity") || return 1
printf '%s-%s\n' "$display_name" "${hash:0:16}"
]==], "")

set_shell_function("_cv_scratch_key", [==[
local identity="$1" archive_dir="$2" archive_name="$3" display_name="$4"
local hash
hash=$(_cv_hash "$(printf '%s\036%s\036%s' "$identity" "$archive_dir" "$archive_name")") || return 1
printf '%s-%s\n' "$display_name" "${hash:0:16}"
]==], "")

set_shell_function("_cv_exact_archive", [==[
local archive_dir="$1" archive_name="$2"
local candidate
for candidate in "${archive_dir}/${archive_name}.tar.zst" "${archive_dir}/${archive_name}.tar.gz"; do
    if [ -f "$candidate" ]; then
        printf '%s\n' "$candidate"
        return 0
    fi
done
return 1
]==], "")

set_shell_function("_cv_archive_base_name", [==[
local archive="$1"
archive=$(basename "$archive") || return 1
archive="${archive%.tar.zst}"
archive="${archive%.tar.gz}"
printf '%s\n' "$archive"
]==], "")

set_shell_function("_cv_archive_selector", [==[
local selector="$1"
selector=$(basename "$selector") || return 1
selector="${selector%.tar.zst}"
selector="${selector%.tar.gz}"
selector=$(_cv_validate_component "$selector") || return 2
printf '%s\n' "$selector"
]==], "")

set_shell_function("_cv_find_portable_archive", [==[
local archive_dir="$1" display_name="$2"
local candidate manifest manifest_rc selected count=0 pattern
pattern=$(_cv_escape_glob "${archive_dir}/${display_name}") || return 1
for candidate in "${pattern}-"*.tar.zst "${pattern}-"*.tar.gz; do
    [ -f "$candidate" ] || continue
    manifest_rc=0
    manifest=$(_cv_read_archive_manifest "$candidate") || manifest_rc=$?
    if [ "$manifest_rc" -eq 1 ]; then
        continue
    fi
    if [ "$manifest_rc" -ne 0 ]; then
        _cv_log "ERROR: archive manifest is invalid or unreadable: $candidate"
        return 1
    fi
    [ "$(_cv_manifest_field "$manifest" source_kind)" = "portable" ] || continue
    count=$((count + 1))
    if [ "$count" -eq 1 ]; then
        selected="$candidate"
    fi
done
if [ "$count" -eq 0 ]; then
    return 1
fi
if [ "$count" -gt 1 ]; then
    _cv_log "ERROR: multiple portable archives match: $display_name"
    _cv_log "       set CVENV_ARCHIVE_NAME to the exact archive basename"
    return 2
fi
printf '%s\n' "$selected"
]==], "")

set_shell_function("_cv_archive_member", [==[
local tarball="$1"
local members member count rc had_pipefail=0
[[ ":${SHELLOPTS}:" == *:pipefail:* ]] && had_pipefail=1
rc=0
case "$tarball" in
    *.tar.zst)
        [ -n "${CV_PZSTD:-}" ] || return 127
        set -o pipefail
        members=$("$CV_PZSTD" --quiet -p "${CV_COMPRESS_CPUS:-1}" -dc -- "$tarball" | tar -tf - 2>/dev/null) || rc=$?
        ;;
    *.tar.gz)
        set -o pipefail
        members=$(gzip -dc -- "$tarball" | tar -tf - 2>/dev/null) || rc=$?
        ;;
    *)
        rc=2
        ;;
esac
[ "$had_pipefail" = "1" ] || set +o pipefail
[ "$rc" -eq 0 ] || return "$rc"
count=$(printf '%s\n' "$members" | grep -Ec '^[^/]+/\.cvenv-manifest$') || count=0
[ "$count" -eq 1 ] || return 1
member=$(printf '%s\n' "$members" | grep -m1 -E '^[^/]+/\.cvenv-manifest$')
printf '%s\n' "$member"
]==], "")

set_shell_function("_cv_read_archive_manifest", [==[
local tarball="$1"
local member manifest rc had_pipefail=0
rc=0
member=$(_cv_archive_member "$tarball") || rc=$?
[ "$rc" -eq 0 ] || return "$rc"
[[ ":${SHELLOPTS}:" == *:pipefail:* ]] && had_pipefail=1
case "$tarball" in
    *.tar.zst)
        [ -n "${CV_PZSTD:-}" ] || return 127
        set -o pipefail
        manifest=$("$CV_PZSTD" --quiet -p "${CV_COMPRESS_CPUS:-1}" -dc -- "$tarball" | tar -xOf - "$member" 2>/dev/null) || rc=$?
        ;;
    *.tar.gz)
        set -o pipefail
        manifest=$(gzip -dc -- "$tarball" | tar -xOf - "$member" 2>/dev/null) || rc=$?
        ;;
    *)
        return 2
        ;;
esac
[ "$had_pipefail" = "1" ] || set +o pipefail
[ "$rc" -eq 0 ] || return 2
_cv_validate_manifest "$manifest"
]==], "")

set_shell_function("_cv_validate_manifest", [==[
local manifest="$1"
local field format source_kind identity source_path display_name archive_name scratch_key
[ -n "$manifest" ] || return 2
for field in format identity source_kind display_name archive_name scratch_key; do
    _cv_manifest_field "$manifest" "$field" >/dev/null || return 2
done
format=$(_cv_manifest_field "$manifest" format)
source_kind=$(_cv_manifest_field "$manifest" source_kind)
identity=$(_cv_manifest_field "$manifest" identity)
source_path=$(_cv_manifest_field "$manifest" source_path) || source_path=""
display_name=$(_cv_manifest_field "$manifest" display_name)
archive_name=$(_cv_manifest_field "$manifest" archive_name)
scratch_key=$(_cv_manifest_field "$manifest" scratch_key)
case "$format" in
    2)
        [ "$source_kind" != "portable" ] || return 2
        [ -n "$source_path" ] || return 2
        ;;
    3)
        [ "$source_kind" = "portable" ] || return 2
        [ -z "$source_path" ] || return 2
        ;;
    *) return 2 ;;
esac
source_kind=$(_cv_validate_source_kind "$source_kind") || return 2
identity=$(_cv_validate_identity "$identity") || return 2
[ -z "$source_path" ] || source_path=$(_cv_validate_source_path "$source_path") || return 2
display_name=$(_cv_validate_component "$display_name") || return 2
archive_name=$(_cv_validate_component "$archive_name") || return 2
scratch_key=$(_cv_validate_component "$scratch_key") || return 2
printf '%s\n' "$manifest"
]==], "")

set_shell_function("_cv_manifest_field", [==[
local manifest="$1" field="$2"
local key value
while IFS='=' read -r key value; do
    if [ "$key" = "$field" ]; then
        printf '%s\n' "$value"
        return 0
    fi
done <<< "$manifest"
return 1
]==], "")

set_shell_function("_cv_find_identity_archive", [==[
local archive_dir="$1" venv_name="$2" identity="$3"
local pattern candidate manifest manifest_rc archived_identity
local -a candidates=()
pattern=$(_cv_escape_glob "${archive_dir}/${venv_name}") || return 1
for candidate in "${archive_dir}/${venv_name}.tar.zst" \
                 "${archive_dir}/${venv_name}.tar.gz" \
                 "${pattern}-"*.tar.zst \
                 "${pattern}-"*.tar.gz; do
    [ -f "$candidate" ] && candidates+=("$candidate")
done
if [ "${#candidates[@]}" -gt 0 ]; then
    for candidate in "${candidates[@]}"; do
        manifest_rc=0
        manifest=$(_cv_read_archive_manifest "$candidate") || manifest_rc=$?
        [ "$manifest_rc" -eq 0 ] || continue
        archived_identity=$(_cv_manifest_field "$manifest" identity) || archived_identity=""
        if [ "$archived_identity" = "$identity" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    for candidate in "${candidates[@]}"; do
        manifest_rc=0
        manifest=$(_cv_read_archive_manifest "$candidate") || manifest_rc=$?
        [ "$manifest_rc" -eq 0 ] || [ "$manifest_rc" -eq 1 ] || continue
        [ "$manifest_rc" -eq 0 ] || manifest=""
        archived_identity=$(_cv_manifest_field "$manifest" identity) || archived_identity=""
        if [ -z "$archived_identity" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
fi
return 1
]==], "")

set_shell_function("_cv_write_manifest", [==[
local venv_dir="$1" identity="$2" source_kind="$3" source_path="$4"
local display_name="$5" archive_name="$6" scratch_key="$7"
local manifest_format
identity=$(_cv_validate_identity "$identity") || return 1
source_kind=$(_cv_validate_source_kind "$source_kind") || return 1
[ -z "$source_path" ] || source_path=$(_cv_validate_source_path "$source_path") || return 1
display_name=$(_cv_validate_component "$display_name") || return 1
archive_name=$(_cv_validate_component "$archive_name") || return 1
scratch_key=$(_cv_validate_component "$scratch_key") || return 1
if [ "$source_kind" = "portable" ]; then
    [ -z "$source_path" ] || return 1
    manifest_format=3
else
    [ -n "$source_path" ] || return 1
    manifest_format=2
fi
{
    printf 'format=%s\n' "$manifest_format"
    printf 'identity=%s\n' "$identity"
    printf 'source_kind=%s\n' "$source_kind"
    [ -z "$source_path" ] || printf 'source_path=%s\n' "$source_path"
    printf 'display_name=%s\n' "$display_name"
    printf 'archive_name=%s\n' "$archive_name"
    printf 'scratch_key=%s\n' "$scratch_key"
} > "$venv_dir/.cvenv-manifest"
]==], "")

set_shell_function("_cv_read_scratch_identity", [==[
local target="$1"
local manifest
manifest=$(_cv_read_scratch_manifest "$target") || return 1
_cv_manifest_field "$manifest" identity
]==], "")

set_shell_function("_cv_read_scratch_manifest", [==[
local target="$1"
local manifest
[ -f "$target/.cvenv-manifest" ] || return 1
manifest=$(cat "$target/.cvenv-manifest" 2>/dev/null) || return 1
_cv_validate_manifest "$manifest" >/dev/null || return 1
printf '%s\n' "$manifest"
]==], "")

set_shell_function("_cv_reserve_scratch", [==[
local target="$1" identity="$2"
mkdir -p "$(dirname "$target")" || return 1
if mkdir "$target" 2>/dev/null; then
    return 0
fi
if [ -d "$target" ]; then
    local existing
    existing=$(_cv_read_scratch_identity "$target") || existing=""
    if [ -n "$existing" ] && [ "$existing" = "$identity" ]; then
        return 0
    fi
    _cv_log "ERROR: scratch path is already used by another environment: $target"
    return 1
fi
_cv_log "ERROR: cannot reserve scratch path: $target"
return 1
]==], "")

set_shell_function("_cv_claim_scratch", [==[
local target="$1" identity="$2"
mkdir -p "$(dirname "$target")" || return 1
if mkdir "$target" 2>/dev/null; then
    return 0
fi
if [ -d "$target" ]; then
    local existing
    existing=$(_cv_read_scratch_identity "$target") || existing=""
    if [ -n "$existing" ] && [ "$existing" = "$identity" ]; then
        _cv_log "ERROR: environment is already expanded in job scratch: $target"
    else
        _cv_log "ERROR: scratch path is already used by another environment: $target"
    fi
    return 1
fi
_cv_log "ERROR: cannot reserve scratch path: $target"
return 1
]==], "")

set_shell_function("_cv_check_new_archive", [==[
local archive_dir="$1" archive_name="$2" display_name="$3" identity="$4"
local tarball manifest manifest_rc archived_identity
_cv_archive_conflict "$archive_dir" "$archive_name" || return 1
if tarball=$(_cv_exact_archive "$archive_dir" "$archive_name"); then
    manifest_rc=0
    manifest=$(_cv_read_archive_manifest "$tarball") || manifest_rc=$?
    if [ "$manifest_rc" -ne 0 ]; then
        if [ "$manifest_rc" -eq 1 ]; then
            _cv_log "ERROR: legacy archive already exists: $tarball"
            _cv_log "       activate it before creating a new environment with this identity"
        else
            _cv_log "ERROR: archive manifest is invalid or unreadable: $tarball"
        fi
        return 1
    fi
    archived_identity=$(_cv_manifest_field "$manifest" identity) || archived_identity=""
    if [ "$archived_identity" = "$identity" ]; then
        _cv_log "ERROR: cvenv environment already exists: $display_name"
        _cv_log "       activate it instead of creating it again"
    else
        _cv_log "ERROR: archive-name collision for $display_name: $tarball"
    fi
    return 1
fi
if tarball=$(_cv_find_archive "$archive_dir" "$display_name"); then
    manifest_rc=0
    manifest=$(_cv_read_archive_manifest "$tarball") || manifest_rc=$?
    if [ "$manifest_rc" -ne 0 ]; then
        if [ "$manifest_rc" -eq 1 ]; then
            _cv_log "ERROR: legacy archive already exists: $tarball"
            _cv_log "       activate it before creating a new environment with this name"
        else
            _cv_log "ERROR: archive manifest is invalid or unreadable: $tarball"
        fi
        return 1
    fi
    archived_identity=$(_cv_manifest_field "$manifest" identity) || archived_identity=""
    if [ "$archived_identity" = "$identity" ]; then
        _cv_log "ERROR: cvenv environment already exists: $display_name"
        _cv_log "       activate it instead of creating it again"
        return 1
    fi
fi
return 0
]==], "")

set_shell_function("_cv_write_archive_name", [==[
local venv_dir="$1" archive_name="$2"
archive_name=$(_cv_validate_component "$archive_name") || return 1
printf '%s\n' "$archive_name" > "$venv_dir/.cvenv-archive-name"
]==], "")

set_shell_function("_cv_env_encode", [==[
local value="$1" encoded had_pipefail=0
[[ ":${SHELLOPTS}:" == *:pipefail:* ]] && had_pipefail=1
set -o pipefail
local rc=0
encoded=$(printf '%s' "$value" | base64 | tr -d '\r\n') || rc=$?
[ "$had_pipefail" = "1" ] || set +o pipefail
[ "$rc" -eq 0 ] || return 1
printf '%s\n' "$encoded"
]==], "")

set_shell_function("_cv_env_decode", [==[
local value="$1" decoded
[[ "$value" =~ ^[A-Za-z0-9+/]*={0,2}$ ]] || return 1
decoded=$(printf '%s' "$value" | base64 -d) || return 1
printf '%s' "$decoded"
]==], "")

set_shell_function("_cv_validate_legacy_env_value", [==[
local value="$1" index length char
[ "$value" = "''" ] && return 0
length=${#value}
for ((index = 0; index < length; index++)); do
    char="${value:index:1}"
    case "$char" in
        '\\')
            ((index + 1 < length)) || return 1
            index=$((index + 1))
            ;;
        [A-Za-z0-9_@%+=:,./-]) ;;
        *) return 1 ;;
    esac
done
]==], "")

set_shell_function("_cv_decode_legacy_env_value", [==[
local value="$1" decoded
_cv_validate_legacy_env_value "$value" || return 1
[ "$value" = "''" ] && { printf '%s' ""; return 0; }
decoded=$(eval "printf '%s' ${value}") || return 1
printf '%s' "$decoded"
]==], "")

set_shell_function("_cv_save_env_vars", [==[
# Snapshot environment variables into a file in the venv so they survive archive/extract cycles.
local venv_dir="$1"
local venv_subdir="${2:-}"
local env_file="${venv_dir}${venv_subdir}/.cvenv-envvars.sh"

mkdir -p "$(dirname "$env_file")" || return 1

# Minimal allow-list of broadly useful Python runtime variables.
local _cv_env_allow="\
PYTHONHASHSEED \
PYTHONUNBUFFERED \
"

{
    printf '# Auto-generated by cvenv.  Do not edit.\n'
    printf '# Environment variable snapshot saved on %s.\n' "$(date 2>/dev/null || echo unknown)"

    local _cv_var _cv_val _cv_encoded
    # Save allow-listed variables that are actually set.
    for _cv_var in $_cv_env_allow; do
        eval 'local _cv_is_set="${'"$_cv_var"'+x}"'
        if [ -n "$_cv_is_set" ]; then
            eval "local _cv_val=\"\${${_cv_var}}\""
            _cv_encoded=$(_cv_env_encode "$_cv_val") || return 1
            printf "%s=%s\n" "$_cv_var" "$_cv_encoded"
        fi
    done

    # Save any cv_user_* variables.
    local _cv_uvar
    for _cv_uvar in $(compgen -v 2>/dev/null | grep '^CV_USER_' || true); do
        eval 'local _cv_is_set="${'"$_cv_uvar"'+x}"'
        if [ -n "$_cv_is_set" ]; then
            eval "local _cv_val=\"\${${_cv_uvar}}\""
            _cv_encoded=$(_cv_env_encode "$_cv_val") || return 1
            printf "%s=%s\n" "$_cv_uvar" "$_cv_encoded"
        fi
    done
} > "$env_file" 2>/dev/null || {
    _cv_log "ERROR: could not write env-var snapshot: $env_file"
    return 1
}
]==], "")

set_shell_function("_cv_restore_env_vars", [==[
# Source the env-var snapshot file (if present) to restore variables saved at last compression.
local venv_dir="$1"
local venv_subdir="${2:-}"
local env_file="${venv_dir}${venv_subdir}/.cvenv-envvars.sh"

[ -f "$env_file" ] || return 0

# Apply exports only for variables not already set, so the current environment wins.
local _cv_line _cv_name _cv_rest _cv_value _cv_decoded
local -a _cv_names=() _cv_values=()
while IFS= read -r _cv_line || [ -n "$_cv_line" ]; do
    case "$_cv_line" in
        ''|\#*) continue ;;
        export\ *)
            _cv_rest="${_cv_line#export }"
            _cv_name="${_cv_rest%%=*}"
            _cv_value="${_cv_rest#*=}"
            ;;
        *)
            _cv_name="${_cv_line%%=*}"
            _cv_value="${_cv_line#*=}"
            ;;
    esac
    case "$_cv_name" in
        PYTHONHASHSEED|PYTHONUNBUFFERED|CV_USER_*) ;;
        *)
            _cv_log "ERROR: refused to restore disallowed environment variable: $_cv_name"
            return 1
            ;;
    esac
    [[ "$_cv_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || {
        _cv_log "ERROR: invalid environment variable name: $_cv_name"
        return 1
    }
    case "$_cv_line" in
        export\ *)
            if ! _cv_decoded=$(_cv_decode_legacy_env_value "$_cv_value"); then
                _cv_log "ERROR: invalid environment variable snapshot"
                return 1
            fi
            ;;
        *)
            if ! _cv_decoded=$(_cv_env_decode "$_cv_value"); then
                _cv_log "ERROR: invalid environment variable snapshot"
                return 1
            fi
            ;;
    esac
    _cv_names+=("$_cv_name")
    _cv_values+=("$_cv_decoded")
done < "$env_file"

local _cv_index _cv_is_set
for _cv_index in "${!_cv_names[@]}"; do
    _cv_name="${_cv_names[$_cv_index]}"
    eval 'local _cv_is_set="${'"$_cv_name"'+x}"'
    if [ -z "$_cv_is_set" ]; then
        _cv_decoded="${_cv_values[$_cv_index]}"
        if ! printf -v "$_cv_name" '%s' "$_cv_decoded"; then
            _cv_log "ERROR: could not restore environment variable: $_cv_name"
            return 1
        fi
        if ! export "$_cv_name"; then
            _cv_log "ERROR: could not export environment variable: $_cv_name"
            return 1
        fi
    fi
done
]==], "")

set_shell_function("_cv_write_dummy_activate", [==[
# After deactivation, leave stub activate so "source myvenv/bin/activate" works like a normal venv.
local venv_name="$1"
local archive_dir="$2"
local link_path="$3"
local venv_subdir="${4:-}"
local identity="${5:-}"
local scratch_key="${6:-}"
local source_kind="${7:-legacy}"
local source_path="${8:-}"
local activate_path="${link_path}${venv_subdir}/bin/activate"

venv_name=$(_cv_validate_component "$venv_name") || return 1
scratch_key=$(_cv_validate_component "$scratch_key") || return 1
source_kind=$(_cv_validate_source_kind "$source_kind") || return 1
[ -z "$source_path" ] || source_path=$(_cv_validate_source_path "$source_path") || return 1
[ -z "$identity" ] || identity=$(_cv_validate_identity "$identity") || return 1

# Only the writer node creates the stub.
[ "${CV_IS_WRITER:-1}" = "1" ] || return 0

# Don't create a stub if there's no archive to restore from.
_cv_find_archive "$archive_dir" "$venv_name" >/dev/null 2>&1 || return 0

mkdir -p "$(dirname "$activate_path")" || return 1

{
    printf '# CVENV_STUB\n'
    printf '# CVENV_ARCHIVE_NAME=%s\n' "$venv_name"
    [ -z "$identity" ] || printf '# CVENV_IDENTITY=%s\n' "$identity"
    [ -z "$scratch_key" ] || printf '# CVENV_SCRATCH_KEY=%s\n' "$scratch_key"
    [ -z "$source_kind" ] || printf '# CVENV_SOURCE_KIND=%s\n' "$source_kind"
    [ -z "$source_path" ] || printf '# CVENV_SOURCE_PATH=%s\n' "$source_path"
    cat <<'STUB'
# This placeholder was generated after cvenv archived the real environment.
# To restore and activate it, load cvenv first, then source this file again.
# Example:
#   module load cvenv
#   source <venv>/bin/activate
STUB
} > "$activate_path" || return 1
chmod +x "$activate_path" 2>/dev/null || true
return 0
]==], "")

set_shell_function("_cv_augment_ld_path", [==[
# Save LD_LIBRARY_PATH and append CRAY_LD_LIBRARY_PATH (and optionally $CONDA_PREFIX/lib for conda).
local _extra="${1:-}"
if [ -z "${_CV_LD_LIBRARY_PATH_BACKUP+x}" ]; then
    _CV_LD_LIBRARY_PATH_BACKUP="${LD_LIBRARY_PATH:-}"
fi
if [ -z "${_CV_PKG_CONFIG_PATH_BACKUP+x}" ]; then
    _CV_PKG_CONFIG_PATH_BACKUP="${PKG_CONFIG_PATH:-}"
fi
if [ -n "${CRAY_LD_LIBRARY_PATH:-}" ]; then
    case ":${LD_LIBRARY_PATH:-}:" in
        *":$CRAY_LD_LIBRARY_PATH:"*) ;;
        *)
            if [ -n "${LD_LIBRARY_PATH:-}" ]; then
                LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$CRAY_LD_LIBRARY_PATH"
            else
                LD_LIBRARY_PATH="$CRAY_LD_LIBRARY_PATH"
            fi
            ;;
    esac
fi
if [ -n "$_extra" ]; then
    case ":${LD_LIBRARY_PATH:-}:" in
        *":$_extra:"*) ;;
        *)
            if [ -n "${LD_LIBRARY_PATH:-}" ]; then
                LD_LIBRARY_PATH="$_extra:$LD_LIBRARY_PATH"
            else
                LD_LIBRARY_PATH="$_extra"
            fi
            ;;
    esac
fi
[ -n "${LD_LIBRARY_PATH:-}" ] && export LD_LIBRARY_PATH

# Also add the corresponding pkgconfig directory to PKG_CONFIG_PATH so pkg-config finds .pc files.
local _pkg_cfg=""
if [ -n "$_extra" ] && [ -d "${_extra}/pkgconfig" ]; then
    _pkg_cfg="${_extra}/pkgconfig"
elif [ -n "${VIRTUAL_ENV:-}" ]; then
    local _pc_dir
    for _pc_dir in "${VIRTUAL_ENV}/lib/pkgconfig"; do
        if [ -d "$_pc_dir" ]; then
            _pkg_cfg="$_pc_dir"
            break
        fi
    done
fi
if [ -n "$_pkg_cfg" ]; then
    case ":${PKG_CONFIG_PATH:-}:" in
        *":$_pkg_cfg:"*) ;;
        *)
            if [ -n "${PKG_CONFIG_PATH:-}" ]; then
                PKG_CONFIG_PATH="$_pkg_cfg:$PKG_CONFIG_PATH"
            else
                PKG_CONFIG_PATH="$_pkg_cfg"
            fi
            export PKG_CONFIG_PATH
            ;;
    esac
fi
return 0
]==], "")

set_shell_function("_cv_restore_ld_path", [==[
# Restore LD_LIBRARY_PATH and PKG_CONFIG_PATH to their pre-activation state.
if [ -n "${_CV_LD_LIBRARY_PATH_BACKUP+x}" ]; then
    if [ -n "$_CV_LD_LIBRARY_PATH_BACKUP" ]; then
        LD_LIBRARY_PATH="$_CV_LD_LIBRARY_PATH_BACKUP"
        export LD_LIBRARY_PATH
    else
        unset LD_LIBRARY_PATH
    fi
    unset _CV_LD_LIBRARY_PATH_BACKUP
fi
if [ -n "${_CV_PKG_CONFIG_PATH_BACKUP+x}" ]; then
    if [ -n "$_CV_PKG_CONFIG_PATH_BACKUP" ]; then
        PKG_CONFIG_PATH="$_CV_PKG_CONFIG_PATH_BACKUP"
        export PKG_CONFIG_PATH
    else
        unset PKG_CONFIG_PATH
    fi
    unset _CV_PKG_CONFIG_PATH_BACKUP
fi
]==], "")

set_shell_function("_cv_patch_nccl", [==[
# Patch rpath/runpath of .so files needing NCCL via LD_LIBRARY_PATH.
local venv_dir="$1"
local venv_subdir="${2:-}"

# Only run if patchelf is available.
command -v patchelf >/dev/null 2>&1 || return 0

# Only run if LD_LIBRARY_PATH contains one of the supported libraries.
local nccl_lib_dir=""
local IFS=:
local dir
for dir in ${LD_LIBRARY_PATH:-}; do
    [ -z "$dir" ] && dir="."
    if [ -z "$nccl_lib_dir" ] && compgen -G "$dir/libnccl.so*" > /dev/null 2>&1; then
        nccl_lib_dir="$dir"
    fi
done
[ -n "$nccl_lib_dir" ] || return 0

local site_packages="${venv_dir}${venv_subdir}/lib/python"*/site-packages
[ -d "$site_packages" ] 2>/dev/null || {
    # Glob might not have expanded; try explicit search.
    site_packages=$(find "${venv_dir}${venv_subdir}/lib" -type d -name site-packages 2>/dev/null | head -1)
}
[ -n "$site_packages" ] || return 0

if [ "${CV_DEBUG:-0}" = "1" ]; then
    _cv_log "Patching NCCL rpath in $site_packages"
fi

local f
while IFS= read -r -d '' f; do
    # Only patch .so files that actually depend on a supported library.
    local needed
    needed=$(readelf -d "$f" 2>/dev/null || true)
    if ! grep -qE 'Shared library: \[libnccl\.so(\.[^]]+)?\]' <<<"$needed"; then
        continue
    fi

    local old_rpath
    old_rpath=$(
        readelf -d "$f" 2>/dev/null | \
        sed -n -e 's/.*RPATH.*: \[\(.*\)\]/\1/p' -e 's/.*RUNPATH.*: \[\(.*\)\]/\1/p'
    )
    case ":${old_rpath:-}:" in
        *":$nccl_lib_dir:"*) continue ;;
    esac

    local new_rpath
    if [ -n "$old_rpath" ]; then
        new_rpath="$nccl_lib_dir:$old_rpath"
    else
        new_rpath="$nccl_lib_dir"
    fi

    _cv_log "  Patching: $(basename "$f")  RPATH: $new_rpath"
    patchelf --set-rpath "$new_rpath" "$f" 2>/dev/null || \
        _cv_log "  WARNING: patchelf failed on $f"
done < <(find "$site_packages" -type f \( -name '*.so' -o -name '*.so.*' \) -print0 2>/dev/null)
]==], "")

set_shell_function("_cv_write_readme", [==[
# Write a README next to the archive showing which Lmod modules were loaded and how to reactivate.
local venv_name="$1"
local archive_dir="${2:-$(_cv_archive_dir)}"
local archive_name="${3:-$venv_name}"
local link_path="${4:-}"
local venv_dir="${5:-${_CV_ACTIVE_DIR:-}}"
local readme="${archive_dir}/${archive_name}.README.md"
local archive_file

venv_name=$(_cv_validate_component "$venv_name") || return 1
archive_name=$(_cv_validate_component "$archive_name") || return 1
archive_file=$(_cv_exact_archive "$archive_dir" "$archive_name") || archive_file="${archive_dir}/${archive_name}${CV_BACKEND_EXT}"

# Only the writer node should write the README.
[ "${CV_IS_WRITER:-1}" = "1" ] || return 0

mkdir -p "$archive_dir" 2>/dev/null || return 0

# Collect loaded Lmod modules from the environment.
local loaded_modules="${LOADEDMODULES:-}"
local has_modules=0
local module_lines=""
if [ -n "$loaded_modules" ]; then
    has_modules=1
    local IFS=':'
    local mod
    for mod in $loaded_modules; do
        [ -n "$mod" ] || continue
        case "$mod" in cvenv|cvenv/*) continue ;; esac
        module_lines="${module_lines}module load $(printf '%q' "$mod")\n"
    done
    unset IFS
fi

# Determine backend type and venv subdirectory from the target environment.
local backend_type="python venv"
local venv_subdir=""
local venv_base="$venv_dir"

# Conda environments are identified by the conda-meta/ directory, which every conda env contains.
local _cv_is_conda=0
if [ -d "${venv_base}/conda-meta" ]; then
    _cv_is_conda=1
elif [ -n "${CONDA_PREFIX:-}" ] && [ "${CONDA_PREFIX:-}" = "${venv_base}" ]; then
    _cv_is_conda=1
fi

if [ "$_cv_is_conda" = "1" ]; then
    backend_type="conda environment"
    venv_subdir=""
elif [ -n "${CV_UV:-}" ]; then
    # uv init creates a project directory with a .venv subdirectory.
    if [ -f "${venv_base}/pyproject.toml" ] && [ -d "${venv_base}/.venv" ]; then
        backend_type="uv project"
        venv_subdir="/.venv"
    # uv venv creates a bare .venv (venv_name would be ".venv").
    elif [ "$venv_name" = ".venv" ] && [ -d "${venv_base}" ]; then
        backend_type="uv venv"
        venv_subdir=""
    fi
fi

if [ "${CV_DEBUG:-0}" = "1" ]; then
    _cv_log "README detection: backend=${backend_type} venv_base=${venv_base} conda_prefix=${CONDA_PREFIX:-} is_conda=${_cv_is_conda}"
fi

# Build a directory-relative activation command to avoid same-name ambiguity.
local activate_cmd=""
local activate_path="${link_path:-${archive_dir}/${venv_name}}"
local activation_dir activation_target
local cvenv_module="cvenv"
activation_dir=$(dirname "$activate_path")
if [ "$backend_type" = "conda environment" ]; then
    activation_target=$(basename "$activate_path")
    activate_cmd="conda activate $(printf '%q' "$activation_target")"
else
    if [ -n "$venv_subdir" ]; then
        activation_target="${venv_subdir#/}/bin/activate"
    else
        activation_target="$(basename "$activate_path")/bin/activate"
    fi
    activate_cmd="source $(printf '%q' "$activation_target")"
fi
case "${CV_MODULE_VERSION:-}" in
    ""|unknown) ;;
    *) cvenv_module="cvenv/$CV_MODULE_VERSION" ;;
esac

# Build the README content.
{
    printf '# %s\n\n' "$venv_name"
    printf 'This file was auto-generated by **cvenv**.\n'
    printf 'Those Lmod modules that were loaded when the %s was last saved,\n' "$backend_type"
    printf 'so you can reproduce the environment on reactivation.\n\n'

    printf '## Archive\n\n'
    printf -- '- Archive file: `%s`\n' "$(basename "$archive_file")"
    printf -- '- Archive directory: `%s`\n' "$archive_dir"
    printf -- '- Backend: %s\n' "$backend_type"
    printf -- '- cvenv module: %s\n' "${CV_MODULE_VERSION:-unknown}"
    printf -- '- Generated: %s\n' "$(date 2>/dev/null || echo unknown)"
    printf '\n'

    printf '## Loaded modules\n\n'
    if [ "$has_modules" = "1" ]; then
        printf 'The following Lmod modules were loaded when this %s was last saved:\n\n' "$backend_type"
        printf '```bash\n'
        printf '%b' "$module_lines"
        printf '```\n\n'
    else
        printf 'No Lmod modules were detected (LOADEDMODULES was unset).\n\n'
    fi

    printf '## Reactivation\n\n'
    printf 'To reactivate this %s in a new job:\n\n' "$backend_type"
    printf '```bash\n'
    if [ "$has_modules" = "1" ]; then
        printf '%b' "$module_lines"
    fi
    printf 'module load %s\n' "$(printf '%q' "$cvenv_module")"
    printf 'cd %s\n' "$(printf '%q' "$activation_dir")"
    printf '%s\n' "$activate_cmd"
    printf '```\n\n'

    printf '## Notes\n\n'
    printf -- '- Load the modules listed above **before** loading `cvenv` and activating the environment.\n'
    printf -- '- `module load cvenv` must precede activation so the cvenv wrapper functions are available.\n'
    printf -- '- Change to the environment directory before activation; this avoids ambiguity between same-named archives.\n'
    printf -- '- Module versions must match (or be compatible with) those used when the environment was created.\n'
    printf -- '- Plain `srun` commands should work on every node.\n'
    printf -- '- Run `deactivate` (or `conda deactivate` for conda environments) before leaving the job to save any changes back to the archive.\n'
} > "$readme" 2>/dev/null || {
    _cv_log "WARNING: could not write README: $readme"
    return 0
}

_cv_log "Wrote README: $readme"
]==], "")

set_shell_function("_cv_compress_venv", [==[
local venv_dir="$1"
local archive_dir="${2:-$(_cv_archive_dir)}"
local venv_subdir="${3-${_CV_ACTIVE_VENV_SUBDIR:-}}"
local initial="${4:-0}"
local readme_link="${5-${_CV_ACTIVE_LINK:-${_CV_EXPANDED_LINK:-}}}"
local venv_name scratch_name tarball tmp rc manifest identity display_name source_kind source_path
local existing_tarball archived_manifest archived_manifest_rc archived_identity
local had_pipefail=0
local prefix_rc=0

scratch_name=$(basename "$venv_dir") || return 1
scratch_name=$(_cv_validate_component "$scratch_name") || return 1
venv_name="$scratch_name"
if [ -f "$venv_dir/.cvenv-archive-name" ]; then
    venv_name=$(cat "$venv_dir/.cvenv-archive-name")
fi
venv_name=$(_cv_validate_component "$venv_name") || return 1
manifest=$(cat "$venv_dir/.cvenv-manifest" 2>/dev/null) || manifest=""
if [ -n "$manifest" ]; then
    _cv_validate_manifest "$manifest" >/dev/null || {
        _cv_log "ERROR: scratch manifest is invalid: $venv_dir"
        return 1
    }
fi
identity=$(_cv_manifest_field "$manifest" identity) || identity=""
display_name=$(_cv_manifest_field "$manifest" display_name) || display_name="$scratch_name"
source_kind=$(_cv_manifest_field "$manifest" source_kind) || source_kind="legacy"
source_path=$(_cv_manifest_field "$manifest" source_path) || source_path=""
_cv_archive_conflict "$archive_dir" "$venv_name" || return 1
tarball="${archive_dir}/${venv_name}${CV_BACKEND_EXT}"
CV_COMPRESS_CPUS=$(_cv_positive_integer "${CV_COMPRESS_CPUS:-1}") || {
    _cv_log "ERROR: CV_COMPRESS_CPUS must be a positive integer"
    return 1
}
export CV_COMPRESS_CPUS

if [ ! -d "$venv_dir" ]; then
    _cv_log "ERROR: environment directory does not exist: $venv_dir"
    return 1
fi

# In multi-node allocations only the head node (SLURM_NODEID 0) may write the shared archive.
if [ "${CV_IS_WRITER:-1}" = "0" ]; then
    _cv_log "Read-only node (SLURM_NODEID!=0); skipping compression of $venv_name"
    return 0
fi

mkdir -p "$archive_dir" || return 1
local lock="${archive_dir}/.cvenv-lock-${venv_name}"
if ! mkdir "$lock" 2>/dev/null; then
    _cv_log "ERROR: archive is locked by another cvenv process: $venv_name"
    return 1
fi
existing_tarball=$(_cv_exact_archive "$archive_dir" "$venv_name") || existing_tarball=""
if [ -n "$existing_tarball" ]; then
    tarball="$existing_tarball"
    archived_manifest_rc=0
    archived_manifest=$(_cv_read_archive_manifest "$tarball") || archived_manifest_rc=$?
    if [ "$archived_manifest_rc" -ne 0 ] && [ "$archived_manifest_rc" -ne 1 ]; then
        _cv_log "ERROR: archive manifest is invalid or unreadable: $tarball"
        command rm -rf "$lock"
        return 1
    fi
    [ "$archived_manifest_rc" -eq 0 ] || archived_manifest=""
    archived_identity=$(_cv_manifest_field "$archived_manifest" identity) || archived_identity=""
    if [ -n "$archived_identity" ] && [ -n "$identity" ] && [ "$archived_identity" != "$identity" ]; then
        _cv_log "ERROR: archive identity collision: $tarball"
        command rm -rf "$lock"
        return 1
    fi
    if [ "$initial" = "1" ]; then
        _cv_log "ERROR: environment was created concurrently; archive already exists: $tarball"
        command rm -rf "$lock"
        return 1
    fi
fi
tmp=$(mktemp "${lock}/payload.XXXXXX") || {
    command rm -rf "$lock"
    return 1
}
printf '%s\n' "$venv_dir" > "$venv_dir/.cvenv-prefix" || prefix_rc=$?
if [ "$prefix_rc" -ne 0 ]; then
    _cv_log "ERROR: could not update relocation marker"
    command rm -rf "$lock"
    return "$prefix_rc"
fi
_cv_write_manifest "$venv_dir" "$identity" "$source_kind" "$source_path" "$display_name" "$venv_name" "$scratch_name" || {
    command rm -rf "$lock"
    return 1
}
_cv_save_env_vars "$venv_dir" "$venv_subdir" || {
    _cv_log "ERROR: could not save environment variables"
    command rm -rf "$lock"
    return 1
}
_cv_log "Compressing $venv_name -> $tarball"

[[ ":${SHELLOPTS}:" == *:pipefail:* ]] && had_pipefail=1
set -o pipefail
rc=0
case "$tarball" in
 *.tar.zst)
    if [ -n "${CV_PZSTD:-}" ]; then
        tar -cf - -C "$(dirname "$venv_dir")" -- "$scratch_name" | "$CV_PZSTD" -v -p "$CV_COMPRESS_CPUS" -3 -c > "$tmp" || rc=$?
    else
        _cv_log "ERROR: pzstd is required to write $tarball"
        rc=127
    fi
    ;;
 *.tar.gz) tar -cf - -C "$(dirname "$venv_dir")" -- "$scratch_name" | gzip -c > "$tmp" || rc=$? ;;
 *) rc=2 ;;
esac
[ "$had_pipefail" = "1" ] || set +o pipefail

if [ "$rc" -ne 0 ]; then
    _cv_log "ERROR: compression failed"
    command rm -f -- "$tmp"
    command rm -rf "$lock"
    return "$rc"
fi

mv -f -- "$tmp" "$tarball" || {
    command rm -f -- "$tmp"
    command rm -rf "$lock"
    return 1
}
_cv_log "Compression complete"
_cv_write_readme "$display_name" "$archive_dir" "$venv_name" "$readme_link" "$venv_dir"
command rm -rf "$lock"
]==], "")

set_shell_function("_cv_relocate_venv", [==[
local target="$1"
local marker="$target/.cvenv-prefix"
local old_prefix file reloc_python

[ -f "$marker" ] || return 0
old_prefix=$(cat "$marker")
[ -n "$old_prefix" ] || return 0
[ "$old_prefix" != "/" ] || return 1
[ "$old_prefix" = "$target" ] && return 0
reloc_python="${CV_ORIGINAL_PYTHON3:-${CV_ORIGINAL_PYTHON:-python3}}"
command -v "$reloc_python" >/dev/null 2>&1 || {
    _cv_log "ERROR: relocation interpreter is not available: $reloc_python"
    return 1
}

_cv_log "Relocating environment prefix: $old_prefix -> $target"

while IFS= read -r file; do
    # Files copied from a read-only tree (venv --copies) may retain read-only permissions.
    chmod u+w "$file" 2>/dev/null || true
    OLD_PREFIX="$old_prefix" NEW_PREFIX="$target" "$reloc_python" - "$file" <<'PY'
import os
import pathlib
import sys

p = pathlib.Path(sys.argv[1])
data = p.read_bytes()
old = os.environ["OLD_PREFIX"].encode()
new = os.environ["NEW_PREFIX"].encode()
if old in data:
    p.write_bytes(data.replace(old, new))
PY
    if [ "$?" -ne 0 ]; then
        _cv_log "ERROR: failed to relocate file: $file"
        return 1
    fi
done < <(grep -IlrF -- "$old_prefix" "$target" 2>/dev/null || true)

printf '%s\n' "$target" > "$marker" || return 1
]==], "")

set_shell_function("_cv_decompress_venv", [==[
local venv_name="$1"
local archive_dir="${2:-$(_cv_archive_dir)}"
local scratch_key="${3:-$venv_name}"
local identity="$4"
local source_kind="${5:-legacy}"
local source_path="${6:-}"
local display_name="${7:-$scratch_key}"
local tarball target rc manifest manifest_rc archived_identity owned=0

venv_name=$(_cv_validate_component "$venv_name") || return 1
scratch_key=$(_cv_validate_component "$scratch_key") || return 1
identity=$(_cv_validate_identity "$identity") || return 1
source_kind=$(_cv_validate_source_kind "$source_kind") || return 1
display_name=$(_cv_validate_component "$display_name") || return 1
_cv_archive_conflict "$archive_dir" "$venv_name" || return 1
if [ "$source_kind" = "portable" ]; then
    [ -z "$source_path" ] || return 1
else
    source_path=$(_cv_validate_source_path "$source_path") || return 1
fi

target="${CV_JOB_SCRATCH}/${scratch_key}"
if [ -d "$target" ]; then
    local existing_identity venv_subdir
    existing_identity=$(_cv_read_scratch_identity "$target") || existing_identity=""
    if [ -n "$existing_identity" ] && [ "$existing_identity" = "$identity" ]; then
        venv_subdir=""
        if [ -d "$target/.venv" ] && [ -f "$target/.venv/bin/activate" ]; then
            venv_subdir="/.venv"
        fi
        if [ ! -f "${target}${venv_subdir}/bin/activate" ] && \
           [ ! -f "${target}${venv_subdir}/bin/conda" ] && \
           [ ! -x "${target}${venv_subdir}/bin/python" ]; then
            _cv_log "ERROR: expanded environment is incomplete: $target"
            return 1
        fi
        _cv_log "$display_name is already expanded at $target"
        _cv_relocate_venv "$target"
        return $?
    fi
fi

_cv_reserve_scratch "$target" "$identity" || return 1
[ -e "$target/.cvenv-manifest" ] || owned=1
if [ "$source_kind" = "portable" ]; then
    tarball=$(_cv_exact_archive "$archive_dir" "$venv_name") || tarball=""
else
    tarball=$(_cv_find_archive "$archive_dir" "$venv_name") || tarball=""
    if [ -z "$tarball" ] && [ "$venv_name" != "$display_name" ]; then
        tarball=$(_cv_find_identity_archive "$archive_dir" "$display_name" "$identity") || tarball=""
    fi
fi
if [ -z "$tarball" ]; then
    [ "$owned" = "1" ] && command rm -rf "$target"
    _cv_log "ERROR: archive not found: ${archive_dir}/${venv_name}${CV_BACKEND_EXT}"
    return 1
fi

manifest_rc=0
manifest=$(_cv_read_archive_manifest "$tarball") || manifest_rc=$?
if [ "$manifest_rc" -ne 0 ] && [ "$manifest_rc" -ne 1 ]; then
    [ "$owned" = "1" ] && command rm -rf "$target"
    _cv_log "ERROR: archive manifest is invalid or unreadable: $tarball"
    return 1
fi
[ "$manifest_rc" -eq 0 ] || manifest=""
archived_identity=$(_cv_manifest_field "$manifest" identity) || archived_identity=""
if [ -n "$archived_identity" ] && [ "$archived_identity" != "$identity" ]; then
    [ "$owned" = "1" ] && command rm -rf "$target"
    _cv_log "ERROR: archive belongs to a different environment: $tarball"
    return 1
fi
venv_name=$(basename "$tarball")
venv_name="${venv_name%.tar.zst}"
venv_name="${venv_name%.tar.gz}"
venv_name=$(_cv_validate_component "$venv_name") || {
    [ "$owned" = "1" ] && command rm -rf "$target"
    return 1
}

_cv_log "Decompressing $tarball -> $target"
_cv_extract_archive_strip "$tarball" "$target"
rc=$?
if [ "$rc" -ne 0 ]; then
    _cv_log "ERROR: decompression failed"
    [ "$owned" = "1" ] && command rm -rf "$target"
    return "$rc"
fi
if [ ! -d "$target" ]; then
    _cv_log "ERROR: archive did not contain an environment"
    [ "$owned" = "1" ] && command rm -rf "$target"
    return 1
fi

local venv_subdir=""
if [ -f "$target/.venv/bin/activate" ]; then
    venv_subdir="/.venv"
fi
_cv_relocate_venv "$target" || {
    [ "$owned" = "1" ] && command rm -rf "$target"
    return 1
}
_cv_write_archive_name "$target" "$venv_name" || {
    [ "$owned" = "1" ] && command rm -rf "$target"
    return 1
}
_cv_write_manifest "$target" "$identity" "$source_kind" "$source_path" "$display_name" "$venv_name" "$scratch_key" || {
    [ "$owned" = "1" ] && command rm -rf "$target"
    return 1
}
_cv_log "Decompression complete"
]==], "")

set_shell_function("_cv_export_venv", [==[
local requested output_requested
local archive_dir output_dir env_path display_name source_archive_name source_tarball
local source_manifest source_manifest_rc identity archive_name scratch_key
local temp_root payload venv_subdir link_target env_parent
local expected_identity source_identity

[ "$#" -eq 2 ] || {
    _cv_log "ERROR: usage: cvenv_export <environment-path> <output-directory>"
    return 2
}
requested="$1"
output_requested="$2"

[ "${CV_IS_WRITER:-1}" = "1" ] || {
    _cv_log "ERROR: cvenv_export is not available on a read-only cvenv node"
    return 1
}

archive_dir=$(_cv_archive_dir) || return 1
archive_dir=$(builtin cd "$archive_dir" 2>/dev/null && pwd -P) || {
    _cv_log "ERROR: archive directory does not exist: $archive_dir"
    return 1
}
mkdir -p "$output_requested" || {
    _cv_log "ERROR: cannot create output directory: $output_requested"
    return 1
}
output_dir=$(builtin cd "$output_requested" 2>/dev/null && pwd -P) || {
    _cv_log "ERROR: cannot resolve output directory: $output_requested"
    return 1
}
output_dir=$(_cv_check_archive_location "$output_dir") || {
    _cv_log "ERROR: output directory must be outside /tmp and CV_JOB_SCRATCH"
    return 1
}
env_path=$(_cv_canonical_path "$requested") || {
    _cv_log "ERROR: cannot resolve environment path: $requested"
    return 1
}
display_name=$(basename "${env_path%/}")
display_name=$(_cv_validate_component "$display_name") || return 1
source_archive_name=""
expected_identity=""

if link_target=$(readlink -f "$env_path" 2>/dev/null) && [ -d "$link_target" ]; then
    if [ -n "${_CV_ACTIVE_DIR:-}" ] && [ "$link_target" = "$_CV_ACTIVE_DIR" ]; then
        _cv_log "ERROR: deactivate the environment before exporting it"
        return 1
    fi
    if [ -f "$link_target/.cvenv-archive-name" ]; then
        source_archive_name=$(cat "$link_target/.cvenv-archive-name")
    fi
    local link_manifest
    link_manifest=$(cat "$link_target/.cvenv-manifest" 2>/dev/null) || link_manifest=""
    if _cv_validate_manifest "$link_manifest" >/dev/null 2>&1; then
        expected_identity=$(_cv_manifest_field "$link_manifest" identity)
    fi
fi
if [ -z "$source_archive_name" ] && [ -f "$env_path/.cvenv-archive-name" ]; then
    source_archive_name=$(cat "$env_path/.cvenv-archive-name")
fi
if [ -z "$expected_identity" ] && [ -f "$env_path/.cvenv-manifest" ]; then
    local env_manifest
    env_manifest=$(cat "$env_path/.cvenv-manifest" 2>/dev/null) || env_manifest=""
    if _cv_validate_manifest "$env_manifest" >/dev/null 2>&1; then
        expected_identity=$(_cv_manifest_field "$env_manifest" identity)
    fi
fi
if [ -z "$source_archive_name" ] && [ -f "$env_path/bin/activate" ]; then
    source_archive_name=$(sed -n 's/^# CVENV_ARCHIVE_NAME=//p' "$env_path/bin/activate" | head -1)
fi
if [ -z "$source_archive_name" ] && [ -f "$env_path/.venv/bin/activate" ]; then
    source_archive_name=$(sed -n 's/^# CVENV_ARCHIVE_NAME=//p' "$env_path/.venv/bin/activate" | head -1)
fi
if [ -z "$expected_identity" ]; then
    local stub_identity=""
    if [ -f "$env_path/bin/activate" ]; then
        stub_identity=$(sed -n 's/^# CVENV_IDENTITY=//p' "$env_path/bin/activate" | head -1)
    elif [ -f "$env_path/.venv/bin/activate" ]; then
        stub_identity=$(sed -n 's/^# CVENV_IDENTITY=//p' "$env_path/.venv/bin/activate" | head -1)
    fi
    if [ -n "$stub_identity" ]; then
        expected_identity=$(_cv_validate_identity "$stub_identity") || {
            _cv_log "ERROR: invalid source identity in activation stub"
            return 1
        }
    fi
fi
[ -z "$source_archive_name" ] || source_archive_name=$(_cv_validate_component "$source_archive_name") || {
    _cv_log "ERROR: invalid source archive name: $source_archive_name"
    return 1
}

source_tarball=""
env_parent=$(dirname "$env_path")
if [ -n "$source_archive_name" ]; then
    source_tarball=$(_cv_exact_archive "$archive_dir" "$source_archive_name") || source_tarball=""
    if [ -z "$source_tarball" ]; then
        source_tarball=$(_cv_exact_archive "$env_parent" "$source_archive_name") || source_tarball=""
    fi
fi
if [ -z "$source_tarball" ]; then
    source_tarball=$(_cv_exact_archive "$archive_dir" "$display_name") || source_tarball=""
fi
if [ -z "$source_tarball" ]; then
    source_tarball=$(_cv_exact_archive "$env_parent" "$display_name") || source_tarball=""
fi
[ -n "$source_tarball" ] || {
    _cv_log "ERROR: exact source archive not found for: $env_path"
    return 1
}

source_manifest_rc=0
source_manifest=$(_cv_read_archive_manifest "$source_tarball") || source_manifest_rc=$?
if [ "$source_manifest_rc" -ne 0 ] && [ "$source_manifest_rc" -ne 1 ]; then
    _cv_log "ERROR: source archive manifest is invalid or unreadable: $source_tarball"
    return 1
fi
if [ "$source_manifest_rc" -eq 0 ]; then
    display_name=$(_cv_manifest_field "$source_manifest" display_name) || display_name="$display_name"
    display_name=$(_cv_validate_component "$display_name") || return 1
    source_identity=$(_cv_manifest_field "$source_manifest" identity)
    if [ -z "$expected_identity" ]; then
        expected_identity="$source_identity"
    fi
    if [ "$source_identity" != "$expected_identity" ]; then
        _cv_log "ERROR: source archive belongs to a different environment: $source_tarball"
        return 1
    fi
fi
identity=$(_cv_portable_identity) || {
    _cv_log "ERROR: cannot generate a portable identity from /dev/urandom"
    return 1
}
archive_name=$(_cv_archive_name "$identity" "$display_name") || return 1
if _cv_exact_archive "$output_dir" "$archive_name" >/dev/null 2>&1; then
    _cv_log "ERROR: output archive already exists: ${output_dir}/${archive_name}${CV_BACKEND_EXT}"
    return 1
fi
scratch_key=$(_cv_scratch_key "$identity" "$output_dir" "$archive_name" "$display_name") || return 1

mkdir -p "$CV_JOB_SCRATCH" || return 1
temp_root=$(mktemp -d "${CV_JOB_SCRATCH}/cvenv-export.XXXXXX") || {
    _cv_log "ERROR: cannot create export scratch directory"
    return 1
}
payload="${temp_root}/${scratch_key}"
mkdir -p "$payload" || {
    command rm -rf "$temp_root"
    return 1
}
_cv_extract_archive_strip "$source_tarball" "$payload" || {
    _cv_log "ERROR: cannot extract source archive: $source_tarball"
    command rm -rf "$temp_root"
    return 1
}

venv_subdir=""
if [ -f "$payload/.venv/bin/activate" ]; then
    venv_subdir="/.venv"
fi
_cv_relocate_venv "$payload" || {
    command rm -rf "$temp_root"
    _cv_log "ERROR: cannot relocate the exported environment prefix"
    return 1
}
_cv_write_archive_name "$payload" "$archive_name" || {
    command rm -rf "$temp_root"
    return 1
}
_cv_write_manifest "$payload" "$identity" portable "" "$display_name" "$archive_name" "$scratch_key" || {
    command rm -rf "$temp_root"
    return 1
}

_cv_compress_venv "$payload" "$output_dir" "$venv_subdir" 1 "" || {
    command rm -rf "$temp_root"
    _cv_log "ERROR: portable export failed"
    return 1
}
command rm -rf "$temp_root"
_cv_log "Portable archive: ${output_dir}/${archive_name}${CV_BACKEND_EXT}"
_cv_log "Set read permissions before sharing: chmod a+r ${output_dir}/${archive_name}${CV_BACKEND_EXT}"
_cv_log "Copy that archive to another directory, then activate it by its display name"
return 0
]==], "")

set_shell_function("cvenv_export", [==[
_cv_export_venv "$@"
]==], "")

set_shell_function("_cv_patch_deactivate", [==[
local venv_name="$1"
local venv_dir="$2"
local archive_dir="$3"
local link_path="$4"
local venv_subdir="${5:-}"
local archive_name="${6:-$venv_name}"
local manifest identity scratch_key source_kind source_path
manifest=$(_cv_read_scratch_manifest "$venv_dir") || {
    _cv_log "ERROR: scratch manifest is invalid: $venv_dir"
    return 1
}
identity=$(_cv_manifest_field "$manifest" identity)
scratch_key=$(basename "$venv_dir")
source_kind=$(_cv_manifest_field "$manifest" source_kind)
source_path=$(_cv_manifest_field "$manifest" source_path) || source_path=""

if ! declare -F _cv_venv_deactivate >/dev/null; then
    eval "$(declare -f deactivate | sed '1s/^deactivate[[:space:]]*()/_cv_venv_deactivate()/; s/unset -f deactivate/unset -f _cv_venv_deactivate/g')"
fi

_CV_ACTIVE_NAME="$venv_name"
_CV_ACTIVE_ARCHIVE_NAME="$archive_name"
_CV_ACTIVE_DIR="$venv_dir"
_CV_ACTIVE_ARCHIVE_DIR="$archive_dir"
_CV_ACTIVE_LINK="$link_path"
_CV_ACTIVE_VENV_SUBDIR="$venv_subdir"
_CV_ACTIVE_IDENTITY="$identity"
_CV_ACTIVE_SCRATCH_KEY="$scratch_key"
_CV_ACTIVE_SOURCE_KIND="$source_kind"
_CV_ACTIVE_SOURCE_PATH="$source_path"
export _CV_ACTIVE_NAME _CV_ACTIVE_ARCHIVE_NAME _CV_ACTIVE_DIR _CV_ACTIVE_ARCHIVE_DIR _CV_ACTIVE_LINK _CV_ACTIVE_VENV_SUBDIR
export _CV_ACTIVE_IDENTITY _CV_ACTIVE_SCRATCH_KEY _CV_ACTIVE_SOURCE_KIND _CV_ACTIVE_SOURCE_PATH

deactivate() {
    local rc=0
    if [ "${CVENV_RO:-0}" = "1" ]; then
        _cv_log "CVENV_RO set; skipping recompression for ${_CV_ACTIVE_NAME}"
    else
        _cv_log "Saving ${_CV_ACTIVE_NAME} before deactivation"
        _cv_compress_venv "$_CV_ACTIVE_DIR" "$_CV_ACTIVE_ARCHIVE_DIR" "$_CV_ACTIVE_VENV_SUBDIR" || rc=$?
        if [ "$rc" -ne 0 ]; then
            _cv_log "ERROR: archive was not updated; expanded environment was retained"
            return "$rc"
        fi
    fi

    _cv_venv_deactivate || {
        _cv_log "ERROR: virtual-environment deactivation failed; scratch copy retained"
        return 1
    }
    if [ -L "$_CV_ACTIVE_LINK" ]; then
        command rm -f -- "$_CV_ACTIVE_LINK" || \
            _cv_log "WARNING: could not remove environment link: $_CV_ACTIVE_LINK"
    fi
    _cv_restore_ld_path
    unset -f _cv_venv_deactivate
    _cv_restore_deactivate_wrapper
    command rm -rf "$_CV_ACTIVE_DIR"
    _cv_scratch_cleanup
    if ! _cv_write_dummy_activate "$_CV_ACTIVE_ARCHIVE_NAME" "$_CV_ACTIVE_ARCHIVE_DIR" "$_CV_ACTIVE_LINK" "$_CV_ACTIVE_VENV_SUBDIR" "$_CV_ACTIVE_IDENTITY" "$_CV_ACTIVE_SCRATCH_KEY" "$_CV_ACTIVE_SOURCE_KIND" "$_CV_ACTIVE_SOURCE_PATH"; then
        _cv_log "WARNING: could not write activation stub; archive remains available"
    fi
    unset _CV_ACTIVE_NAME _CV_ACTIVE_ARCHIVE_NAME _CV_ACTIVE_DIR _CV_ACTIVE_ARCHIVE_DIR _CV_ACTIVE_LINK _CV_ACTIVE_VENV_SUBDIR
    unset _CV_ACTIVE_IDENTITY _CV_ACTIVE_SCRATCH_KEY _CV_ACTIVE_SOURCE_KIND _CV_ACTIVE_SOURCE_PATH
    unset _CV_AUTO_ACTIVATED
    if [ "${_CV_RO_AUTO:-0}" = "1" ]; then
        unset CVENV_RO _CV_RO_AUTO
    fi
    _cv_log "Environment archived and scratch copy removed"
}
]==], "")

set_shell_function("_cv_source_ordinary", [==[
local _cv_deactivate_before _cv_deactivate_after _cv_deactivate_body
_cv_deactivate_before=$(declare -f deactivate 2>/dev/null) || true
builtin source "$@"
local rc=$?
_cv_deactivate_after=$(declare -f deactivate 2>/dev/null) || true
if [ -z "$_cv_deactivate_after" ]; then
    if [ -n "$_cv_deactivate_before" ]; then
        _cv_restore_deactivate_wrapper
    fi
elif [ "$_cv_deactivate_after" != "$_cv_deactivate_before" ]; then
    _cv_deactivate_body=$(printf '%s\n' "$_cv_deactivate_after" | sed '1s/^deactivate[[:space:]]*()/_cv_ordinary_deactivate()/; s/unset -f deactivate/unset -f _cv_ordinary_deactivate/g') || rc=$?
    if [ "$rc" -eq 0 ]; then
        eval "$_cv_deactivate_body"
        deactivate() {
            _cv_ordinary_deactivate || return $?
            unset -f _cv_ordinary_deactivate
            _cv_restore_deactivate_wrapper
        }
    fi
fi
return "$rc"
]==], "")

set_shell_function("_cv_restore_deactivate_wrapper", [==[
unset -f _cv_ordinary_deactivate _cv_venv_deactivate
deactivate() {
    _cv_fallback_deactivate
}
]==], "")

set_shell_function("_cv_python_module", [==[
local index=1 next_index argument
while [ "$index" -le "$#" ]; do
    argument="${@:index:1}"
    case "$argument" in
        -m)
            next_index=$((index + 1))
            [ "$next_index" -le "$#" ] || return 1
            printf '%s\n' "${@:next_index:1}"
            return 0
            ;;
        -c|-W|-X|--check-hash-based-pycs)
            index=$((index + 2))
            ;;
        -*) index=$((index + 1)) ;;
        *)
            return 1
            ;;
    esac
done
return 1
]==], "")

set_shell_function("_cv_mark_created", [==[
local venv_name="$1" archive_name="$2" target="$3" archive_dir="$4" link_path="$5" venv_subdir="${6:-}"
_CV_ACTIVE_NAME="$venv_name"
_CV_ACTIVE_ARCHIVE_NAME="$archive_name"
_CV_ACTIVE_DIR="$target"
_CV_ACTIVE_ARCHIVE_DIR="$archive_dir"
_CV_ACTIVE_LINK="$link_path"
_CV_ACTIVE_VENV_SUBDIR="$venv_subdir"
export _CV_ACTIVE_NAME _CV_ACTIVE_ARCHIVE_NAME _CV_ACTIVE_DIR _CV_ACTIVE_ARCHIVE_DIR _CV_ACTIVE_LINK _CV_ACTIVE_VENV_SUBDIR
_cv_restore_deactivate_wrapper
]==], "")

set_shell_function("_cv_python_wrapper", [==[
local name="$1"
local fallback="$2"
shift 2

_cv_apply_job_cache || return 1

local interpreter
interpreter=$(type -P "$name" 2>/dev/null) || interpreter=""
[ -n "$interpreter" ] || interpreter="$fallback"
[ -n "$interpreter" ] || {
    _cv_log "ERROR: no '$name' interpreter available"
    return 127
}

local managed_module
managed_module=$(_cv_python_module "$@") || managed_module=""
if [ -n "$managed_module" ] && [ "${1:-}" != "-m" ]; then
    _cv_log "ERROR: python options before -m $managed_module are not supported"
    return 2
fi

if [ "${1:-}" = "-m" ] && [ "${2:-}" = "venv" ]; then
    local help_arg
    for help_arg in "${@:3}"; do
        case "$help_arg" in
            -h|--help)
                "$interpreter" "$@"
                return $?
                ;;
        esac
    done
    shift 2
    _cv_require_inactive || return 1
    if [ "$#" -lt 1 ]; then
        _cv_log "ERROR: no virtual-environment path specified"
        return 2
    fi
    local requested="${!#}"
    requested="${requested%/}"
    local venv_name scratch_name archive_name target archive_dir link_path identity source_path
    venv_name=$(_cv_base_name "$requested")
    if [ -z "$venv_name" ] || [ "$venv_name" = "." ] || [ "$venv_name" = ".." ]; then
        _cv_log "ERROR: invalid environment path: $requested"
        return 2
    fi

    archive_dir=$(_cv_archive_dir) || return 1
    archive_dir=$(builtin cd "$archive_dir" 2>/dev/null && pwd -P) || {
        _cv_log "ERROR: archive directory does not exist: $archive_dir"
        return 1
    }
    source_path=$(_cv_canonical_path "$requested") || {
        _cv_log "ERROR: cannot resolve environment path: $requested"
        return 1
    }
    identity=$(_cv_identity path "$source_path") || {
        _cv_log "ERROR: cannot derive environment identity"
        return 1
    }
    archive_name=$(_cv_archive_name "$identity" "$venv_name")
    scratch_name=$(_cv_scratch_key "$identity" "$archive_dir" "$archive_name" "$venv_name")
    case "$requested" in
        /*) link_path="$requested" ;;
        *)  link_path="$PWD/$requested" ;;
    esac
    target="${CV_JOB_SCRATCH}/${scratch_name}"

    if ! _cv_validate_public_link "$requested" "$target" 0; then
        _cv_log "ERROR: path already exists and is not a cvenv symlink: $requested"
        return 1
    fi

    _cv_check_new_archive "$archive_dir" "$archive_name" "$venv_name" "$identity" || return 1
    if [ -d "$target" ]; then
        _cv_log "ERROR: environment is already expanded in job scratch: $target"
        return 1
    fi

    _cv_claim_scratch "$target" "$identity" || return 1
    _cv_log "Creating environment in job scratch: $target"

    local -a args=("$@") create_args=("$interpreter" -m venv)
    unset 'args[${#args[@]}-1]'
    if [ "${#args[@]}" -gt 0 ]; then
        create_args+=("${args[@]}")
    fi
    create_args+=("$target")
    "${create_args[@]}" || {
        _cv_log "ERROR: virtual-environment creation failed"
        command rm -rf "$target"
        return 1
    }
    printf '%s\n' "$target" > "$target/.cvenv-prefix" || {
        command rm -rf "$target"
        return 1
    }
    _cv_write_archive_name "$target" "$archive_name" || {
        command rm -rf "$target"
        return 1
    }
    _cv_write_manifest "$target" "$identity" path "$source_path" "$venv_name" "$archive_name" "$scratch_name" || {
        command rm -rf "$target"
        return 1
    }

    _cv_patch_nccl "$target" ""
    mkdir -p "$(dirname "$link_path")" || {
        command rm -rf "$target"
        return 1
    }
    ln -sfn "$target" "$link_path" || {
        command rm -rf "$target"
        return 1
    }
    _cv_mark_created "$venv_name" "$archive_name" "$target" "$archive_dir" "$link_path" ""
    _cv_compress_venv "$target" "$archive_dir" "" 1 || {
        _cv_log "ERROR: initial archive creation failed; expanded environment was retained"
        return 1
    }
    _cv_log "Ready: $requested -> $target"
    _cv_log "Run: source $requested/bin/activate"
    return 0
fi

local rc _cv_active_env="${VIRTUAL_ENV:-${CONDA_PREFIX:-}}"
if [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/$name" ]; then
    "$VIRTUAL_ENV/bin/$name" "$@"
elif [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
    "$VIRTUAL_ENV/bin/python" "$@"
elif [ -n "${CONDA_PREFIX:-}" ] && [ -x "$CONDA_PREFIX/bin/$name" ]; then
    "$CONDA_PREFIX/bin/$name" "$@"
elif [ -n "${CONDA_PREFIX:-}" ] && [ -x "$CONDA_PREFIX/bin/python" ]; then
    "$CONDA_PREFIX/bin/python" "$@"
else
    "$interpreter" "$@"
fi
rc=$?

if [ "$rc" -eq 0 ] && [ "$managed_module" = "pip" ] && \
   [ -n "${_CV_ACTIVE_DIR:-}" ] && \
   [ "$_cv_active_env" = "${_CV_ACTIVE_DIR}${_CV_ACTIVE_VENV_SUBDIR:-}" ]; then
    _cv_save_pip_mutation "$_cv_active_env" "$rc" "${@:3}" || return $?
fi
return "$rc"
]==], "")

set_shell_function("python", [==[
_cv_python_wrapper "python" "$CV_ORIGINAL_PYTHON" "$@"
]==], "")

set_shell_function("python3", [==[
_cv_python_wrapper "python3" "$CV_ORIGINAL_PYTHON3" "$@"
]==], "")


-- Conda: create a named environment in scratch.
set_shell_function("_cv_conda_create", [==[
local requested="$1"
local source_kind="$2"
shift 2

_cv_require_inactive || return 1
if [ -z "$requested" ]; then
    _cv_log "ERROR: no environment name specified"
    return 2
fi
requested="${requested%/}"

local venv_name scratch_name archive_name target archive_dir link_path identity source_path
venv_name=$(_cv_base_name "$requested")
if [ -z "$venv_name" ] || [ "$venv_name" = "." ] || [ "$venv_name" = ".." ]; then
    _cv_log "ERROR: invalid environment name: $requested"
    return 2
fi

archive_dir=$(_cv_archive_dir) || return 1
archive_dir=$(builtin cd "$archive_dir" 2>/dev/null && pwd -P) || {
    _cv_log "ERROR: archive directory does not exist: $archive_dir"
    return 1
}
if [ "$source_kind" = "conda-prefix" ]; then
    source_path=$(_cv_canonical_path "$requested") || {
        _cv_log "ERROR: cannot resolve conda prefix: $requested"
        return 1
    }
else
    source_path="$requested"
fi
identity=$(_cv_identity "$source_kind" "$source_path") || {
    _cv_log "ERROR: cannot derive conda environment identity"
    return 1
}
archive_name=$(_cv_archive_name "$identity" "$venv_name")
scratch_name=$(_cv_scratch_key "$identity" "$archive_dir" "$archive_name" "$venv_name")
case "$source_kind" in
    conda-prefix)
        case "$requested" in
            /*) link_path="$requested" ;;
            *)  link_path="$PWD/$requested" ;;
        esac
        ;;
    *)
        link_path="$PWD/$venv_name"
        ;;
esac
target="${CV_JOB_SCRATCH}/${scratch_name}"

local existing_path="$venv_name"
[ "$source_kind" != "conda-prefix" ] || existing_path="$requested"
if ! _cv_validate_public_link "$existing_path" "$target" 0; then
    _cv_log "ERROR: path already exists and is not a cvenv symlink: $existing_path"
    return 1
fi

_cv_check_new_archive "$archive_dir" "$archive_name" "$venv_name" "$identity" || return 1
if [ -d "$target" ]; then
    _cv_log "ERROR: environment is already expanded in job scratch: $target"
    return 1
fi
_cv_claim_scratch "$target" "$identity" || return 1
_cv_log "Creating conda environment in job scratch: $target"
"$CV_CONDA" create --prefix "$target" "$@" -y || {
    _cv_log "ERROR: conda create failed"
    command rm -rf "$target"
    return 1
}
printf '%s\n' "$target" > "$target/.cvenv-prefix" || {
    command rm -rf "$target"
    return 1
}
_cv_write_archive_name "$target" "$archive_name" || {
    command rm -rf "$target"
    return 1
}
_cv_write_manifest "$target" "$identity" "$source_kind" "$source_path" "$venv_name" "$archive_name" "$scratch_name" || {
    command rm -rf "$target"
    return 1
}

_cv_patch_nccl "$target" ""
mkdir -p "$(dirname "$link_path")" || {
    command rm -rf "$target"
    return 1
}
ln -sfn "$target" "$link_path" || {
    command rm -rf "$target"
    return 1
}
_cv_mark_created "$venv_name" "$archive_name" "$target" "$archive_dir" "$link_path" ""
_cv_compress_venv "$target" "$archive_dir" "" 1 "$link_path" || {
    _cv_log "ERROR: initial archive creation failed; expanded environment was retained"
    return 1
}
_cv_log "Ready: $venv_name -> $target"
_cv_log "Run: conda activate $venv_name"
return 0
]==], "")

-- Conda: create an environment from environment.yml in scratch.
set_shell_function("_cv_conda_env_create", [==[
local env_file=""
local requested=""
local explicit_kind=""
local conda_option
local -a passthrough=()

_cv_require_inactive || return 1
while [ "$#" -gt 0 ]; do
    case "$1" in
        -f|--file)
            shift
            [ "$#" -gt 0 ] || { _cv_log "ERROR: --file requires a value"; return 2; }
            env_file="$1"
            ;;
        --file=*)
            env_file="${1#--file=}"
            ;;
        -n|--name)
            shift
            [ "$#" -gt 0 ] || { _cv_log "ERROR: --name requires a value"; return 2; }
            requested="$1"
            explicit_kind="conda-name"
            ;;
        --name=*)
            requested="${1#--name=}"
            explicit_kind="conda-name"
            ;;
        -p|--prefix)
            shift
            [ "$#" -gt 0 ] || { _cv_log "ERROR: --prefix requires a value"; return 2; }
            requested="$1"
            explicit_kind="conda-prefix"
            ;;
        --prefix=*)
            requested="${1#--prefix=}"
            explicit_kind="conda-prefix"
            ;;
        -n?*)
            requested="${1#-n}"
            explicit_kind="conda-name"
            ;;
        -p?*)
            requested="${1#-p}"
            explicit_kind="conda-prefix"
            ;;
        -c|--channel|--solver|--subdir)
            conda_option="$1"
            shift
            [ "$#" -gt 0 ] || { _cv_log "ERROR: $conda_option requires a value"; return 2; }
            passthrough+=("$conda_option" "$1")
            ;;
        -q|-v|-y|--json|--console|--debug|--quiet|--yes|--dry-run|--force|--offline|--override-channels|--download-only|--help)
            passthrough+=("$1")
            ;;
        --*=*)
            passthrough+=("$1")
            ;;
        -*)
            _cv_log "ERROR: unsupported conda env create option: $1"
            return 2
            ;;
        *)
            if [ -z "$env_file" ] && [ -f "$1" ]; then
                env_file="$1"
            elif [ -z "$requested" ]; then
                requested="$1"
            else
                passthrough+=("$1")
            fi
            ;;
    esac
    shift
done

if [ -z "$env_file" ]; then
    env_file="environment.yml"
fi
if [ ! -f "$env_file" ]; then
    _cv_log "ERROR: environment file not found: $env_file"
    return 1
fi

# Derive the environment name: -n/--name wins, then the YAML name field, then basename.
if [ -z "$requested" ]; then
    requested=$(grep -E '^[[:space:]]*name:' "$env_file" 2>/dev/null | head -1 | sed 's/^[[:space:]]*name:[[:space:]]*//; s/[[:space:]]*$//; s/^"\(.*\)"$/\1/; s/^'\''\(.*\)'\''$/\1/')
fi
if [ -z "$requested" ]; then
    requested=$(basename -- "$env_file")
    requested="${requested%.*}"
fi
requested="${requested%/}"

local venv_name scratch_name archive_name target archive_dir link_path identity source_kind source_path
venv_name=$(basename -- "${requested%/}")
if [ -z "$venv_name" ] || [ "$venv_name" = "." ] || [ "$venv_name" = ".." ]; then
    _cv_log "ERROR: invalid environment name: $requested"
    return 2
fi

archive_dir=$(_cv_archive_dir) || return 1
archive_dir=$(builtin cd "$archive_dir" 2>/dev/null && pwd -P) || {
    _cv_log "ERROR: archive directory does not exist: $archive_dir"
    return 1
}
case "$explicit_kind" in
    conda-name)
        source_kind="conda-name"
        source_path="$requested"
        ;;
    conda-prefix)
        source_kind="conda-prefix"
        source_path=$(_cv_canonical_path "$requested") || {
            _cv_log "ERROR: cannot resolve conda prefix: $requested"
            return 1
        }
        ;;
    *)
        source_kind="conda-env-file"
        source_path=$(_cv_canonical_path "$env_file") || {
            _cv_log "ERROR: cannot resolve environment file: $env_file"
            return 1
        }
        ;;
esac
identity=$(_cv_identity "$source_kind" "$source_path") || {
    _cv_log "ERROR: cannot derive conda environment identity"
    return 1
}
archive_name=$(_cv_archive_name "$identity" "$venv_name")
scratch_name=$(_cv_scratch_key "$identity" "$archive_dir" "$archive_name" "$venv_name")
case "$source_kind" in
    conda-prefix)
        case "$requested" in
            /*) link_path="$requested" ;;
            *)  link_path="$PWD/$requested" ;;
        esac
        ;;
    conda-name)
        link_path="$PWD/$venv_name"
        ;;
    *)
        link_path=$(_cv_canonical_path "$(dirname -- "$env_file")/$venv_name") || return 1
        ;;
esac
target="${CV_JOB_SCRATCH}/${scratch_name}"

if ! _cv_validate_public_link "$link_path" "$target" 0; then
    _cv_log "ERROR: path already exists and is not a cvenv symlink: $link_path"
    return 1
fi

_cv_check_new_archive "$archive_dir" "$archive_name" "$venv_name" "$identity" || return 1
if [ -d "$target" ]; then
    _cv_log "ERROR: environment is already expanded in job scratch: $target"
    return 1
fi
_cv_claim_scratch "$target" "$identity" || return 1
_cv_log "Creating conda environment from $env_file in job scratch: $target"
local -a create_args=("$CV_CONDA" env create -f "$env_file" --prefix "$target")
if [ "${#passthrough[@]}" -gt 0 ]; then
    create_args+=("${passthrough[@]}")
fi
create_args+=(-y)
"${create_args[@]}" || {
    _cv_log "ERROR: conda env create failed"
    command rm -rf "$target"
    return 1
}
printf '%s\n' "$target" > "$target/.cvenv-prefix" || {
    command rm -rf "$target"
    return 1
}
_cv_write_archive_name "$target" "$archive_name" || {
    command rm -rf "$target"
    return 1
}
_cv_write_manifest "$target" "$identity" "$source_kind" "$source_path" "$venv_name" "$archive_name" "$scratch_name" || {
    command rm -rf "$target"
    return 1
}

_cv_patch_nccl "$target" ""
mkdir -p "$(dirname "$link_path")" || {
    command rm -rf "$target"
    return 1
}
ln -sfn "$target" "$link_path" || {
    command rm -rf "$target"
    return 1
}
_cv_mark_created "$venv_name" "$archive_name" "$target" "$archive_dir" "$link_path" ""
_cv_compress_venv "$target" "$archive_dir" "" 1 "$link_path" || {
    _cv_log "ERROR: initial archive creation failed; expanded environment was retained"
    return 1
}
_cv_log "Ready: $venv_name -> $target"
_cv_log "Run: conda activate $venv_name"
return 0
]==], "")

-- Conda: patch conda's deactivate so it archives the environment.
set_shell_function("_cv_conda_patch_deactivate", [==[
local venv_name="$1"
local venv_dir="$2"
local archive_dir="$3"
local link_path="$4"
local archive_name="${5:-$venv_name}"
local manifest identity scratch_key source_kind source_path
manifest=$(_cv_read_scratch_manifest "$venv_dir") || {
    _cv_log "ERROR: scratch manifest is invalid: $venv_dir"
    return 1
}
identity=$(_cv_manifest_field "$manifest" identity)
scratch_key=$(basename "$venv_dir")
source_kind=$(_cv_manifest_field "$manifest" source_kind)
source_path=$(_cv_manifest_field "$manifest" source_path) || source_path=""

_CV_ACTIVE_NAME="$venv_name"
_CV_ACTIVE_ARCHIVE_NAME="$archive_name"
_CV_ACTIVE_DIR="$venv_dir"
_CV_ACTIVE_ARCHIVE_DIR="$archive_dir"
_CV_ACTIVE_LINK="$link_path"
_CV_ACTIVE_VENV_SUBDIR=""
_CV_ACTIVE_IDENTITY="$identity"
_CV_ACTIVE_SCRATCH_KEY="$scratch_key"
_CV_ACTIVE_SOURCE_KIND="$source_kind"
_CV_ACTIVE_SOURCE_PATH="$source_path"
export _CV_ACTIVE_NAME _CV_ACTIVE_ARCHIVE_NAME _CV_ACTIVE_DIR _CV_ACTIVE_ARCHIVE_DIR _CV_ACTIVE_LINK _CV_ACTIVE_VENV_SUBDIR
export _CV_ACTIVE_IDENTITY _CV_ACTIVE_SCRATCH_KEY _CV_ACTIVE_SOURCE_KIND _CV_ACTIVE_SOURCE_PATH

# Override shell-level deactivate; when user runs "conda deactivate", the wrapper archives.
deactivate() {
    local rc=0
    if [ "${CVENV_RO:-0}" = "1" ]; then
        _cv_log "CVENV_RO set; skipping recompression for ${_CV_ACTIVE_NAME}"
    else
        _cv_log "Saving ${_CV_ACTIVE_NAME} before deactivation"
        _cv_compress_venv "$_CV_ACTIVE_DIR" "$_CV_ACTIVE_ARCHIVE_DIR" "" || rc=$?
        if [ "$rc" -ne 0 ]; then
            _cv_log "ERROR: archive was not updated; expanded environment was retained"
            return "$rc"
        fi
    fi

    # Let conda clean up its own environment variables.
    local _cv_conda_output _cv_conda_rc
    _cv_conda_rc=0
    _cv_conda_output=$("$CV_CONDA" shell.bash deactivate) || _cv_conda_rc=$?
    if [ "$_cv_conda_rc" -ne 0 ]; then
        _cv_log "ERROR: conda deactivation failed; scratch copy retained"
        return "$_cv_conda_rc"
    fi
    eval "$_cv_conda_output" || {
        _cv_log "ERROR: conda deactivation output could not be applied"
        return 1
    }

    if [ -L "$_CV_ACTIVE_LINK" ]; then
        command rm -f -- "$_CV_ACTIVE_LINK" || \
            _cv_log "WARNING: could not remove environment link: $_CV_ACTIVE_LINK"
    fi

    # Restore PS1 in case conda's deactivate lost it.
    if [ -n "${_CV_PS1_BACKUP+x}" ]; then
        PS1="$_CV_PS1_BACKUP"
        export PS1
        unset _CV_PS1_BACKUP
    fi

    # Restore LD_LIBRARY_PATH to its pre-activation state.
    _cv_restore_ld_path

    command rm -rf "$_CV_ACTIVE_DIR"
    _cv_scratch_cleanup
    if ! _cv_write_dummy_activate "$_CV_ACTIVE_ARCHIVE_NAME" "$_CV_ACTIVE_ARCHIVE_DIR" "$_CV_ACTIVE_LINK" "" "$_CV_ACTIVE_IDENTITY" "$_CV_ACTIVE_SCRATCH_KEY" "$_CV_ACTIVE_SOURCE_KIND" "$_CV_ACTIVE_SOURCE_PATH"; then
        _cv_log "WARNING: could not write activation stub; archive remains available"
    fi
    unset _CV_ACTIVE_NAME _CV_ACTIVE_ARCHIVE_NAME _CV_ACTIVE_DIR _CV_ACTIVE_ARCHIVE_DIR _CV_ACTIVE_LINK _CV_ACTIVE_VENV_SUBDIR
    unset _CV_ACTIVE_IDENTITY _CV_ACTIVE_SCRATCH_KEY _CV_ACTIVE_SOURCE_KIND _CV_ACTIVE_SOURCE_PATH
    unset _CV_AUTO_ACTIVATED
    if [ "${_CV_RO_AUTO:-0}" = "1" ]; then
        unset CVENV_RO _CV_RO_AUTO
    fi
    _cv_restore_deactivate_wrapper
    _cv_log "Environment archived and scratch copy removed"
}
]==], "")

set_shell_function("_cv_set_prompt", [==[
local display_name="$1"
local original_ps1="$2"
PS1="($display_name) ${original_ps1}"
export PS1
]==], "")

-- Conda: main wrapper.
set_shell_function("_cv_save_conda_mutation", [==[
local command_name="$1" rc="$2"
[ "$rc" -eq 0 ] || return 0
[ -n "${_CV_ACTIVE_DIR:-}" ] || return 0
[ "${CONDA_PREFIX:-}" = "$_CV_ACTIVE_DIR" ] || return 0
_cv_patch_nccl "$_CV_ACTIVE_DIR" ""
_cv_log "Saving environment changes after conda $command_name"
_cv_compress_venv "$_CV_ACTIVE_DIR" "$_CV_ACTIVE_ARCHIVE_DIR" || return $?
_cv_propagate_nodes "$_CV_ACTIVE_ARCHIVE_NAME" "$_CV_ACTIVE_ARCHIVE_DIR" "" 1 "${_CV_ACTIVE_DIR##*/}" "$(_cv_read_scratch_identity "$_CV_ACTIVE_DIR")"
return 0
]==], "")

set_shell_function("conda", [==[
# Locate conda if not detected at module load time.
if [ -z "${CV_CONDA:-}" ]; then
    CV_CONDA=$(type -P conda 2>/dev/null)
    if [ -z "$CV_CONDA" ]; then
        _cv_log "ERROR: conda is not available"
        return 127
    fi
fi

# Activation/deactivation uses "conda shell.bash activate/deactivate" (binary) to avoid recursion.
local _cv_conda_arg
for _cv_conda_arg in "$@"; do
    case "$_cv_conda_arg" in
        -h|--help)
            "$CV_CONDA" "$@"
            return $?
            ;;
    esac
done

local _cv_conda_cmd="${1:-}"

# Reject forms the mutation hook cannot parse instead of silently skipping recompression.
if [ "${1:-}" = "-" ] || [[ "${1:-}" == -* ]]; then
    for _cv_conda_arg in "${@:2}"; do
        case "$_cv_conda_arg" in
            install|remove|uninstall|update|upgrade)
                _cv_log "ERROR: put conda global options after the mutating subcommand"
                return 2
                ;;
        esac
    done
fi

case "$_cv_conda_cmd" in
    create)
        shift
        local requested=""
        local source_kind=""
        local -a passthrough=()
        while [ "$#" -gt 0 ]; do
            case "$1" in
                -n|--name)
                    shift
                    [ "$#" -gt 0 ] || { _cv_log "ERROR: --name requires a value"; return 2; }
                    requested="$1"
                    source_kind="conda-name"
                    ;;
                --name=*)
                    requested="${1#--name=}"
                    source_kind="conda-name"
                    ;;
                -p|--prefix)
                    shift
                    [ "$#" -gt 0 ] || { _cv_log "ERROR: --prefix requires a value"; return 2; }
                    requested="$1"
                    source_kind="conda-prefix"
                    ;;
                --prefix=*)
                    requested="${1#--prefix=}"
                    source_kind="conda-prefix"
                    ;;
                -n?*)
                    requested="${1#-n}"
                    source_kind="conda-name"
                    ;;
                -p?*)
                    requested="${1#-p}"
                    source_kind="conda-prefix"
                    ;;
                *)
                    passthrough+=("$1")
                    ;;
            esac
            shift
        done
        if [ -z "$requested" ]; then
            _cv_log "ERROR: conda create requires -n/--name or -p/--prefix"
            return 2
        fi
        if [ "${#passthrough[@]}" -gt 0 ]; then
            _cv_conda_create "$requested" "$source_kind" "${passthrough[@]}"
        else
            _cv_conda_create "$requested" "$source_kind"
        fi
        return $?
        ;;
    env)
        local _cv_conda_subcmd="${2:-}"
        case "$_cv_conda_subcmd" in
            create)
                shift 2
                _cv_conda_env_create "$@"
                return $?
                ;;
            update)
                local rc
                "$CV_CONDA" "$@"
                rc=$?
                _cv_save_conda_mutation "$_cv_conda_subcmd" "$rc" || return $?
                return "$rc"
                ;;
            *)
                "$CV_CONDA" "$@"
                return $?
                ;;
        esac
        ;;
    activate)
        shift
        local requested=""
        while [ "$#" -gt 0 ]; do
            case "$1" in
                -*)
                    ;;
                *)
                    if [ -z "$requested" ]; then
                        requested="$1"
                    else
                        _cv_log "ERROR: conda activate accepts only one environment"
                        return 2
                    fi
                    ;;
            esac
            shift
        done
        if [ -z "$requested" ]; then
            _cv_log "ERROR: conda activate requires an environment name"
            return 2
        fi
        if [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; then
            _cv_log "ERROR: deactivate the active environment before activating another"
            return 1
        fi
        local venv_name display_name archive_name archive_dir target link_path identity scratch_key source_kind source_path
        local portable_tarball portable_manifest portable_rc selected_tarball selector portable_found=0
        local stub_identity stub_archive_name stub_scratch_key
        local stub_source_kind stub_source_path
        local stub_path
        venv_name=$(basename "${requested%/}")
        archive_dir=$(_cv_archive_dir) || return 1
        archive_dir=$(builtin cd "$archive_dir" 2>/dev/null && pwd -P) || return 1
        case "$requested" in
            /*) stub_path="$requested" ;;
            */*) stub_path="$PWD/$requested" ;;
            *)  stub_path="$PWD/$venv_name" ;;
        esac
        stub_identity=$(sed -n 's/^# CVENV_IDENTITY=//p' "${stub_path}/bin/activate" 2>/dev/null | head -1)
        stub_archive_name=$(sed -n 's/^# CVENV_ARCHIVE_NAME=//p' "${stub_path}/bin/activate" 2>/dev/null | head -1)
        stub_scratch_key=$(sed -n 's/^# CVENV_SCRATCH_KEY=//p' "${stub_path}/bin/activate" 2>/dev/null | head -1)
        stub_source_kind=$(sed -n 's/^# CVENV_SOURCE_KIND=//p' "${stub_path}/bin/activate" 2>/dev/null | head -1)
        stub_source_path=$(sed -n 's/^# CVENV_SOURCE_PATH=//p' "${stub_path}/bin/activate" 2>/dev/null | head -1)
        [ -z "$stub_identity" ] || stub_identity=$(_cv_validate_identity "$stub_identity") || return 1
        [ -z "$stub_archive_name" ] || stub_archive_name=$(_cv_validate_component "$stub_archive_name") || return 1
        [ -z "$stub_scratch_key" ] || stub_scratch_key=$(_cv_validate_component "$stub_scratch_key") || return 1
        [ -z "$stub_source_kind" ] || stub_source_kind=$(_cv_validate_source_kind "$stub_source_kind") || return 1
        [ -z "$stub_source_path" ] || stub_source_path=$(_cv_validate_source_path "$stub_source_path") || return 1
        if [ -L "$requested" ]; then
            local _cv_link_target
            _cv_link_target=$(readlink -f "$requested" 2>/dev/null) || _cv_link_target=""
            if [ -d "$_cv_link_target" ]; then
                local _cv_target_manifest
                _cv_target_manifest=$(cat "$_cv_link_target/.cvenv-manifest" 2>/dev/null) || _cv_target_manifest=""
                stub_identity=$(_cv_read_scratch_identity "$_cv_link_target") || stub_identity=""
                stub_archive_name=$(cat "$_cv_link_target/.cvenv-archive-name" 2>/dev/null) || stub_archive_name=""
                stub_scratch_key=$(basename "$_cv_link_target")
                stub_source_kind=$(_cv_manifest_field "$_cv_target_manifest" source_kind) || stub_source_kind=""
                stub_source_path=$(_cv_manifest_field "$_cv_target_manifest" source_path) || stub_source_path=""
            fi
        fi
        display_name="$venv_name"
        selected_tarball=""
        if [ -n "${CVENV_ARCHIVE_NAME:-}" ]; then
            selector=$(_cv_archive_selector "$CVENV_ARCHIVE_NAME") || return 1
            selected_tarball=$(_cv_exact_archive "$archive_dir" "$selector") || {
                _cv_log "ERROR: CVENV_ARCHIVE_NAME does not exist: $selector"
                return 1
            }
            portable_rc=0
            portable_manifest=$(_cv_read_archive_manifest "$selected_tarball") || portable_rc=$?
            if [ "$portable_rc" -ne 0 ] && [ "$portable_rc" -ne 1 ]; then
                _cv_log "ERROR: archive manifest is invalid or unreadable: $selected_tarball"
                return 1
            fi
            if [ "$portable_rc" -eq 0 ] && \
               [ "$(_cv_manifest_field "$portable_manifest" source_kind)" = "portable" ]; then
                identity=$(_cv_manifest_field "$portable_manifest" identity)
                source_kind=portable
                display_name=$(_cv_manifest_field "$portable_manifest" display_name)
                portable_found=1
            fi
        elif [ -z "$stub_identity" ]; then
            portable_rc=0
            portable_tarball=$(_cv_find_portable_archive "$archive_dir" "$venv_name") || portable_rc=$?
            if [ "$portable_rc" -eq 0 ]; then
                selected_tarball="$portable_tarball"
                portable_manifest=$(_cv_read_archive_manifest "$selected_tarball")
                identity=$(_cv_manifest_field "$portable_manifest" identity)
                source_kind=portable
                display_name=$(_cv_manifest_field "$portable_manifest" display_name)
                portable_found=1
            elif [ "$portable_rc" -ne 1 ]; then
                return 1
            fi
        fi
        if [ "$portable_found" -eq 0 ]; then
            if [ -n "$stub_identity" ]; then
            identity="$stub_identity"
            source_kind=${stub_source_kind:-stub}
            source_path=${stub_source_path:-$requested}
            elif [[ "$requested" == /* ]] || [[ "$requested" == */* ]]; then
                source_kind="conda-prefix"
                source_path=$(_cv_canonical_path "$requested") || {
                    _cv_log "ERROR: cannot resolve conda prefix: $requested"
                    return 1
                }
                identity=$(_cv_identity "$source_kind" "$source_path")
            else
                source_kind="conda-name"
                source_path="$requested"
                identity=$(_cv_identity "$source_kind" "$source_path")
            fi
        fi
        if [ "$source_kind" = "portable" ]; then
            source_path=""
        fi
        if [ -n "$selected_tarball" ]; then
            archive_name=$(_cv_archive_base_name "$selected_tarball")
        else
            archive_name=${stub_archive_name:-$(_cv_archive_name "$identity" "$venv_name")}
        fi
        if [ "$source_kind" = "portable" ]; then
            scratch_key=$(_cv_scratch_key "$identity" "$archive_dir" "$archive_name" "$display_name")
        else
            scratch_key=${stub_scratch_key:-$(_cv_scratch_key "$identity" "$archive_dir" "$archive_name" "$venv_name")}
        fi
        target="${CV_JOB_SCRATCH}/${scratch_key}"
        if [ "$source_kind" = "conda-prefix" ]; then
            link_path="$stub_path"
        else
            link_path="$PWD/$venv_name"
        fi
        # A conda env has bin/conda or bin/python; remove a stub directory.
        if ! _cv_validate_public_link "$link_path" "$target" 1; then
            _cv_log "ERROR: environment path exists and is not a cvenv symlink: $link_path"
            return 1
        fi
        if [ -d "$link_path" ] && [ ! -L "$link_path" ] && \
            [ -f "${link_path}/bin/activate" ] && \
            grep -q 'CVENV_STUB' "${link_path}/bin/activate" 2>/dev/null; then
            command rm -rf "$link_path"
        fi
        if [ -e "$link_path" ] && [ ! -L "$link_path" ]; then
            _cv_log "ERROR: environment path exists and is not a cvenv symlink: $link_path"
            return 1
        fi
        if [ -d "$target" ]; then
            local existing_identity
            existing_identity=$(_cv_read_scratch_identity "$target") || existing_identity=""
            if [ "$existing_identity" = "$identity" ]; then
                mkdir -p "$(dirname "$link_path")" || return 1
                ln -sfn "$target" "$link_path" || return 1
            else
                _cv_log "ERROR: scratch path belongs to another environment: $target"
                return 1
            fi
        elif _cv_find_archive "$archive_dir" "$archive_name" >/dev/null 2>&1 || \
             _cv_find_archive "$archive_dir" "$venv_name" >/dev/null 2>&1; then
            _cv_decompress_venv "$archive_name" "$archive_dir" "$scratch_key" "$identity" "$source_kind" "$source_path" "$display_name" || return 1
            archive_name=$(cat "$target/.cvenv-archive-name" 2>/dev/null) || archive_name="$archive_name"
            mkdir -p "$(dirname "$link_path")" || return 1
            ln -sfn "$target" "$link_path" || return 1
        else
            _cv_log "ERROR: no archive or scratch environment found for $venv_name"
            _cv_log "       looked for: ${archive_dir}/${archive_name}${CV_BACKEND_EXT}"
            _cv_log "       and scratch: $target"
            return 1
        fi

        # Propagate env to all nodes so plain "srun <cmd>" works on every node.
        _cv_propagate_nodes "$archive_name" "$archive_dir" "" 0 "$scratch_key" "$identity"

        # Activate via "conda shell.bash activate" to eval, avoiding recursion.
        local rc _cv_conda_output _cv_conda_rc _cv_ps1_before
        _cv_read_scratch_identity "$target" >/dev/null || {
            _cv_log "ERROR: scratch manifest is invalid: $target"
            return 1
        }
        _cv_ps1_before="${PS1:-}"
        _CV_PS1_BACKUP="$_cv_ps1_before"
        _cv_conda_rc=0
        _cv_conda_output=$("$CV_CONDA" shell.bash activate "$target") || _cv_conda_rc=$?
        if [ "$_cv_conda_rc" -ne 0 ]; then
            unset _CV_PS1_BACKUP
            _cv_log "ERROR: conda activation failed; scratch copy retained"
            return "$_cv_conda_rc"
        fi
        eval "$_cv_conda_output"
        rc=$?
        [ "$rc" -eq 0 ] || { unset _CV_PS1_BACKUP; return "$rc"; }
        _cv_restore_env_vars "$target" "" || {
            _cv_log "ERROR: invalid environment variable snapshot"
            return 1
        }
        _cv_set_prompt "$display_name" "$_cv_ps1_before"

        # Merge CRAY_LD_LIBRARY_PATH and conda env libs into LD_LIBRARY_PATH.
        if [ -n "${CONDA_PREFIX:-}" ] && [ -d "$CONDA_PREFIX/lib" ]; then
            _cv_augment_ld_path "$CONDA_PREFIX/lib"
        else
            _cv_augment_ld_path
        fi

        _cv_conda_patch_deactivate "$display_name" "$target" "$archive_dir" "$link_path" "$archive_name" || return 1
        return 0
        ;;
    deactivate)
        if declare -f deactivate >/dev/null 2>&1 && [ -n "${_CV_ACTIVE_DIR:-}" ]; then
            deactivate
            return $?
        fi
        local _cv_conda_output _cv_conda_rc
        _cv_conda_rc=0
        _cv_conda_output=$("$CV_CONDA" shell.bash deactivate) || _cv_conda_rc=$?
        [ "$_cv_conda_rc" -eq 0 ] || return "$_cv_conda_rc"
        eval "$_cv_conda_output"
        return $?
        ;;
    install|remove|uninstall|update|upgrade)
        local rc
        "$CV_CONDA" "$@"
        rc=$?
        _cv_save_conda_mutation "$_cv_conda_cmd" "$rc" || return $?
        return "$rc"
        ;;
    *)
        "$CV_CONDA" "$@"
        return $?
        ;;
esac
]==], "")


-- uv: bare venv creation.
set_shell_function("_cv_uv_venv", [==[
local requested="$1"
shift
local requested_base requested_path

_cv_require_inactive || return 1
if [ -z "$requested" ]; then
    _cv_log "ERROR: no virtual-environment path specified"
    return 2
fi
requested="${requested%/}"
requested_base=$(_cv_uv_directory "$@") || return 1
case "$requested" in
    /*) requested_path="$requested" ;;
    *) requested_path="$requested_base/$requested" ;;
esac

local venv_name scratch_name archive_name target archive_dir link_path identity source_path
venv_name=$(basename "${requested%/}")
if [ -z "$venv_name" ] || [ "$venv_name" = "." ] || [ "$venv_name" = ".." ]; then
    _cv_log "ERROR: invalid environment path: $requested"
    return 2
fi

archive_dir=$(_cv_archive_dir) || return 1
archive_dir=$(builtin cd "$archive_dir" 2>/dev/null && pwd -P) || {
    _cv_log "ERROR: archive directory does not exist: $archive_dir"
    return 1
}
source_path=$(_cv_canonical_path "$requested_path") || {
    _cv_log "ERROR: cannot resolve environment path: $requested"
    return 1
}
identity=$(_cv_identity path "$source_path") || {
    _cv_log "ERROR: cannot derive environment identity"
    return 1
}
archive_name=$(_cv_archive_name "$identity" "$venv_name")
scratch_name=$(_cv_scratch_key "$identity" "$archive_dir" "$archive_name" "$venv_name")
link_path="$requested_path"
target="${CV_JOB_SCRATCH}/${scratch_name}"

if ! _cv_validate_public_link "$requested_path" "$target" 0; then
    _cv_log "ERROR: path already exists and is not a cvenv symlink: $requested_path"
    return 1
fi

_cv_check_new_archive "$archive_dir" "$archive_name" "$venv_name" "$identity" || return 1
if [ -d "$target" ]; then
    _cv_log "ERROR: environment is already expanded in job scratch: $target"
    return 1
fi
_cv_claim_scratch "$target" "$identity" || return 1
_cv_log "Creating environment in job scratch: $target"
"$CV_UV" venv "$@" "$target" || {
    _cv_log "ERROR: virtual-environment creation failed"
    command rm -rf "$target"
    return 1
}
printf '%s\n' "$target" > "$target/.cvenv-prefix" || {
    command rm -rf "$target"
    return 1
}
_cv_write_archive_name "$target" "$archive_name" || {
    command rm -rf "$target"
    return 1
}
_cv_write_manifest "$target" "$identity" path "$source_path" "$venv_name" "$archive_name" "$scratch_name" || {
    command rm -rf "$target"
    return 1
}

_cv_patch_nccl "$target" ""
mkdir -p "$(dirname "$link_path")" || {
    command rm -rf "$target"
    return 1
}
ln -sfn "$target" "$link_path" || {
    command rm -rf "$target"
    return 1
}
_cv_mark_created "$venv_name" "$archive_name" "$target" "$archive_dir" "$link_path" ""
_cv_compress_venv "$target" "$archive_dir" "" 1 || {
    _cv_log "ERROR: initial archive creation failed; expanded environment was retained"
    return 1
}
unset _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR _CV_EXPANDED_VENV_SUBDIR
_cv_log "Ready: $requested_path -> $target"
_cv_log "Run: source $requested_path/bin/activate"
return 0
]==], "")

-- uv: initialise a project with a .venv in scratch.
set_shell_function("_cv_uv_init", [==[
local requested="$1"
shift
local requested_base requested_path

_cv_require_inactive || return 1
requested_base=$(_cv_uv_directory "$@") || return 1

if [ -z "$requested" ] || [ "$requested" = "." ]; then
    _cv_log "ERROR: uv init requires an explicit project path"
    return 2
else
    requested="${requested%/}"
    case "$requested" in
        /*) requested_path="$requested" ;;
        *) requested_path="$requested_base/$requested" ;;
    esac
fi

local proj_name scratch_name archive_name target archive_dir link_path identity source_path
proj_name=$(_cv_base_name "$requested")
if [ -z "$proj_name" ] || [ "$proj_name" = "." ] || [ "$proj_name" = ".." ]; then
    _cv_log "ERROR: invalid project path: $requested"
    return 2
fi

archive_dir=$(_cv_archive_dir) || return 1
archive_dir=$(builtin cd "$archive_dir" 2>/dev/null && pwd -P) || {
    _cv_log "ERROR: archive directory does not exist: $archive_dir"
    return 1
}
source_path=$(_cv_canonical_path "$requested_path") || {
    _cv_log "ERROR: cannot resolve project path: $requested"
    return 1
}
identity=$(_cv_identity path "$source_path") || {
    _cv_log "ERROR: cannot derive project identity"
    return 1
}
archive_name=$(_cv_archive_name "$identity" "$proj_name")
scratch_name=$(_cv_scratch_key "$identity" "$archive_dir" "$archive_name" "$proj_name")
link_path="$requested_path"
target="${CV_JOB_SCRATCH}/${scratch_name}"

if ! _cv_validate_public_link "$requested_path" "$target" 0; then
    _cv_log "ERROR: path already exists and is not a cvenv symlink: $requested_path"
    return 1
fi

_cv_check_new_archive "$archive_dir" "$archive_name" "$proj_name" "$identity" || return 1
if [ -d "$target" ]; then
    _cv_log "ERROR: project is already expanded in job scratch: $target"
    return 1
fi
_cv_claim_scratch "$target" "$identity" || return 1
_cv_log "Creating uv project in job scratch: $target"
"$CV_UV" init "$@" "$target" || {
    _cv_log "ERROR: uv init failed"
    command rm -rf "$target"
    return 1
}
printf '%s\n' "$target" > "$target/.cvenv-prefix" || {
    command rm -rf "$target"
    return 1
}
_cv_write_archive_name "$target" "$archive_name" || {
    command rm -rf "$target"
    return 1
}
_cv_log "Creating .venv in project: $target/.venv"
( builtin cd "$target" && "$CV_UV" venv .venv ) || {
    _cv_log "ERROR: venv creation failed for uv project"
    command rm -rf "$target"
    return 1
}
_cv_write_manifest "$target" "$identity" path "$source_path" "$proj_name" "$archive_name" "$scratch_name" || {
    command rm -rf "$target"
    return 1
}

_cv_patch_nccl "$target" "/.venv"
mkdir -p "$(dirname "$link_path")" || {
    command rm -rf "$target"
    return 1
}
ln -sfn "$target" "$link_path" || {
    command rm -rf "$target"
    return 1
}
_cv_mark_created "$proj_name" "$archive_name" "$target" "$archive_dir" "$link_path" "/.venv"
_cv_compress_venv "$target" "$archive_dir" "/.venv" 1 || {
    _cv_log "ERROR: initial archive creation failed; expanded environment was retained"
    return 1
}
_cv_log "Ready: $requested_path -> $target"
_cv_log "Run: source $requested_path/.venv/bin/activate"
return 0
]==], "")

set_shell_function("_cv_uv_directory", [==[
local value="$PWD" arg index
local -a args=("$@")
for ((index = 0; index < ${#args[@]}; index++)); do
    arg="${args[index]}"
    case "$arg" in
        --directory=*)
            value="${arg#--directory=}"
            ;;
        --directory)
            if [ "$((index + 1))" -lt "${#args[@]}" ]; then
                value="${args[index + 1]}"
                index=$((index + 1))
            fi
            ;;
        --project=*)
            value="${arg#--project=}"
            ;;
        --project)
            if [ "$((index + 1))" -lt "${#args[@]}" ]; then
                value="${args[index + 1]}"
                index=$((index + 1))
            fi
            ;;
    esac
done
case "$value" in
    /*) ;;
    *) value="$PWD/$value" ;;
esac
_cv_canonical_path "$value"
]==], "")

set_shell_function("_cv_uv_auto_activate", [==[
# Auto-activate a cvenv-managed .venv found by walking up from $PWD.
{ [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; } && return 0

local search_dir
local venv_dir=""
search_dir=$(_cv_uv_directory "$@") || return 0
if [ -f "$search_dir/bin/activate" ]; then
    venv_dir="$search_dir"
else
    while [ "$search_dir" != "/" ]; do
        if [ -f "$search_dir/.venv/bin/activate" ]; then
            venv_dir="$search_dir/.venv"
            break
        fi
        search_dir=$(dirname "$search_dir")
    done
fi
[ -n "$venv_dir" ] || return 0

# If activate file is a cvenv stub, venv was archived; use source wrapper to extract and activate.
if grep -q 'CVENV_STUB' "$venv_dir/bin/activate" 2>/dev/null; then
    source "$venv_dir/bin/activate" || return 1
    if [ -n "${VIRTUAL_ENV:-}" ]; then
        _CV_AUTO_ACTIVATED=1
        export _CV_AUTO_ACTIVATED
    fi
    # Source wrapper handled everything (extract, activate, patch).
    return 0
fi

local target="" job_scratch="" venv_parent=""
venv_parent=$(dirname "$venv_dir")
if [ -L "$venv_dir" ] || [ -L "$venv_parent" ]; then
    target=$(readlink -f "$venv_dir" 2>/dev/null) || target=""
fi
# Only activate cvenv-managed venvs (symlink into job scratch).
[ -n "$target" ] || return 0
job_scratch=$(readlink -f "$CV_JOB_SCRATCH" 2>/dev/null) || job_scratch="$CV_JOB_SCRATCH"
case "$target" in
    "${job_scratch}"/*|"${CV_JOB_SCRATCH}"/*) ;;
    *) return 0 ;;
esac

local venv_name archive_name archive_dir link_path venv_subdir _cv_ps1_before
archive_dir=$(_cv_archive_dir) || return 0
archive_dir=$(builtin cd "$archive_dir" 2>/dev/null && pwd -P) || return 0

local _cv_manifest
_cv_manifest=$(cat "$target/.cvenv-manifest" 2>/dev/null) || _cv_manifest=""
venv_name=$(_cv_manifest_field "$_cv_manifest" display_name) || venv_name=$(basename "$target")

if [ "$(basename "$target")" = ".venv" ]; then
    venv_subdir="/.venv"
    target=$(dirname "$target")
    link_path=$(dirname "$venv_dir")
    _cv_manifest=$(cat "$target/.cvenv-manifest" 2>/dev/null) || _cv_manifest=""
    venv_name=$(_cv_manifest_field "$_cv_manifest" display_name) || venv_name=$(basename "$target")
else
    venv_subdir=""
    link_path="$venv_dir"
fi

_cv_ps1_before="${PS1:-}"
archive_name=$(cat "$target/.cvenv-archive-name" 2>/dev/null || printf '%s' "$venv_name")
archive_name=$(_cv_validate_component "$archive_name") || return 1

_cv_read_scratch_identity "$target" >/dev/null || {
    _cv_log "ERROR: scratch manifest is invalid: $target"
    return 1
}
_cv_augment_ld_path
builtin source "$venv_dir/bin/activate" || return 1
_cv_restore_env_vars "$target" "$venv_subdir" || {
    _cv_log "ERROR: invalid environment variable snapshot"
    return 1
}
_cv_set_prompt "$venv_name" "$_cv_ps1_before"

if [ "${VIRTUAL_ENV:-}" = "${target}${venv_subdir}" ]; then
    _cv_patch_deactivate "$venv_name" "$target" "$archive_dir" "$link_path" "$venv_subdir" "$archive_name" || return 1
    unset _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR _CV_EXPANDED_VENV_SUBDIR
    # Mark as auto-activated so cd auto-deactivates on leave.
    _CV_AUTO_ACTIVATED=1
    export _CV_AUTO_ACTIVATED
    _cv_log "Auto-activated $venv_dir for uv"
fi
return 0
]==], "")

set_shell_function("_cv_uv_discover_expand", [==[
# Walk up to find and expand a .venv archive so uv's own discovery finds it.
{ [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; } && return 0

local search_dir link_target tarball
local source_path identity archive_name scratch_key target tarball_dir
search_dir=$(_cv_uv_directory "$@") || return 0
while [ "$search_dir" != "/" ]; do
    if [ -e "$search_dir/.venv" ]; then
        if [ -L "$search_dir/.venv" ]; then
            link_target=$(readlink -f "$search_dir/.venv" 2>/dev/null) || link_target=""
            if [ -n "$link_target" ] && [ -d "$link_target" ]; then
                return 0
            fi
        elif ! grep -q 'CVENV_STUB' "$search_dir/.venv/bin/activate" 2>/dev/null; then
            return 0
        fi
    fi
    if [ -n "${CV_ARCHIVE_DIR:-}" ]; then
        tarball_dir=$(builtin cd "$CV_ARCHIVE_DIR" 2>/dev/null && pwd -P) || return 0
    else
        tarball_dir="$search_dir"
    fi
    source_path=$(_cv_canonical_path "$search_dir/.venv") || return 0
    identity=$(_cv_identity path "$source_path") || return 0
    archive_name=$(_cv_archive_name "$identity" ".venv")
    scratch_key=$(_cv_scratch_key "$identity" "$tarball_dir" "$archive_name" ".venv")
    target="${CV_JOB_SCRATCH}/${scratch_key}"
    tarball=$(_cv_find_archive "$tarball_dir" "$archive_name") || tarball=""
    if [ -z "$tarball" ]; then
        tarball=$(_cv_find_identity_archive "$tarball_dir" ".venv" "$identity") || tarball=""
    fi
    if [ -n "$tarball" ]; then
        if ! _cv_validate_public_link "$search_dir/.venv" "$target" 1; then
            return 0
        fi
        _cv_decompress_venv "$archive_name" "$tarball_dir" "$scratch_key" "$identity" path "$source_path" ".venv" || return 1
        if [ -d "$search_dir/.venv" ] && [ ! -L "$search_dir/.venv" ]; then
            command rm -rf "$search_dir/.venv"
        fi
        ln -sfn "$target" "$search_dir/.venv" || return 1
        _CV_EXPANDED_LINK="$search_dir/.venv"
        _CV_EXPANDED_DIR="$target"
        _CV_EXPANDED_ARCHIVE_DIR="$tarball_dir"
        _CV_EXPANDED_VENV_SUBDIR=""
        export _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR _CV_EXPANDED_VENV_SUBDIR
        return 0
    fi
    search_dir=$(dirname "$search_dir")
done
return 0
]==], "")

set_shell_function("_cv_uv_run_expand", [==[
# Expand a uv-init project archive so uv run can use the scratch venv.
{ [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; } && return 0

local run_dir replace_project=0 is_project=0 is_stub=0
run_dir=$(_cv_uv_directory "$@") || return 0
while [ "$run_dir" != "/" ]; do
    if [ -f "$run_dir/pyproject.toml" ]; then
        is_project=1
        break
    fi
    if [ -f "$run_dir/.venv/bin/activate" ] && \
       grep -q 'CVENV_STUB' "$run_dir/.venv/bin/activate" 2>/dev/null; then
        is_stub=1
        break
    fi
    run_dir=$(dirname "$run_dir")
done
[ "$is_project" = "1" ] || [ "$is_stub" = "1" ] || return 0

local proj_name archive_name archive_dir target source_path identity scratch_key
proj_name=$(basename "$run_dir")
if [ -n "${CV_ARCHIVE_DIR:-}" ]; then
    archive_dir=$(builtin cd "$CV_ARCHIVE_DIR" 2>/dev/null && pwd -P) || return 0
else
    archive_dir="$run_dir"
fi
source_path=$(_cv_canonical_path "$run_dir") || return 0
identity=$(_cv_identity path "$source_path") || return 0
archive_name=$(_cv_archive_name "$identity" "$proj_name")
scratch_key=$(_cv_scratch_key "$identity" "$archive_dir" "$archive_name" "$proj_name")
target="${CV_JOB_SCRATCH}/${scratch_key}"

# Venv already reachable
if [ -d "$run_dir/.venv" ]; then
    if [ -L "$run_dir/.venv" ] || \
       ! grep -q 'CVENV_STUB' "$run_dir/.venv/bin/activate" 2>/dev/null; then
        return 0
    fi
    [ -f "$run_dir/pyproject.toml" ] || replace_project=1
fi

# Extract the project and link its .venv back into the original project directory.
if _cv_find_archive "$archive_dir" "$archive_name" >/dev/null 2>&1 || \
   _cv_find_archive "$archive_dir" "$proj_name" >/dev/null 2>&1; then
    _cv_decompress_venv "$archive_name" "$archive_dir" "$scratch_key" "$identity" path "$source_path" "$proj_name" || return 1
    if [ "$replace_project" = "1" ] && [ -d "$run_dir" ] && [ ! -L "$run_dir" ]; then
        local unexpected
        unexpected=$(find "$run_dir" -mindepth 1 -maxdepth 1 ! -name .venv -print -quit 2>/dev/null)
        if [ -n "$unexpected" ]; then
            _cv_log "ERROR: refusing to replace uv project stub with unexpected files: $run_dir"
            return 1
        fi
        command rm -rf "$run_dir"
        ln -sfn "$target" "$run_dir" || return 1
        _CV_EXPANDED_LINK="$run_dir"
    else
        if ! _cv_validate_public_link "$run_dir/.venv" "$target/.venv" 1; then
            _cv_log "ERROR: refusing to replace unexpected .venv path: $run_dir/.venv"
            return 1
        fi
        if [ -d "$run_dir/.venv" ] && [ ! -L "$run_dir/.venv" ]; then
            command rm -rf "$run_dir/.venv"
        fi
        ln -sfn "$target/.venv" "$run_dir/.venv" || return 1
        _CV_EXPANDED_LINK="$run_dir/.venv"
    fi
    _CV_EXPANDED_DIR="$target"
    _CV_EXPANDED_ARCHIVE_DIR="$archive_dir"
    _CV_EXPANDED_VENV_SUBDIR="/.venv"
    export _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR _CV_EXPANDED_VENV_SUBDIR
fi
return 0
]==], "")

set_shell_function("_cv_uv_pip_action", [==[
local index=2 next_index argument
while [ "$index" -le "$#" ]; do
    argument="${@:index:1}"
    case "$argument" in
        install|uninstall)
            printf '%s\n' "$argument"
            return 0
            ;;
        --cert|--cache-dir|--color|--allow-insecure-host|--directory|--project|--config-file|\
        --keyring-provider|--link-mode|--python|--python-preference|--index|--default-index|\
        --extra-index-url|--find-links|--index-strategy|--exclude-newer|\
        --exclude-newer-package|--refresh-package)
            next_index=$((index + 1))
            if [ "$next_index" -le "$#" ]; then
                index=$((next_index + 1))
            else
                index="$next_index"
            fi
            ;;
        -*) index=$((index + 1)) ;;
        *)
            printf '%s\n' "$argument"
            return 0
            ;;
    esac
done
return 1
]==], "")

-- uv: main wrapper.
set_shell_function("uv", [==[
# The Lua module normally sets UV_CACHE_DIR to CV_JOB_CACHE at load time.
# Keep the cache contract consistent when CV_JOB_CACHE changes after load.
_cv_apply_job_cache || return 1
if [ -z "${UV_CACHE_DIR:-}" ]; then
    export UV_CACHE_DIR="${CV_JOB_CACHE:-${CV_JOB_SCRATCH}/uv-cache}"
fi
mkdir -p "$UV_CACHE_DIR" || {
    _cv_log "ERROR: cannot create uv cache directory: $UV_CACHE_DIR"
    return 1
}

# Locate uv if not detected at module load time.
if [ -z "${CV_UV:-}" ]; then
    CV_UV=$(type -P uv 2>/dev/null)
    if [ -z "$CV_UV" ]; then
        _cv_log "ERROR: uv is not available"
        return 127
    fi
fi

local _cv_uv_cmd="${1:-}" _cv_uv_arg _cv_uv_option

for _cv_uv_arg in "$@"; do
    case "$_cv_uv_arg" in
        -h|--help)
            "$CV_UV" "$@"
            return $?
            ;;
    esac
done

# Reject mutating forms the pip action parser cannot auto-activate and save.
if [ "$_cv_uv_cmd" = "pip" ] && [[ "${2:-}" == -* ]]; then
    local _cv_uv_action
    _cv_uv_action=$(_cv_uv_pip_action "$@") || _cv_uv_action=""
    if [ -z "$_cv_uv_action" ]; then
        _cv_log "ERROR: unsupported uv pip options before the action"
        return 2
    fi
    case "$_cv_uv_action" in
        install|uninstall)
            _cv_log "ERROR: put uv pip options after $_cv_uv_action"
            return 2
            ;;
        compile|sync|freeze|list|show|tree|check) ;;
        *)
            _cv_log "ERROR: unsupported uv pip action or options: $_cv_uv_action"
            return 2
            ;;
    esac
fi

# Reject forms the auto-activation and mutation hooks cannot parse.
if [ "${1:-}" = "-" ] || [[ "${1:-}" == -* ]]; then
    for _cv_uv_arg in "${@:2}"; do
        case "$_cv_uv_arg" in
            pip|add|remove|sync|run)
                _cv_log "ERROR: put uv global options after the managed subcommand"
                return 2
                ;;
        esac
    done
fi

# Only venv-consuming subcommands get auto-expansion; others pass through.
case "$_cv_uv_cmd" in
    pip|add|remove|sync|run|tree|tool|export|lock|python|x|venv|init) ;;
    *)
        "$CV_UV" "$@"
        return $?
        ;;
esac

# Auto-expand a .venv archive in $PWD if no venv (or conda env) is active.
if [ -z "${VIRTUAL_ENV:-}" ] && [ -z "${CONDA_PREFIX:-}" ] && [ "$_cv_uv_cmd" != "venv" ] && [ "$_cv_uv_cmd" != "init" ]; then
    local _cv_uv_dir
    _cv_uv_dir=$(_cv_uv_directory "$@") || _cv_uv_dir="$PWD"
    # Clean up stale expansion if symlink gone, but never remove dir $PWD/.venv points to.
    if [ -n "${_CV_EXPANDED_LINK:-}" ] && [ ! -e "$_CV_EXPANDED_LINK" ]; then
        local _cv_pwd_target=""
        [ -L "$_cv_uv_dir/.venv" ] && _cv_pwd_target=$(readlink -f "$_cv_uv_dir/.venv" 2>/dev/null) || true
        if [ -z "$_cv_pwd_target" ] || [ "$_cv_pwd_target" != "$_CV_EXPANDED_DIR" ]; then
            command rm -rf "$_CV_EXPANDED_DIR"
        fi
        unset _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR _CV_EXPANDED_VENV_SUBDIR
    fi
    _cv_uv_discover_expand "$@" || return 1
    _cv_uv_run_expand "$@" || return 1
fi

# Auto-activate a local .venv for mutating uv commands and uv run.
if [ -z "${VIRTUAL_ENV:-}" ] && [ -z "${CONDA_PREFIX:-}" ]; then
    local _cv_auto_deactivate=0
    case "$_cv_uv_cmd" in
        pip)
            local _cv_uv_subcmd="${2:-}"
            case "$_cv_uv_subcmd" in
            install|uninstall) _cv_uv_auto_activate "$@" || return 1 ;;
            esac
            ;;
        add|remove|sync) _cv_uv_auto_activate "$@" || return 1 ;;
        run)
            _cv_uv_auto_activate "$@" || return 1
            if [ -n "${VIRTUAL_ENV:-}" ]; then
                _CV_AUTO_ACTIVATED=1
                export _CV_AUTO_ACTIVATED
            fi
            ;;
    esac
    # Mark for auto-deactivation after the command if we auto-activated.
    if [ -n "${_CV_AUTO_ACTIVATED:-}" ] && [ -n "${VIRTUAL_ENV:-}" ]; then
        _cv_auto_deactivate=1
    fi
fi

# uv venv <path> -> create a bare venv in scratch.
if [ "$_cv_uv_cmd" = "venv" ]; then
    shift
    local requested=""
    local -a passthrough=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --seed)
                passthrough+=("$1")
                if [ "$#" -gt 1 ] && [[ "$2" != -* ]]; then
                    shift
                    passthrough+=("$1")
                fi
                ;;
            --color|--python|--python-preference|--prompt|--directory|--project)
                _cv_uv_option="$1"
                shift
                [ "$#" -gt 0 ] || { _cv_log "ERROR: $_cv_uv_option requires a value"; return 2; }
                passthrough+=("$_cv_uv_option" "$1")
                ;;
            --link-mode|--cache-dir|--config-file|--index|--default-index|--extra-index-url|--find-links|--index-strategy|--exclude-newer|--exclude-newer-package|--refresh-package|--keyring-provider|--allow-insecure-host)
                _cv_uv_option="$1"
                shift
                [ "$#" -gt 0 ] || { _cv_log "ERROR: $_cv_uv_option requires a value"; return 2; }
                passthrough+=("$_cv_uv_option" "$1")
                ;;
            -p)
                _cv_uv_option="$1"
                shift
                [ "$#" -gt 0 ] || { _cv_log "ERROR: $_cv_uv_option requires a value"; return 2; }
                passthrough+=("$_cv_uv_option" "$1")
                ;;
            --*=*|-*)
                passthrough+=("$1")
                ;;
            *)
                if [ -z "$requested" ]; then
                    requested="$1"
                else
                    passthrough+=("$1")
                fi
                ;;
        esac
        shift
    done
    [ -n "$requested" ] || requested=".venv"
    if [ "${#passthrough[@]}" -gt 0 ]; then
        _cv_uv_venv "$requested" "${passthrough[@]}"
    else
        _cv_uv_venv "$requested"
    fi
    return $?
fi

# uv init <path> -> create a project (with .venv) in scratch.
if [ "$_cv_uv_cmd" = "init" ]; then
    shift
    local requested=""
    local -a passthrough=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
                --color|--name|--python|--python-preference|--build-backend|--vcs|--directory|--project|--description|--author-from|--cache-dir|--config-file|--allow-insecure-host)
                _cv_uv_option="$1"
                shift
                [ "$#" -gt 0 ] || { _cv_log "ERROR: $_cv_uv_option requires a value"; return 2; }
                passthrough+=("$_cv_uv_option" "$1")
                ;;
            --*=*|-*)
                passthrough+=("$1")
                ;;
            *)
                if [ -z "$requested" ]; then
                    requested="$1"
                else
                    passthrough+=("$1")
                fi
                ;;
        esac
        shift
    done
    [ -n "$requested" ] || requested="."
    if [ "${#passthrough[@]}" -gt 0 ]; then
        _cv_uv_init "$requested" "${passthrough[@]}"
    else
        _cv_uv_init "$requested"
    fi
    return $?
fi

# Pass through to real uv.
local rc
"$CV_UV" "$@"
rc=$?

if [ "$rc" -eq 0 ] && [ -n "${_CV_ACTIVE_DIR:-}" ]; then
    if [ "${VIRTUAL_ENV:-}" = "${_CV_ACTIVE_DIR}${_CV_ACTIVE_VENV_SUBDIR:-}" ]; then
        local _cv_save=0
        case "$_cv_uv_cmd" in
            pip)
                case "${2:-}" in
                    install|uninstall) _cv_save=1 ;;
                esac
                ;;
            add|remove|sync|run) _cv_save=1 ;;
        esac
        if [ "$_cv_save" -eq 1 ]; then
            _cv_patch_nccl "$_CV_ACTIVE_DIR" "${_CV_ACTIVE_VENV_SUBDIR:-}"
            _cv_log "Saving environment changes after uv $_cv_uv_cmd ${2:-}"
            _cv_compress_venv "$_CV_ACTIVE_DIR" "$_CV_ACTIVE_ARCHIVE_DIR" "${_CV_ACTIVE_VENV_SUBDIR:-}" || return $?
            _cv_propagate_nodes "$_CV_ACTIVE_ARCHIVE_NAME" "$_CV_ACTIVE_ARCHIVE_DIR" "${_CV_ACTIVE_VENV_SUBDIR:-}" 1 "${_CV_ACTIVE_DIR##*/}" "$(_cv_read_scratch_identity "$_CV_ACTIVE_DIR")"
        fi
    fi
fi

# Auto-deactivate if we auto-activated for this command (success only).
if [ "$rc" -eq 0 ] && [ "${_cv_auto_deactivate:-0}" = "1" ] && [ -n "${VIRTUAL_ENV:-}" ]; then
    _cv_log "uv $_cv_uv_cmd finished; auto-deactivating ${_CV_ACTIVE_NAME:-venv}"
    if [ -z "${CVENV_RO+x}" ]; then
        CVENV_RO=1
        _CV_RO_AUTO=1
        export CVENV_RO _CV_RO_AUTO
    fi
    deactivate || {
        _cv_log "ERROR: auto-deactivation failed after uv $_cv_uv_cmd"
        return 1
    }
fi
return "$rc"
]==], "")

set_shell_function("_cv_directory_changed", [==[
if [ -n "${_CV_EXPANDED_LINK:-}" ]; then
    local _cv_exp_root
    _cv_exp_root=$(dirname "$_CV_EXPANDED_LINK")
    case "$PWD" in
        "$_cv_exp_root"|"$_cv_exp_root"/*) ;;
        *)
        if [ -d "$_CV_EXPANDED_DIR" ]; then
            _cv_log "Left $_cv_exp_root; archiving expanded .venv"
            _cv_compress_venv "$_CV_EXPANDED_DIR" "$_CV_EXPANDED_ARCHIVE_DIR" "${_CV_EXPANDED_VENV_SUBDIR:-}" || {
                _cv_log "ERROR: compression failed; changes preserved in $_CV_EXPANDED_DIR"
                return 1
            }
            local _cv_manifest _cv_identity _cv_archive_name _cv_source_kind _cv_source_path
            local _cv_stub_link _cv_stub_subdir _cv_relink_target
            _cv_manifest=$(_cv_read_scratch_manifest "$_CV_EXPANDED_DIR") || {
                _cv_log "ERROR: scratch manifest is invalid: $_CV_EXPANDED_DIR"
                return 1
            }
            _cv_identity=$(_cv_manifest_field "$_cv_manifest" identity)
            _cv_archive_name=$(_cv_manifest_field "$_cv_manifest" archive_name)
            _cv_archive_name=$(_cv_validate_component "$_cv_archive_name") || return 1
            _cv_source_kind=$(_cv_manifest_field "$_cv_manifest" source_kind)
            _cv_source_path=$(_cv_manifest_field "$_cv_manifest" source_path) || _cv_source_path=""
            _cv_stub_link="$_CV_EXPANDED_LINK"
            _cv_stub_subdir="${_CV_EXPANDED_VENV_SUBDIR:-}"
            _cv_relink_target="$_CV_EXPANDED_DIR"
            if [ "$_cv_stub_subdir" = "/.venv" ] && \
               [ "$(basename "$_cv_stub_link")" = ".venv" ]; then
                _cv_stub_link=$(dirname "$_cv_stub_link")
                _cv_relink_target="${_CV_EXPANDED_DIR}/.venv"
            fi
            [ -L "$_CV_EXPANDED_LINK" ] && command rm -f "$_CV_EXPANDED_LINK"
            if ! _cv_write_dummy_activate "$_cv_archive_name" "$_CV_EXPANDED_ARCHIVE_DIR" "$_cv_stub_link" "$_cv_stub_subdir" "$_cv_identity" "$(basename "$_CV_EXPANDED_DIR")" "$_cv_source_kind" "$_cv_source_path"; then
                ln -sfn "$_cv_relink_target" "$_CV_EXPANDED_LINK" || return 1
                return 1
            fi
            command rm -rf "$_CV_EXPANDED_DIR" 2>/dev/null || \
                _cv_log "WARNING: could not remove expanded scratch copy: $_CV_EXPANDED_DIR"
        else
            _cv_log "Left $_cv_exp_root; scratch venv already removed"
        fi
        [ -L "$_CV_EXPANDED_LINK" ] && command rm -f "$_CV_EXPANDED_LINK"
        _cv_scratch_cleanup
        unset _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR _CV_EXPANDED_VENV_SUBDIR
        ;;
    esac
fi
if [ -n "${_CV_ACTIVE_LINK:-}" ] && \
   { [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; }; then
    local _cv_venv_root
    _cv_venv_root=$(dirname "$_CV_ACTIVE_LINK")
    case "$PWD" in
        "$_cv_venv_root"|"$_cv_venv_root"/*) ;;
        *)
            _cv_log "Left $_cv_venv_root; auto-deactivating ${_CV_ACTIVE_NAME}"
            deactivate || {
                _cv_log "ERROR: auto-deactivation failed"
                return 1
            }
            ;;
    esac
fi
return 0
]==], "")

-- cd/pushd/popd: auto-deactivate when leaving the venv directory.
set_shell_function("cd", [==[
builtin cd "$@" || return $?
_cv_directory_changed
]==], "")

set_shell_function("pushd", [==[
builtin pushd "$@" || return $?
_cv_directory_changed
]==], "")

set_shell_function("popd", [==[
builtin popd "$@" || return $?
_cv_directory_changed
]==], "")


set_shell_function("_cv_propagate_nodes", [==[
# Extract venv archive on every node in the Slurm allocation so plain "srun <cmd>" works everywhere.
local archive_name="$1"
local archive_dir="$2"
local venv_subdir="${3:-}"
local force="${4:-0}"
local scratch_name="${5:-}"
local identity="${6:-}"

archive_name=$(_cv_validate_component "$archive_name") || return 1
scratch_name=$(_cv_validate_component "$scratch_name") || return 1
identity=$(_cv_validate_identity "$identity") || return 1
case "$venv_subdir" in ""|"/.venv") ;; *) return 1 ;; esac
case "$force" in 0|1) ;; *) return 1 ;; esac

[ "${CV_MULTI_NODE:-0}" = "1" ] || return 0
[ "${CV_IS_WRITER:-1}" = "1" ] || return 0
[ -n "${SLURM_JOB_ID:-}" ] || return 0
command -v srun >/dev/null 2>&1 || return 0

local tarball backend_ext backend_kind backend_decompress compress_cpus num_nodes skip_node0=0
compress_cpus=$(_cv_positive_integer "${CV_COMPRESS_CPUS:-1}") || {
    _cv_log "ERROR: CV_COMPRESS_CPUS must be a positive integer"
    return 1
}
num_nodes=$(_cv_positive_integer "${SLURM_JOB_NUM_NODES:-${SLURM_NNODES:-1}}") || {
    _cv_log "ERROR: Slurm node count must be a positive integer"
    return 1
}
tarball=$(_cv_exact_archive "$archive_dir" "$archive_name") || {
    _cv_log "ERROR: archive not found for propagation: $archive_name"
    return 1
}
case "$tarball" in
    *.tar.zst)
        [ -n "${CV_PZSTD:-}" ] || {
            _cv_log "ERROR: pzstd is required to propagate $archive_name"
            return 1
        }
        backend_ext=".tar.zst"
        backend_kind="zstd"
        backend_decompress="$CV_PZSTD"
        ;;
    *.tar.gz)
        backend_ext=".tar.gz"
        backend_kind="gzip"
        backend_decompress="gzip"
        ;;
    *)
        _cv_log "ERROR: unsupported archive format: $tarball"
        return 2
        ;;
esac
if [ "$force" = "1" ] && [ "${CV_IS_WRITER:-1}" = "1" ] && [ "${SLURM_NODEID:-}" = "0" ]; then
    skip_node0=1
fi

if [ "$force" = "1" ]; then
    _cv_log "Re-propagating ${archive_name} (${scratch_name}) to all nodes (force) via srun ..."
else
    _cv_log "Propagating ${archive_name} (${scratch_name}) to all nodes via srun ..."
fi

# Build the script on the shared archive filesystem so every allocated node can
# execute the same path. CV_JOB_SCRATCH may be node-local and is unsuitable here.
local _cv_prop_script _cv_write_rc _cv_prop_rc
_cv_prop_script=$(mktemp "${archive_dir}/.cvenv-propagate.XXXXXX.sh" 2>/dev/null) || {
    _cv_log "ERROR: cannot create propagation script in shared archive directory: $archive_dir"
    return 1
}
cat > "$_cv_prop_script" <<'PROPSCRIPT'
#!/bin/bash
set -uo pipefail

archive_name="$1"
archive_dir="$2"
venv_subdir="$3"
backend_ext="$4"
backend_kind="$5"
backend_decompress="$6"
compress_cpus="$7"
job_scratch="$8"
scratch_name="$9"
force="${10}"
identity="${11}"
skip_node0="${12}"

tarball="${archive_dir}/${archive_name}${backend_ext}"
target="${job_scratch}/${scratch_name}"
activate="${target}${venv_subdir}/bin/activate"
conda_bin="${target}${venv_subdir}/bin/conda"
created=0

cleanup_created() {
    local rc=$?
    if [ "$rc" -ne 0 ] && [ "$created" = "1" ]; then
        rm -rf -- "$target" || \
            echo "[cvenv] ERROR: could not remove incomplete scratch copy: $target" >&2
    fi
    return "$rc"
}
trap cleanup_created EXIT

# Skip node 0 only when the writer is node 0 and its live scratch must not be removed.
if [ "$skip_node0" = "1" ] && [ -n "${SLURM_NODEID:-}" ] && [ "$SLURM_NODEID" = "0" ]; then
    exit 0
fi

[ -f "$tarball" ] || { echo "[cvenv] ERROR: archive not found: $tarball" >&2; exit 1; }

# Already present on this node?
if [ -e "$target" ] || [ -L "$target" ]; then
    existing_identity=""
    if [ -f "$target/.cvenv-manifest" ]; then
        existing_identity=$(sed -n 's/^identity=//p' "$target/.cvenv-manifest" | head -1)
    fi
    [[ "$existing_identity" =~ ^[[:xdigit:]]{64}$ ]] || {
        echo "[cvenv] ERROR: scratch manifest is missing or invalid: $target" >&2
        exit 1
    }
    [ "$existing_identity" = "$identity" ] || {
        echo "[cvenv] ERROR: scratch path belongs to another environment: $target" >&2
        exit 1
    }
    if [ "$force" != "1" ] && { [ -f "$activate" ] || [ -f "$conda_bin" ] || [ -f "$target/bin/python" ]; }; then
        exit 0
    fi
    rm -rf -- "$target" || {
        echo "[cvenv] ERROR: cannot replace $target" >&2
        exit 1
    }
fi

mkdir -p "$job_scratch" || { echo "[cvenv] ERROR: cannot create $job_scratch" >&2; exit 1; }

created=1
set -o pipefail
case "$backend_kind" in
    zstd) "$backend_decompress" --quiet -p "$compress_cpus" -dc -- "$tarball" | tar -xf - -C "$job_scratch" ;;
    gzip) "$backend_decompress" -dc -- "$tarball" | tar -xf - -C "$job_scratch" ;;
    *) echo "[cvenv] ERROR: unsupported archive format: $tarball" >&2; exit 2 ;;
esac
rc=$?
set +o pipefail
[ "$rc" -eq 0 ] || { echo "[cvenv] ERROR: extraction failed on $(hostname 2>/dev/null || echo unknown)" >&2; exit "$rc"; }

[ -d "$target" ] || { echo "[cvenv] ERROR: archive did not contain $scratch_name" >&2; exit 1; }

# Relocate prefix if the archive was created in a different /tmp path.
marker="${target}/.cvenv-prefix"
if [ -f "$marker" ]; then
    old_prefix=$(cat "$marker")
    if [ -n "$old_prefix" ] && [ "$old_prefix" != "/" ] && [ "$old_prefix" != "$target" ]; then
        reloc_python="${CV_ORIGINAL_PYTHON3:-${CV_ORIGINAL_PYTHON:-python3}}"
        command -v "$reloc_python" >/dev/null 2>&1 || {
            echo "[cvenv] ERROR: relocation interpreter is unavailable: $reloc_python" >&2
            exit 1
        }
        while IFS= read -r file; do
            chmod u+w "$file" 2>/dev/null || true
            OLD_PREFIX="$old_prefix" NEW_PREFIX="$target" \
                "$reloc_python" -c 'import os,pathlib,sys;p=pathlib.Path(sys.argv[1]);d=p.read_bytes();o=os.environ["OLD_PREFIX"].encode();n=os.environ["NEW_PREFIX"].encode();p.write_bytes(d.replace(o,n)) if o in d else None' \
                "$file" || {
                    echo "[cvenv] ERROR: failed to relocate file: $file" >&2
                    exit 1
                }
        done < <(grep -IlrF -- "$old_prefix" "$target" 2>/dev/null || true)
        printf '%s\n' "$target" > "$marker" || exit 1
    fi
fi

echo "[cvenv] ${scratch_name} ready on $(hostname 2>/dev/null || echo unknown)"
PROPSCRIPT
_cv_write_rc=$?
if [ "$_cv_write_rc" -ne 0 ]; then
    command rm -f -- "$_cv_prop_script"
    _cv_log "ERROR: cannot write propagation script: $_cv_prop_script"
    return 1
fi
chmod 700 "$_cv_prop_script" 2>/dev/null || {
    command rm -f -- "$_cv_prop_script"
    _cv_log "ERROR: cannot make propagation script executable: $_cv_prop_script"
    return 1
}

(
    trap 'command rm -f -- "$_cv_prop_script"' EXIT
    srun --export=ALL --ntasks="$num_nodes" --ntasks-per-node=1 \
        "$_cv_prop_script" \
        "$archive_name" "$archive_dir" "$venv_subdir" \
        "$backend_ext" "$backend_kind" "$backend_decompress" "$compress_cpus" \
        "$CV_JOB_SCRATCH" "$scratch_name" "$force" "$identity" "$skip_node0"
)
_cv_prop_rc=$?

if [ "$_cv_prop_rc" -ne 0 ]; then
    _cv_log "WARNING: propagation to some nodes failed (rc=$_cv_prop_rc); plain 'srun' may not work on all nodes"
    return 0
fi

_cv_log "Propagation complete; plain 'srun' commands should now work"
]==], "")

set_shell_function("source", [==[
if [ "$#" -ge 1 ] && [[ "$1" == */bin/activate ]]; then
    local activate_path="$1"
    local requested_dir venv_name display_name archive_name archive_dir target link_path tarball rc venv_subdir
    local source_archive_dir
    local _cv_ps1_before
    local identity scratch_key source_path source_kind
    local portable_tarball portable_manifest portable_rc selected_tarball selector
    local _cv_is_stub=0 _cv_stub_archive_name="" _cv_stub_identity="" _cv_stub_scratch_key=""
    local _cv_stub_source_kind="" _cv_stub_source_path=""
    local _cv_job_scratch=""
    requested_dir="${activate_path%/bin/activate}"
    [ -n "$requested_dir" ] || requested_dir="."
    venv_subdir=""
    archive_dir=$(_cv_archive_dir) || return 1
    archive_dir=$(builtin cd "$archive_dir" 2>/dev/null && pwd -P) || return 1
    source_archive_dir=$(builtin cd "$(dirname "$requested_dir")" 2>/dev/null && pwd -P) || source_archive_dir=""
    if [ -f "$activate_path" ] && grep -q 'CVENV_STUB' "$activate_path" 2>/dev/null; then
        _cv_is_stub=1
        _cv_stub_archive_name=$(sed -n 's/^# CVENV_ARCHIVE_NAME=//p' "$activate_path" | head -1)
        _cv_stub_identity=$(sed -n 's/^# CVENV_IDENTITY=//p' "$activate_path" | head -1)
        _cv_stub_scratch_key=$(sed -n 's/^# CVENV_SCRATCH_KEY=//p' "$activate_path" | head -1)
        _cv_stub_source_kind=$(sed -n 's/^# CVENV_SOURCE_KIND=//p' "$activate_path" | head -1)
        _cv_stub_source_path=$(sed -n 's/^# CVENV_SOURCE_PATH=//p' "$activate_path" | head -1)
    fi
    if [ "$_cv_is_stub" = "0" ] && [ -e "$activate_path" ]; then
        local _cv_source_target=""
        _cv_source_target=$(readlink -f "$requested_dir" 2>/dev/null) || _cv_source_target=""
        local _cv_source_is_cvenv=0
        if [ -n "$_cv_source_target" ]; then
            if [ -f "$_cv_source_target/.cvenv-manifest" ] || \
               [ -f "$_cv_source_target/.cvenv-archive-name" ]; then
                _cv_source_is_cvenv=1
            elif [ "$(basename "$_cv_source_target")" = ".venv" ] && \
                 { [ -f "${_cv_source_target%/.venv}/.cvenv-manifest" ] || \
                   [ -f "${_cv_source_target%/.venv}/.cvenv-archive-name" ]; }; then
                _cv_source_is_cvenv=1
            fi
        fi
        if [ -z "${CV_JOB_SCRATCH:-}" ]; then
            _cv_source_ordinary "$@"
            return $?
        fi
        _cv_job_scratch=$(readlink -f "$CV_JOB_SCRATCH" 2>/dev/null) || _cv_job_scratch="$CV_JOB_SCRATCH"
        case "$_cv_source_target" in
            "${_cv_job_scratch}"/*|"${CV_JOB_SCRATCH}"/*)
                if [ "$_cv_source_is_cvenv" = "0" ]; then
                    _cv_source_ordinary "$@"
                    return $?
                fi
                ;;
            *)
                _cv_source_ordinary "$@"
                return $?
                ;;
        esac
    fi
    if [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; then
        _cv_log "ERROR: deactivate the active environment before activating another"
        return 1
    fi
    [ -z "$_cv_stub_archive_name" ] || _cv_stub_archive_name=$(_cv_validate_component "$_cv_stub_archive_name") || return 1
    [ -z "$_cv_stub_identity" ] || _cv_stub_identity=$(_cv_validate_identity "$_cv_stub_identity") || return 1
    [ -z "$_cv_stub_scratch_key" ] || _cv_stub_scratch_key=$(_cv_validate_component "$_cv_stub_scratch_key") || return 1
    [ -z "$_cv_stub_source_kind" ] || _cv_stub_source_kind=$(_cv_validate_source_kind "$_cv_stub_source_kind") || return 1
    [ -z "$_cv_stub_source_path" ] || _cv_stub_source_path=$(_cv_validate_source_path "$_cv_stub_source_path") || return 1
    source_path=$(_cv_canonical_path "$requested_dir") || {
        _cv_log "ERROR: cannot resolve environment path: $requested_dir"
        return 1
    }
    source_kind=${_cv_stub_source_kind:-path}
    source_kind=$(_cv_validate_source_kind "$source_kind") || return 1
    source_path=${_cv_stub_source_path:-$source_path}
    source_path=$(_cv_validate_source_path "$source_path") || return 1
    identity=${_cv_stub_identity:-$(_cv_identity "$source_kind" "$source_path")}
    identity=$(_cv_validate_identity "$identity") || return 1
    if [ "$(basename "${requested_dir%/}")" = ".venv" ]; then
        local proj_dir="${requested_dir%/.venv}"
        [ "$proj_dir" = "$requested_dir" ] && proj_dir="${requested_dir%.venv}"
        proj_dir="${proj_dir%/}"
        [ -n "$proj_dir" ] || proj_dir="."
        local proj_name
        case "$proj_dir" in
            "."|"") proj_name=$(basename "$PWD") ;;
            *) proj_name=$(basename "$proj_dir") ;;
        esac
        if [ -n "$_cv_stub_archive_name" ]; then
            case "$_cv_stub_archive_name" in
                ".venv-"*) venv_name=".venv"; venv_subdir="" ;;
                "${proj_name}-"*) venv_name="$proj_name"; venv_subdir="/.venv"; requested_dir="$proj_dir" ;;
                *) venv_name=".venv"; venv_subdir="" ;;
            esac
        elif [ -f "$proj_dir/pyproject.toml" ]; then
            venv_name="$proj_name"; venv_subdir="/.venv"; requested_dir="$proj_dir"
            if [ -z "$_cv_stub_source_path" ]; then
                source_path=$(_cv_canonical_path "$requested_dir") || return 1
                identity=$(_cv_identity "$source_kind" "$source_path") || return 1
            fi
        else
            venv_name=".venv"; venv_subdir=""
        fi
        archive_name=$(_cv_archive_name "$identity" "$venv_name")
    else
        venv_name=$(basename "${requested_dir%/}")
        archive_name=$(_cv_archive_name "$identity" "$venv_name")
    fi
    display_name="$venv_name"
    display_name=$(_cv_validate_component "$display_name") || return 1
    archive_name=$(_cv_validate_component "$archive_name") || return 1
    selected_tarball=""
    if [ -n "${CVENV_ARCHIVE_NAME:-}" ]; then
        selector=$(_cv_archive_selector "$CVENV_ARCHIVE_NAME") || return 1
        if ! selected_tarball=$(_cv_exact_archive "$archive_dir" "$selector"); then
            if [ -n "$source_archive_dir" ]; then
                selected_tarball=$(_cv_exact_archive "$source_archive_dir" "$selector") || selected_tarball=""
                [ -z "$selected_tarball" ] || archive_dir="$source_archive_dir"
            fi
            [ -n "$selected_tarball" ] || {
                _cv_log "ERROR: CVENV_ARCHIVE_NAME does not exist: $selector"
                return 1
            }
        fi
        portable_rc=0
        portable_manifest=$(_cv_read_archive_manifest "$selected_tarball") || portable_rc=$?
        if [ "$portable_rc" -ne 0 ] && [ "$portable_rc" -ne 1 ]; then
            _cv_log "ERROR: archive manifest is invalid or unreadable: $selected_tarball"
            return 1
        fi
        if [ "$portable_rc" -eq 0 ] && \
           [ "$(_cv_manifest_field "$portable_manifest" source_kind)" = "portable" ]; then
            identity=$(_cv_manifest_field "$portable_manifest" identity)
            source_kind=portable
            display_name=$(_cv_manifest_field "$portable_manifest" display_name)
        fi
    elif [ -z "$_cv_stub_identity" ]; then
        portable_rc=0
        portable_tarball=$(_cv_find_portable_archive "$archive_dir" "$venv_name") || portable_rc=$?
        if [ "$portable_rc" -eq 1 ] && [ -n "$source_archive_dir" ] && [ "$source_archive_dir" != "$archive_dir" ]; then
            portable_rc=0
            portable_tarball=$(_cv_find_portable_archive "$source_archive_dir" "$venv_name") || portable_rc=$?
            [ "$portable_rc" -ne 0 ] || archive_dir="$source_archive_dir"
        fi
        if [ "$portable_rc" -eq 0 ]; then
            selected_tarball="$portable_tarball"
            portable_manifest=$(_cv_read_archive_manifest "$selected_tarball")
            identity=$(_cv_manifest_field "$portable_manifest" identity)
            source_kind=portable
            display_name=$(_cv_manifest_field "$portable_manifest" display_name)
        elif [ "$portable_rc" -ne 1 ]; then
            return 1
        fi
    fi
    if [ "$source_kind" = "portable" ]; then
        source_path=""
    fi
    if [ "$source_kind" = "portable" ] && \
       [ "$(basename "${requested_dir%/}")" = ".venv" ] && \
       [ "$display_name" != ".venv" ]; then
        venv_name="$display_name"
        venv_subdir="/.venv"
        requested_dir=$(_cv_canonical_path "$proj_dir") || return 1
    fi
    [ -z "$selected_tarball" ] || archive_name=$(_cv_archive_base_name "$selected_tarball")
    if [ -z "$selected_tarball" ] && [ -n "$_cv_stub_archive_name" ]; then
        archive_name="$_cv_stub_archive_name"
    fi
    archive_name=$(_cv_validate_component "$archive_name") || return 1
    case "$requested_dir" in
        /*) link_path="$requested_dir" ;;
        *)  link_path="$PWD/$requested_dir" ;;
    esac
    if [ -n "$selected_tarball" ]; then
        tarball="$selected_tarball"
    else
        tarball=$(_cv_find_archive "$archive_dir" "$archive_name") || tarball=""
        if [ -z "$tarball" ]; then
            tarball=$(_cv_find_archive "$archive_dir" "$venv_name") || tarball=""
        fi
    fi

    # Fall back to the venv's own directory if the archive isn't in the archive dir.
    if [ -z "$tarball" ]; then
        local venv_parent
        venv_parent=$(builtin cd "$(dirname "$requested_dir")" 2>/dev/null && pwd -P) || venv_parent=""
        if [ -n "$venv_parent" ]; then
            archive_dir="$venv_parent"
            if [ -n "$selected_tarball" ]; then
                tarball="$selected_tarball"
            else
                tarball=$(_cv_find_archive "$archive_dir" "$archive_name") || tarball=""
                if [ -z "$tarball" ]; then
                    tarball=$(_cv_find_archive "$archive_dir" "$venv_name") || tarball=""
                fi
            fi
        fi
    fi
    if [ "$source_kind" = "portable" ]; then
        scratch_key=$(_cv_scratch_key "$identity" "$archive_dir" "$archive_name" "$display_name")
    else
        scratch_key=${_cv_stub_scratch_key:-$(_cv_scratch_key "$identity" "$archive_dir" "$archive_name" "$venv_name")}
    fi
    scratch_key=$(_cv_validate_component "$scratch_key") || return 1
    target="${CV_JOB_SCRATCH}/${scratch_key}"

    if [ ! -e "$activate_path" ] || [ "$_cv_is_stub" = "1" ]; then
        if [ -z "$tarball" ]; then
            _cv_log "ERROR: neither activation script nor archive exists for $venv_name"
            return 1
        else
            _cv_decompress_venv "$archive_name" "$archive_dir" "$scratch_key" "$identity" "$source_kind" "$source_path" "$display_name" || return 1
            archive_name=$(cat "$target/.cvenv-archive-name" 2>/dev/null) || archive_name="$archive_name"
            archive_name=$(_cv_validate_component "$archive_name") || return 1
            mkdir -p "$(dirname "$link_path")" || return 1
            # Remove stub dir from prior deactivation so ln -sfn links.
            if [ "$_cv_is_stub" = "1" ] && [ -d "$link_path" ] && [ ! -L "$link_path" ]; then
                command rm -rf "$link_path"
            fi
            if ! _cv_validate_public_link "$link_path" "$target" 1; then
                _cv_log "ERROR: environment path exists and is not a cvenv symlink: $link_path"
                return 1
            fi
            ln -sfn "$target" "$link_path" || return 1
        fi
    fi

    local _cv_scratch_identity
    _cv_scratch_identity=$(_cv_read_scratch_identity "$target") || {
        _cv_log "ERROR: scratch manifest is invalid: $target"
        return 1
    }
    [ "$_cv_scratch_identity" = "$identity" ] || {
        _cv_log "ERROR: scratch environment belongs to a different identity: $target"
        return 1
    }

    # Propagate the environment to all nodes so that plain "srun <cmd>" works on every node.
    _cv_propagate_nodes "$archive_name" "$archive_dir" "$venv_subdir" 0 "$scratch_key" "$identity"

    # Detect if a conda environment; conda envs have bin/conda, may lack bin/activate.
    local _cv_src_is_conda=0
    if [ -f "${target}${venv_subdir}/bin/conda" ]; then
        _cv_src_is_conda=1
    fi

    _cv_ps1_before="${PS1:-}"

    if [ "$_cv_src_is_conda" = "1" ] && [ -n "${CV_CONDA:-}" ]; then
        _CV_PS1_BACKUP="$_cv_ps1_before"
        local _cv_conda_output _cv_conda_rc
        _cv_conda_rc=0
        _cv_conda_output=$("$CV_CONDA" shell.bash activate "${target}${venv_subdir}") || _cv_conda_rc=$?
        if [ "$_cv_conda_rc" -ne 0 ]; then
            unset _CV_PS1_BACKUP
            _cv_log "ERROR: conda activation failed; scratch copy retained"
            return "$_cv_conda_rc"
        fi
        eval "$_cv_conda_output"
        rc=$?
        [ "$rc" -eq 0 ] || { unset _CV_PS1_BACKUP; return "$rc"; }
    else
        _cv_augment_ld_path
        builtin source "$@"
        rc=$?
        [ "$rc" -eq 0 ] || return "$rc"
    fi
    _cv_restore_env_vars "$target" "$venv_subdir" || {
        _cv_log "ERROR: invalid environment variable snapshot"
        return 1
    }
    _cv_set_prompt "$display_name" "$_cv_ps1_before"

    if [ -n "${CONDA_PREFIX:-}" ] && [ -d "$CONDA_PREFIX/lib" ]; then
        _cv_augment_ld_path "$CONDA_PREFIX/lib"
    fi

    if [ "${VIRTUAL_ENV:-}" = "${target}${venv_subdir}" ]; then
        _cv_patch_deactivate "$display_name" "$target" "$archive_dir" "$link_path" "$venv_subdir" "$archive_name" || return 1
    elif [ -n "${CONDA_PREFIX:-}" ] && [ "${CONDA_PREFIX:-}" = "${target}${venv_subdir}" ]; then
        _cv_conda_patch_deactivate "$display_name" "$target" "$archive_dir" "$link_path" "$archive_name" || return 1
    fi
    return 0
fi

_cv_source_ordinary "$@"
]==], "")

set_shell_function("_cv_forget_created", [==[
local archive_name="${_CV_ACTIVE_ARCHIVE_NAME:-}"
[ -n "${_CV_ACTIVE_DIR:-}" ] || return 1
[ -n "${_CV_ACTIVE_LINK:-}" ] || return 1
[ -n "${_CV_ACTIVE_ARCHIVE_DIR:-}" ] || return 1
archive_name=$(_cv_validate_component "$archive_name") || return 1

local rc=0
command rm -f -- "$_CV_ACTIVE_LINK" || rc=$?
command rm -rf -- "$_CV_ACTIVE_DIR" || rc=$?
command rm -f -- "${_CV_ACTIVE_ARCHIVE_DIR}/${archive_name}.tar.zst" || rc=$?
command rm -f -- "${_CV_ACTIVE_ARCHIVE_DIR}/${archive_name}.tar.gz" || rc=$?
command rm -f -- "${_CV_ACTIVE_ARCHIVE_DIR}/${archive_name}.README.md" || rc=$?
unset _CV_ACTIVE_NAME _CV_ACTIVE_ARCHIVE_NAME _CV_ACTIVE_DIR _CV_ACTIVE_ARCHIVE_DIR _CV_ACTIVE_LINK _CV_ACTIVE_VENV_SUBDIR
unset _CV_ACTIVE_IDENTITY _CV_ACTIVE_SCRATCH_KEY _CV_ACTIVE_SOURCE_KIND _CV_ACTIVE_SOURCE_PATH
unset _CV_AUTO_ACTIVATED _CV_RO_AUTO
_cv_scratch_cleanup
return "$rc"
]==], "")

set_shell_function("rm", [==[
# Block removal of active or expanded cvenv venvs to avoid broken state.
local -a _cv_safe_args=()
local arg resolved _cv_refused=0 _cv_protected _cv_end_options=0
local _cv_shell_active=0 _cv_created_removal=0
local _cv_operand_count=0
if [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; then
    _cv_shell_active=1
fi
for arg in "$@"; do
    if [ "$_cv_end_options" = "0" ]; then
        case "$arg" in
            --) _cv_end_options=1; _cv_safe_args+=("$arg"); continue ;;
            -*) _cv_safe_args+=("$arg"); continue ;;
        esac
    fi
    resolved=$(readlink -f "$arg" 2>/dev/null) || resolved="$arg"
    local _cv_skip=0
    for _cv_protected in "${_CV_ACTIVE_DIR:-}" "${_CV_ACTIVE_LINK:-}" \
                         "${_CV_EXPANDED_DIR:-}" "${_CV_EXPANDED_LINK:-}" \
                         "${CV_JOB_SCRATCH:-}"; do
        [ -n "$_cv_protected" ] || continue
        local _cv_prot_resolved
        _cv_prot_resolved=$(readlink -f "$_cv_protected" 2>/dev/null) || _cv_prot_resolved="$_cv_protected"
        if [ "$resolved" = "$_cv_prot_resolved" ] || [ "$resolved" = "$_cv_protected" ]; then
            if [ "$_cv_shell_active" = "0" ] &&
               { [ "$_cv_protected" = "${_CV_ACTIVE_DIR:-}" ] || [ "$_cv_protected" = "${_CV_ACTIVE_LINK:-}" ]; }; then
                _cv_created_removal=1
            else
                _cv_skip=1
            fi
            break
        fi
        if [[ "$_cv_prot_resolved" == "$resolved"/* ]]; then
            if [ "$_cv_shell_active" = "0" ] &&
               { [ "$_cv_protected" = "${_CV_ACTIVE_DIR:-}" ] || [ "$_cv_protected" = "${_CV_ACTIVE_LINK:-}" ]; }; then
                _cv_created_removal=1
            else
                _cv_skip=1
            fi
            break
        fi
    done
    if [ "$_cv_skip" = "1" ]; then
        _cv_log "ERROR: refusing to remove active cvenv path: $arg"
        _cv_refused=1
    else
        _cv_safe_args+=("$arg")
        _cv_operand_count=$((_cv_operand_count + 1))
    fi
done
[ "$_cv_refused" = "0" ] || return 1
[ "$_cv_operand_count" -gt 0 ] || [ "$_cv_created_removal" = "1" ] || return 0
local rc=0
if [ "$_cv_operand_count" -gt 0 ]; then
    command rm "${_cv_safe_args[@]}" || rc=$?
fi
if [ "$rc" -eq 0 ] && [ "$_cv_created_removal" = "1" ]; then
    _cv_forget_created || return $?
fi
return "$rc"
]==], "")

set_shell_function("deactivate", [==[
_cv_fallback_deactivate
]==], "")

set_shell_function("_cv_fallback_deactivate", [==[
# Handle deactivation after creation; activation replaces the public wrapper.
if [ -z "${_CV_ACTIVE_NAME:-}" ]; then
    return 0
fi
if [ -n "${VIRTUAL_ENV:-}" ] && \
   [ "$VIRTUAL_ENV" != "${_CV_ACTIVE_DIR}${_CV_ACTIVE_VENV_SUBDIR:-}" ]; then
    return 0
fi
if [ "${CVENV_RO:-0}" = "1" ]; then
    _cv_log "CVENV_RO set; skipping recompression for ${_CV_ACTIVE_NAME}"
else
    _cv_compress_venv "$_CV_ACTIVE_DIR" "$_CV_ACTIVE_ARCHIVE_DIR" "$_CV_ACTIVE_VENV_SUBDIR" || return $?
fi
local _cv_manifest _cv_identity _cv_scratch_key _cv_source_kind _cv_source_path
_cv_manifest=$(_cv_read_scratch_manifest "$_CV_ACTIVE_DIR") || _cv_manifest=""
_cv_identity=$(_cv_manifest_field "$_cv_manifest" identity) || _cv_identity=""
_cv_scratch_key=$(basename "$_CV_ACTIVE_DIR")
_cv_source_kind=$(_cv_manifest_field "$_cv_manifest" source_kind) || _cv_source_kind="legacy"
_cv_source_path=$(_cv_manifest_field "$_cv_manifest" source_path) || _cv_source_path=""
if [ -L "$_CV_ACTIVE_LINK" ]; then
    command rm -f -- "$_CV_ACTIVE_LINK" || \
        _cv_log "WARNING: could not remove environment link: $_CV_ACTIVE_LINK"
fi
command rm -rf "$_CV_ACTIVE_DIR"
_cv_scratch_cleanup
if ! _cv_write_dummy_activate "$_CV_ACTIVE_ARCHIVE_NAME" "$_CV_ACTIVE_ARCHIVE_DIR" "$_CV_ACTIVE_LINK" "$_CV_ACTIVE_VENV_SUBDIR" "$_cv_identity" "$_cv_scratch_key" "$_cv_source_kind" "$_cv_source_path"; then
    _cv_log "WARNING: could not write activation stub; archive remains available"
fi
unset _CV_ACTIVE_NAME _CV_ACTIVE_ARCHIVE_NAME _CV_ACTIVE_DIR _CV_ACTIVE_ARCHIVE_DIR _CV_ACTIVE_LINK _CV_ACTIVE_VENV_SUBDIR
unset _CV_ACTIVE_IDENTITY _CV_ACTIVE_SCRATCH_KEY _CV_ACTIVE_SOURCE_KIND _CV_ACTIVE_SOURCE_PATH
unset _CV_AUTO_ACTIVATED
if [ "${_CV_RO_AUTO:-0}" = "1" ]; then
    unset CVENV_RO _CV_RO_AUTO
fi
]==], "")

set_shell_function("_cv_pip_subcommand", [==[
local argument subcommand=""
while [ "$#" -gt 0 ]; do
    argument="$1"
    shift
    case "$argument" in
        --)
            [ "$#" -gt 0 ] && subcommand="$1"
            break
            ;;
        --python|--cache-dir|--cert|--client-cert|--exists-action|--keyring-provider|--log|--proxy|--retries|--timeout|--trusted-host)
            [ "$#" -gt 0 ] || break
            shift
            ;;
        -*) ;;
        *)
            subcommand="$argument"
            break
            ;;
    esac
done
[ -n "$subcommand" ] || return 1
printf '%s\n' "$subcommand"
]==], "")

set_shell_function("_cv_save_pip_mutation", [==[
local active_env="$1" rc="$2" command_name
shift 2
command_name=$(_cv_pip_subcommand "$@") || return 0
case "$command_name" in
    install|uninstall) ;;
    *) return 0 ;;
esac
[ "$rc" -eq 0 ] || return 0
[ -n "${_CV_ACTIVE_DIR:-}" ] || return 0
[ "$active_env" = "${_CV_ACTIVE_DIR}${_CV_ACTIVE_VENV_SUBDIR:-}" ] || return 0
_cv_patch_nccl "$_CV_ACTIVE_DIR" "${_CV_ACTIVE_VENV_SUBDIR:-}"
_cv_log "Saving environment changes after pip"
_cv_compress_venv "$_CV_ACTIVE_DIR" "$_CV_ACTIVE_ARCHIVE_DIR" || return $?
_cv_propagate_nodes "$_CV_ACTIVE_ARCHIVE_NAME" "$_CV_ACTIVE_ARCHIVE_DIR" "${_CV_ACTIVE_VENV_SUBDIR:-}" 1 "${_CV_ACTIVE_DIR##*/}" "$(_cv_read_scratch_identity "$_CV_ACTIVE_DIR")"
]==], "")

set_shell_function("pip", [==[
local rc

_cv_apply_job_cache || return 1
local _cv_pip_env="${VIRTUAL_ENV:-${CONDA_PREFIX:-}}"
if [ -n "$_cv_pip_env" ] && [ -x "$_cv_pip_env/bin/pip" ]; then
    "$_cv_pip_env/bin/pip" "$@"
elif [ -n "$_cv_pip_env" ] && [ -x "$_cv_pip_env/bin/python" ]; then
    "$_cv_pip_env/bin/python" -m pip "$@"
else
    command pip "$@"
fi
rc=$?

_cv_save_pip_mutation "$_cv_pip_env" "$rc" "$@" || return $?
return "$rc"
]==], "")

set_shell_function("pip3", [==[
local rc

_cv_apply_job_cache || return 1
local _cv_pip_env="${VIRTUAL_ENV:-${CONDA_PREFIX:-}}"
if [ -n "$_cv_pip_env" ] && [ -x "$_cv_pip_env/bin/pip3" ]; then
    "$_cv_pip_env/bin/pip3" "$@"
elif [ -n "$_cv_pip_env" ] && [ -x "$_cv_pip_env/bin/pip" ]; then
    "$_cv_pip_env/bin/pip" "$@"
elif [ -n "$_cv_pip_env" ] && [ -x "$_cv_pip_env/bin/python" ]; then
    "$_cv_pip_env/bin/python" -m pip "$@"
else
    command pip3 "$@"
fi
rc=$?

_cv_save_pip_mutation "$_cv_pip_env" "$rc" "$@" || return $?
return "$rc"
]==], "")

-- Informational load messages ----------------------------------------
if mode() == "load" then
    LmodMessage("[cvenv] Transparent venv compression active")
    LmodMessage("[cvenv] Archive directory must be outside /tmp and CV_JOB_SCRATCH")
    LmodMessage("[cvenv] Job scratch: " .. job_scratch)
    if job_id and job_id ~= "" then
        LmodMessage("[cvenv] Slurm nodes: " .. tostring(slurm_num_nodes))
    end
    if multi_node then
        if is_writer then
            LmodMessage("[cvenv] Multi-node job: archive updates are enabled on this host")
        else
            LmodMessage("[cvenv] Multi-node job: this is a read-only node")
            LmodMessage("[cvenv] Archive updates are disabled; install packages on the head node only")
            LmodMessage("[cvenv] Changes made here are local to this node and will not be saved")
        end
    end
    if archive_dir == "" then
        LmodMessage("[cvenv] Archive dir: current directory at use time")
    else
        LmodMessage("[cvenv] Archive dir: " .. archive_dir)
    end
    LmodMessage("[cvenv] Archive backend: " .. backend_ext)
end

if mode() == "load" then
    if uv ~= "" then
        LmodMessage("[cvenv] uv detected: 'uv venv', 'uv init', and 'uv run' are supported")
    end
    if conda ~= "" then
        LmodMessage("[cvenv] conda detected: 'conda create', 'conda env create', and 'conda activate' are supported")
    end
    if multi_node then
        LmodMessage("[cvenv] Environments are propagated to all nodes at activation; plain 'srun' should work")
    end
end

"""
