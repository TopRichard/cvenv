set_shell_function("_cv_propagate_nodes", [==[
# Decompress the venv archive on every node in the Slurm allocation so
# that plain "srun <cmd>" works on every node.  Called from the source
# and conda-activate wrappers after the head node has decompressed its
# own copy, and after pip/uv/conda install to refresh stale nodes.
#
# Arguments:
#   $1 venv_name
#   $2 archive_dir
#   $3 venv_subdir  (e.g. "/.venv" for uv-init projects, "" otherwise)
#   $4 force        (optional: "1" = remove existing copy before extracting)
#
# Only runs when:
#   - CV_MULTI_NODE=1 (multi-node Slurm allocation)
#   - CV_IS_WRITER=1 (head node only, to avoid every node re-propagating)
#   - srun is available on PATH
#   - SLURM_JOB_ID is set
local venv_name="$1"
local archive_dir="$2"
local venv_subdir="${3:-}"
local force="${4:-0}"

[ "${CV_MULTI_NODE:-0}" = "1" ] || return 0
[ "${CV_IS_WRITER:-1}" = "1" ] || return 0
[ -n "${SLURM_JOB_ID:-}" ] || return 0
command -v srun >/dev/null 2>&1 || return 0

local tarball="${archive_dir}/${venv_name}${CV_BACKEND_EXT}"
[ -f "$tarball" ] || return 0

if [ "$force" = "1" ]; then
    _cv_log "Re-propagating ${venv_name} to all nodes (force) via srun ..."
else
    _cv_log "Propagating ${venv_name} to all nodes via srun ..."
fi

# Build a self-contained script that each remote node will execute.
# It mirrors what _cv_decompress_venv does but is standalone (does not
# rely on the cvenv shell functions being defined on the remote node).
# The script MUST live on the shared filesystem so every node can read it;
# a local mktemp (/tmp) would not be visible on remote nodes.
local _cv_prop_script="${archive_dir}/.cvenv-propagate-$$.sh"
cat > "$_cv_prop_script" <<'PROPSCRIPT'
#!/bin/bash
set -euo pipefail

venv_name="$1"
archive_dir="$2"
venv_subdir="$3"
backend_ext="$4"
backend_decompress="$5"
job_scratch="$6"
force="$7"

tarball="${archive_dir}/${venv_name}${backend_ext}"
target="${job_scratch}/${venv_name}"
activate="${target}${venv_subdir}/bin/activate"
conda_bin="${target}${venv_subdir}/bin/conda"

# In force mode, skip the head node (SLURM_NODEID 0) — it already has
# the up-to-date copy that was just installed/recompressed.
if [ "$force" = "1" ] && [ -n "${SLURM_NODEID:-}" ] && [ "$SLURM_NODEID" = "0" ]; then
    exit 0
fi

# Already present on this node?
if [ -d "$target" ]; then
    if [ "$force" = "1" ]; then
        rm -rf "$target"
    elif [ -f "$activate" ] || [ -f "$conda_bin" ] || [ -f "$target/bin/python" ]; then
        exit 0
    else
        rm -rf "$target"
    fi
fi

[ -f "$tarball" ] || { echo "[cvenv] ERROR: archive not found: $tarball" >&2; exit 1; }
mkdir -p "$job_scratch" || { echo "[cvenv] ERROR: cannot create $job_scratch" >&2; exit 1; }

set -o pipefail
eval "$backend_decompress \"$tarball\"" | tar -xf - -C "$job_scratch"
rc=$?
set +o pipefail
[ "$rc" -eq 0 ] || { echo "[cvenv] ERROR: extraction failed on $(hostname 2>/dev/null || echo unknown)" >&2; exit "$rc"; }

# Relocate prefix if the archive was created in a different /tmp path.
marker="${target}/.cvenv-prefix"
if [ -f "$marker" ]; then
    old_prefix=$(cat "$marker")
    if [ -n "$old_prefix" ] && [ "$old_prefix" != "$target" ]; then
        reloc_python="${CV_ORIGINAL_PYTHON3:-${CV_ORIGINAL_PYTHON:-python3}}"
        while IFS= read -r -d '' file; do
            chmod u+w "$file" 2>/dev/null || true
            OLD_PREFIX="$old_prefix" NEW_PREFIX="$target" \
                "$reloc_python" -c 'import os,pathlib,sys;p=pathlib.Path(sys.argv[1]);d=p.read_bytes();o=os.environ["OLD_PREFIX"].encode();n=os.environ["NEW_PREFIX"].encode();p.write_bytes(d.replace(o,n)) if o in d else None' \
                "$file" 2>/dev/null || true
        done < <(grep -IlZR -- "$old_prefix" "$target/bin" 2>/dev/null || true)
        printf '%s\n' "$target" > "$marker" 2>/dev/null || true
    fi
fi

echo "[cvenv] ${venv_name} ready on $(hostname 2>/dev/null || echo unknown)"
PROPSCRIPT
chmod +x "$_cv_prop_script"

# Run one task per node across all nodes in the allocation.
local _cv_num_nodes="${SLURM_JOB_NUM_NODES:-1}"
srun --export=ALL --ntasks="$_cv_num_nodes" --ntasks-per-node=1 \
    "$_cv_prop_script" \
    "$venv_name" "$archive_dir" "$venv_subdir" \
    "$CV_BACKEND_EXT" "$CV_BACKEND_DECOMPRESS" "$CV_JOB_SCRATCH" "$force"
local _cv_prop_rc=$?

rm -f "$_cv_prop_script"

if [ "$_cv_prop_rc" -ne 0 ]; then
    _cv_log "WARNING: propagation to some nodes failed (rc=$_cv_prop_rc); plain 'srun' may not work on all nodes"
    return 0
fi

_cv_log "Propagation complete; plain 'srun' commands should now work"
]==], "")

set_shell_function("source", [==[
if [ "$#" -ge 1 ] && [[ "$1" == */bin/activate ]]; then
    local activate_path="$1"
    local requested_dir venv_name archive_dir target link_path tarball rc venv_subdir
    requested_dir="${activate_path%/bin/activate}"
    [ -n "$requested_dir" ] || requested_dir="."
    venv_subdir=""
    if [ "$(basename "${requested_dir%/}")" = ".venv" ]; then
        local proj_dir="${requested_dir%/.venv}"
        [ "$proj_dir" = "$requested_dir" ] && proj_dir="${requested_dir%.venv}"
        proj_dir="${proj_dir%/}"
        [ -n "$proj_dir" ] || proj_dir="."
        venv_name=$(basename "$(cd "$proj_dir" 2>/dev/null && pwd -P || echo "$proj_dir")")
        venv_subdir="/.venv"
        requested_dir="$proj_dir"
    else
        venv_name=$(basename "${requested_dir%/}")
    fi
    archive_dir=$(_cv_archive_dir) || return 1
    archive_dir=$(cd "$archive_dir" 2>/dev/null && pwd -P) || return 1
    target="${CV_JOB_SCRATCH}/${venv_name}"
    link_path="$PWD/$requested_dir"
    tarball="${archive_dir}/${venv_name}${CV_BACKEND_EXT}"

    # A CVENV_STUB marker means the venv was archived by cvenv on
    # deactivation; treat it as "needs decompression" just like a
    # missing file.
    local _cv_is_stub=0
    if [ -f "$activate_path" ] && grep -q 'CVENV_STUB' "$activate_path" 2>/dev/null; then
        _cv_is_stub=1
    fi

    if [ ! -e "$activate_path" ] || [ "$_cv_is_stub" = "1" ]; then
        if [ ! -f "$tarball" ]; then
            if [ -n "$venv_subdir" ] && [ -f "$target/pyproject.toml" ]; then
                _cv_log "Creating .venv for uv project: $target/.venv"
                ( cd "$target" && "$CV_UV" venv .venv ) || {
                    _cv_log "ERROR: venv creation failed for $venv_name"
                    return 1
                }
                mkdir -p "$(dirname "$link_path")" || return 1
                ln -sfn "$target" "$link_path" || return 1
            else
                _cv_log "ERROR: neither activation script nor archive exists for $venv_name"
                return 1
            fi
        else
            _cv_decompress_venv "$venv_name" "$archive_dir" || return 1
            mkdir -p "$(dirname "$link_path")" || return 1
            # Remove a stub directory left by a previous deactivation
            # so ln -sfn creates the symlink at $link_path rather than
            # inside it.
            if [ "$_cv_is_stub" = "1" ] && [ -d "$link_path" ] && [ ! -L "$link_path" ]; then
                command rm -rf "$link_path"
            fi
            ln -sfn "$target" "$link_path" || return 1
        fi
    fi

    # Propagate the environment to all nodes in the allocation so that
    # plain "srun <cmd>" works on every node.
    _cv_propagate_nodes "$venv_name" "$archive_dir" "$venv_subdir"

    # Detect whether this is a conda environment.  Conda envs have
    # bin/conda (and may lack a venv-style bin/activate).  For conda envs
    # we activate via "conda shell.bash activate" directly, because
    # conda's own bin/activate script calls "conda activate" which would
    # re-enter the cvenv conda wrapper and cause double augmentation.
    local _cv_src_is_conda=0
    if [ -f "${target}${venv_subdir}/bin/conda" ]; then
        _cv_src_is_conda=1
    fi

    if [ "$_cv_src_is_conda" = "1" ] && [ -n "${CV_CONDA:-}" ]; then
        _CV_PS1_BACKUP="$PS1"
        eval "$("$CV_CONDA" shell.bash activate "${target}${venv_subdir}")"
        rc=$?
        [ "$rc" -eq 0 ] || { unset _CV_PS1_BACKUP; return "$rc"; }
    else
        builtin source "$@"
        rc=$?
        [ "$rc" -eq 0 ] || return "$rc"
    fi

    if [ -n "${CONDA_PREFIX:-}" ] && [ -d "$CONDA_PREFIX/lib" ]; then
        _cv_augment_ld_path "$CONDA_PREFIX/lib"
    else
        _cv_augment_ld_path
    fi

    _cv_restore_env_vars "$target" "$venv_subdir"

    if [ "${VIRTUAL_ENV:-}" = "${target}${venv_subdir}" ]; then
        _cv_patch_deactivate "$venv_name" "$target" "$archive_dir" "$link_path" "$venv_subdir"
    elif [ -n "${CONDA_PREFIX:-}" ] && [ "${CONDA_PREFIX:-}" = "${target}${venv_subdir}" ]; then
        _cv_conda_patch_deactivate "$venv_name" "$target" "$archive_dir" "$link_path"
    fi
    return 0
fi

builtin source "$@"
]==], "")

set_shell_function("rm", [==[
# Block removal of active or expanded cvenv venvs to avoid broken state.
local -a _cv_safe_args=()
local _cv_blocked=0
local arg resolved
for arg in "$@"; do
    case "$arg" in
        -*) _cv_safe_args+=("$arg"); continue ;;
    esac
    resolved=$(readlink -f "$arg" 2>/dev/null) || resolved="$arg"
    local _cv_skip=0
    for _cv_protected in "${_CV_ACTIVE_DIR:-}" "${_CV_ACTIVE_LINK:-}" \
                         "${_CV_EXPANDED_DIR:-}" "${_CV_EXPANDED_LINK:-}" \
                         "${CV_JOB_SCRATCH:-}"; do
        [ -n "$_cv_protected" ] || continue
        local _cv_prot_resolved
        _cv_prot_resolved=$(readlink -f "$_cv_protected" 2>/dev/null) || _cv_prot_resolved="$_cv_protected"
        if [ "$resolved" = "$_cv_prot_resolved" ] || [ "$resolved" = "$_cv_protected" ]; then
            _cv_skip=1
            break
        fi
        # Block removing a parent of the protected path (e.g. rm -rf /tmp).
        case "$_cv_prot_resolved" in
            "$resolved"/*) _cv_skip=1; break ;;
        esac
    done
    if [ "$_cv_skip" = "1" ]; then
        _cv_log "WARNING: refusing to remove active cvenv path: $arg"
        _cv_blocked=1
    else
        _cv_safe_args+=("$arg")
    fi
done
[ "${#_cv_safe_args[@]}" -gt 0 ] || return 0
command rm "${_cv_safe_args[@]}"
]==], "")

set_shell_function("pip", [==[
local rc
local _cv_pip_env="${VIRTUAL_ENV:-${CONDA_PREFIX:-}}"
if [ -n "$_cv_pip_env" ] && [ -x "$_cv_pip_env/bin/pip" ]; then
    "$_cv_pip_env/bin/pip" "$@"
else
    command pip "$@"
fi
rc=$?

if [ "$rc" -eq 0 ] && [ -n "${_CV_ACTIVE_DIR:-}" ] && [ "$_cv_pip_env" = "${_CV_ACTIVE_DIR}${_CV_ACTIVE_VENV_SUBDIR:-}" ]; then
    _cv_patch_nccl "$_CV_ACTIVE_DIR" "${_CV_ACTIVE_VENV_SUBDIR:-}"
    _cv_log "Saving environment changes after pip"
    _cv_compress_venv "$_CV_ACTIVE_DIR" "$_CV_ACTIVE_ARCHIVE_DIR" || return $?
    _cv_propagate_nodes "$_CV_ACTIVE_NAME" "$_CV_ACTIVE_ARCHIVE_DIR" "${_CV_ACTIVE_VENV_SUBDIR:-}" 1
fi
return "$rc"
]==], "")

set_shell_function("pip3", [==[
local rc
local _cv_pip_env="${VIRTUAL_ENV:-${CONDA_PREFIX:-}}"
if [ -n "$_cv_pip_env" ] && [ -x "$_cv_pip_env/bin/pip3" ]; then
    "$_cv_pip_env/bin/pip3" "$@"
elif [ -n "$_cv_pip_env" ] && [ -x "$_cv_pip_env/bin/pip" ]; then
    "$_cv_pip_env/bin/pip" "$@"
else
    command pip3 "$@"
fi
rc=$?

if [ "$rc" -eq 0 ] && [ -n "${_CV_ACTIVE_DIR:-}" ] && [ "$_cv_pip_env" = "${_CV_ACTIVE_DIR}${_CV_ACTIVE_VENV_SUBDIR:-}" ]; then
    _cv_patch_nccl "$_CV_ACTIVE_DIR" "${_CV_ACTIVE_VENV_SUBDIR:-}"
    _cv_log "Saving environment changes after pip"
    _cv_compress_venv "$_CV_ACTIVE_DIR" "$_CV_ACTIVE_ARCHIVE_DIR" || return $?
    _cv_propagate_nodes "$_CV_ACTIVE_NAME" "$_CV_ACTIVE_ARCHIVE_DIR" "${_CV_ACTIVE_VENV_SUBDIR:-}" 1
fi
return "$rc"
]==], "")

-- Informational load messages ----------------------------------------
if mode() == "load" then
    LmodMessage("[cvenv] Transparent venv compression active")
    LmodMessage("[cvenv] You must be outside /tmp to use cvenv")
    LmodMessage("[cvenv] Job scratch: " .. job_scratch)
    if job_id and job_id ~= "" then
        LmodMessage("[cvenv] Slurm nodes: " .. tostring(slurm_num_nodes))
    end
    if multi_node then
        if is_writer then
            LmodMessage("[cvenv] Multi-node job: this is the writer node (SLURM_NODEID 0)")
            LmodMessage("[cvenv] Archive updates are enabled on this node")
        else
            LmodMessage("[cvenv] Multi-node job: this is a read-only node (SLURM_NODEID != 0)")
            LmodMessage("[cvenv] Archive updates are disabled; install packages on the head node only")
            LmodMessage("[cvenv] Changes made here are local to this node and will not be saved")
        end
    end
    if archive_dir == "" then
        LmodMessage("[cvenv] Archive dir: current directory at use time")
    else
        LmodMessage("[cvenv] Archive dir: " .. archive_dir)
    end
    LmodMessage("[cvenv] Backend: " .. backend_compress)
end

if mode() == "load" then
    if uv ~= "" then
        LmodMessage("[cvenv] uv detected: 'uv venv', 'uv init', and 'uv run' are supported")
    end
    if conda ~= "" then
        LmodMessage("[cvenv] conda detected: 'conda create', 'conda env create', and 'conda activate' are supported")
    end
    if multi_node then
        LmodMessage("[cvenv] Environments are propagated to all nodes at activation; plain 'srun' should work")
    end
end

-- Metadata ------------------------------------------------------------
whatis("Name: cvenv")
whatis("Description: Transparent compressed Python and conda venvs for parallel filesystems")
whatis("Backend: " .. backend_compress)
"""
