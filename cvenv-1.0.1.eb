#Author: Richard Topouchian
easyblock = 'Bundle'

name = 'cvenv'
version = '1.0.1'

homepage = 'https://github.com/TopRichard/cvenv'

whatis = ['Description: Transparent compressed Python and conda venvs for parallel filesystems']

description = """Compressed Python and Conda Virtual Environments

This module keeps an expanded Python virtual environment or conda environment
in job-local scratch and stores it as one compressed tar archive on the
parallel filesystem.

Typical use:

  module load cvenv
  python -m venv myenv
  source myenv/bin/activate
  pip install pytest==9.1.1 numpy==2.5.3
  deactivate

If uv is available, uv venv and uv init are also supported:

  module load cvenv
  uv venv myenv
  source myenv/bin/activate
  uv pip install pytest==9.1.1 numpy==2.5.3
  deactivate

An existing archive can be activated with the same command:

  source myenv/bin/activate

Environment variables:

  CV_ARCHIVE_DIR   Archive directory. If unset before module load, the current
                  directory at creation/activation time is used. Do not use
                  /tmp!
  CV_JOB_SCRATCH   Expansion directory. Defaults to /tmp/<job-id> inside a
                   Slurm allocation, or /tmp/cvenv_<user> outside Slurm.
                   Each node decompresses into its own node-local /tmp.
  CV_JOB_CACHE     Pip/uv cache directory. If set, overrides PIP_CACHE_DIR
                   and UV_CACHE_DIR.  Defaults to $SCRATCH if defined,
                   otherwise $LOCALSCRATCH if defined, otherwise pip's default.
  CVENV_RO         Set to 1 to skip recompression on deactivation when no
                   packages were installed.  Mutating commands (pip install,
                   uv add/remove/sync, conda install/remove) always recompress
                   regardless.  uv run sets this automatically.  Set to 0 to
                   force recompression everywhere.  Default: 1 for uv run,
                   unset otherwise.

Env-var persistence:
  When the environment is compressed (on pip/uv/conda install or on
  deactivation), cvenv snapshots a curated set of environment variables
  into .cvenv-envvars.sh inside the archive.  On the next activation
  those variables are restored automatically.  Variables already set in
  the shell take precedence over saved values, so you can override by
  exporting before activating.

  The built-in allow-list covers common HPC/ML variables: CUDA_*,
  NCCL_*, OMP_*, OPENBLAS_*, MKL_*, HF_*/HUGGINGFACE_*, TRANSFORMERS_*,
  DATASETS_*, TOKENIZERS_PARALLELISM, PYTORCH_CUDA_ALLOC_CONF,
  TORCHINDUCTOR_*, XLA_*, JAX_*, PYTHONPATH, PYTHONUNBUFFERED,
  PYTHONHASHSEED, LD_PRELOAD, SLURM_CPUS_PER_TASK, UV_INDEX_URL,
  UV_EXTRA_INDEX_URL, and many more.

  To persist your own variables, prefix them with CV_USER_ (e.g.
  export CV_USER_MY_CONFIG=/path/to/config).  All CV_USER_* variables
  are automatically saved and restored.

Notes:
  * A <name>.README.md file is written next to the archive every time the
    environment is saved.  It lists the Lmod modules that were loaded
    (from $LOADEDMODULES) and shows the exact commands to reload them
    and reactivate the environment in a new job.
  * The implementation is intended for Bash.
  * Multi-node Slurm allocations are supported.  Each node decompresses
    its own independent copy of the environment into node-local /tmp.
    To avoid concurrent-write corruption of the shared archive, only the
    head node (SLURM_NODEID 0) is allowed to (re)compress the archive.
    All other nodes run in read-only mode: they can decompress and use the
    environment, but pip install / uv add / deactivate on a non-head node
    will NOT persist changes to the archive.  Install packages on the head
    node only.
  * In multi-node jobs the environment is automatically propagated to all
    nodes when you activate it on the head node (source myenv/bin/activate
    or conda activate myenv).  After activation, plain 'srun python
    script.py' works on every node because each node already has the venv
    in its own /tmp.
  * Always run deactivate before leaving a job when practical.
  * Do not activate the same archive concurrently from multiple jobs. The
    last writer would otherwise replace changes made by another job.
 * uv support (venv, init, run) is enabled automatically when uv is found
   on PATH at module load time.  uv's cache is redirected to job scratch.
   Mutating uv commands (pip install, add, remove, sync) and uv run
   auto-activate a local .venv if one exists, so manual
   "source .venv/bin/activate" is optional.  uv run auto-deactivates the
   venv when the run finishes (without recompressing; set CVENV_RO=0 to
   force it); mutating commands auto-deactivate when you
   cd away from the owning directory.  Read-only commands use uv's own
   .venv discovery.
 * conda / miniconda support is enabled automatically when conda is found
   on PATH at module load time.  "conda create", "conda env create", and
   "conda activate" are intercepted so the environment lives in job-local
   scratch while only a compressed archive is stored on the parallel
   filesystem.  "conda install" / "conda remove" against an active
   environment recompress the archive automatically.  "conda deactivate"
   archives and cleans up the scratch copy.  Environments created with
   "conda create -n <name>" are stored as <name>.tar.zst; environments
   created with "conda env create -f environment.yml" use the name from
   the file (or the basename of environment.yml if no name is given).
"""

toolchain = SYSTEM

# Embed the updated Lua implementation in the generated module file.
# This includes multi-node Slurm support and automatic node propagation at
# activation time.
modluafooter = r"""
-- Configuration -------------------------------------------------------
local user = os.getenv("USER") or "unknown"
local job_id = os.getenv("SLURM_JOB_ID")
local slurm_num_nodes =
    os.getenv("SLURM_JOB_NUM_NODES") or
    os.getenv("SLURM_NNODES")
local cpus = tonumber(os.getenv("SLURM_CPUS_ON_NODE")) or 1

-- The expanded environment is stored locally under /tmp on every node.
-- Because /tmp is node-local, each node decompresses its own independent
-- copy from the shared archive on the parallel filesystem.
if job_id and job_id ~= "" then
    if not slurm_num_nodes or slurm_num_nodes == "" then
        LmodError(
            "cvenv: unable to determine the number of nodes in Slurm job "
            .. job_id
        )
    end

    local num_nodes = tonumber(slurm_num_nodes)
    if not num_nodes then
        LmodError(
            "cvenv: invalid Slurm node count: "
            .. tostring(slurm_num_nodes)
        )
    end
end

-- In multi-node allocations only the head node (SLURM_NODEID 0) may write
-- the shared archive.  Every other node decompresses into its own node-local
-- /tmp but must not recompress, otherwise concurrent writes to the same
-- tarball on the parallel filesystem corrupt the archive.
local multi_node = false
local is_writer = true
if job_id and job_id ~= "" then
    local num_nodes = tonumber(slurm_num_nodes) or 1
    if num_nodes and num_nodes > 1 then
        multi_node = true
        local node_id = os.getenv("SLURM_NODEID")
        if node_id and node_id ~= "" and tonumber(node_id) ~= 0 then
            is_writer = false
        end
    end
end

local default_scratch
if job_id and job_id ~= "" then
    default_scratch = "/tmp/" .. job_id
else
    default_scratch = "/tmp/cvenv_" .. user
end

local job_scratch = os.getenv("CV_JOB_SCRATCH") or default_scratch
local archive_dir = os.getenv("CV_ARCHIVE_DIR") or ""
local job_cache = os.getenv("CV_JOB_CACHE") or os.getenv("SCRATCH") or os.getenv("LOCALSCRATCH") or ""

-- Command detection ---------------------------------------------------
local function command_path(name)
    local p = capture("command -v " .. name .. " 2>/dev/null") or ""
    return (p:gsub("%s+$", ""))
end

local pzstd = command_path("pzstd")
local python = command_path("python")
local python3 = command_path("python3")
local uv = command_path("uv")
local conda = command_path("conda")
local backend_ext
local backend_compress
local backend_decompress

if  pzstd ~= "" then
    backend_ext = ".tar.zst"
    backend_compress = pzstd .. " -p" .. cpus .. " -3 -c"
    backend_decompress = pzstd .. " -p" .. cpus .. " -dc"
end

if python == "" then
    python = python3
end
if python3 == "" then
    python3 = python
end
if python == "" then
    LmodError("cvenv: neither python nor python3 is available")
end

setenv("CV_JOB_SCRATCH", job_scratch)
setenv("CV_MULTI_NODE", multi_node and "1" or "0")
setenv("CV_IS_WRITER", is_writer and "1" or "0")
setenv("CV_ARCHIVE_DIR", archive_dir)
setenv("CV_BACKEND_EXT", backend_ext)
setenv("CV_BACKEND_COMPRESS", backend_compress)
setenv("CV_BACKEND_DECOMPRESS", backend_decompress)
setenv("CV_ORIGINAL_PYTHON", python)
setenv("CV_ORIGINAL_PYTHON3", python3)
setenv("CV_UV", uv)
setenv("CV_CONDA", conda)
setenv("CV_JOB_CACHE", job_cache)
if job_cache ~= "" then
    setenv("PIP_CACHE_DIR", job_cache)
    setenv("UV_CACHE_DIR", job_cache)
end

-- Bash helper functions -----------------------------------------------
set_shell_function("_cv_log", [==[
printf '\033[1;34m[cvenv]\033[0m %s\n' "$*" >&2
]==], "")

set_shell_function("_cv_archive_dir", [==[
if [ -n "${CV_ARCHIVE_DIR:-}" ]; then
    printf '%s\n' "$CV_ARCHIVE_DIR"
else
    printf '%s\n' "$PWD"
fi
]==], "")

set_shell_function("_cv_scratch_cleanup", [==[
# Remove the job-scratch root when empty (last venv deactivated).
[ -n "${CV_JOB_SCRATCH:-}" ] || return 0
[ -d "$CV_JOB_SCRATCH" ] || return 0
rmdir "$CV_JOB_SCRATCH" 2>/dev/null || true
]==], "")

set_shell_function("_cv_save_env_vars", [==[
# Snapshot a curated set of environment variables into a file inside the
# venv directory so they survive archive/dearchive cycles.  The file is
# a POSIX shell snippet that _cv_restore_env_vars sources on activation.
#
# Only variables that are meaningful across sessions are captured:
#   - A built-in allow-list of common HPC / ML / Python variables.
#   - Any variable whose name starts with CV_USER_ (a namespace reserved
#     for users to opt in arbitrary variables they want persisted).
# Variables that are inherently session- or scratch-specific (PATH,
# VIRTUAL_ENV, CONDA_PREFIX, CV_JOB_SCRATCH, _CV_*, etc.) are excluded.
local venv_dir="$1"
local venv_subdir="${2:-}"
local env_file="${venv_dir}${venv_subdir}/.cvenv-envvars.sh"

mkdir -p "$(dirname "$env_file")" 2>/dev/null || return 0

# Built-in allow-list of variables to persist.
local _cv_env_allow="\
ACCELERATE_USE_DISTRIBUTED\
ACCELERATE_LOG_LEVEL\
AWKWARD_CUDA_BUILD\
CUDA_CACHE_DISABLE\
CUDA_DEVICE_ORDER\
CUDA_LAUNCH_BLOCKING\
CUDA_MODULE_LOADING\
CUDA_VISIBLE_DEVICES\
CUBLAS_WORKSPACE_CONFIG\
CURL_CA_BUNDLE\
DATASETS_CACHE\
DATASETS_OFFLINE\
DIFFUSERS_CACHE\
HF_DATASETS_CACHE\
HF_DATASETS_OFFLINE\
HF_HOME\
HF_HUB_CACHE\
HF_HUB_DISABLE_PROGRESS_BARS\
HF_HUB_DISABLE_TELEMETRY\
HF_HUB_OFFLINE\
HF_TOKEN\
HUGGINGFACE_HUB_CACHE\
HUGGINGFACE_OFFLINE\
JAX_PLATFORMS\
JAX_PLATFORM_NAME\
KERAS_BACKEND\
LD_PRELOAD\
LOCALSCRATCH\
MKL_NUM_THREADS\
NCCL_ASYNC_ERROR_HANDLING\
NCCL_BLOCKING_WAIT\
NCCL_DEBUG\
NCCL_IB_DISABLE\
NCCL_IB_GID_INDEX\
NCCL_IB_HCA\
NCCL_IB_TIMEOUT\
NCCL_IB_RETRY_CNT\
NCCL_NET\
NCCL_NET_GDR_LEVEL\
NCCL_P2P_DISABLE\
NCCL_P2P_LEVEL\
NCCL_SHM_DISABLE\
NCCL_SOCKET_IFNAME\
NCCL_SOCKET_NTHREADS\
NCCL_BUFFSIZE\
NCCL_NCHANNELS\
NCCL_MIN_NCHANNELS\
NCCL_MAX_NCHANNELS\
NCCL_NSOCKS_PERTHREAD\
NCCL_SOCKET_FAMILY\
NCCL_SYSUUID\
NEURON_RT_NUM_CORES\
NEURON_RT_CORE_FRACTION\
NEURON_RT_STABLE_MEM\
NEURON_RT_ASYNC_EXEC_MAX_INFLIGHT\
OMP_NUM_THREADS\
OMP_PROC_BIND\
OMP_PLACES\
OPENBLAS_NUM_THREADS\
POPLAR_ENGINE_OPTIONS\
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION\
PYTORCH_CUDA_ALLOC_CONF\
PYTORCH_JIT\
PYTHONBREAKPOINT\
PYTHONCASEOK\
PYTHONHASHSEED\
PYTHONIOENCODING\
PYTHONMALLOC\
PYTHONNOUSERSITE\
PKG_CONFIG_PATH\
PYTHONPATH\
PYTHONSTARTUP\
PYTHONUNBUFFERED\
RAY_ADDRESS\
RAY_HEAD_NODE_PORT\
RAY_NUM_CPUS\
RAY_OBJECT_STORE_MEMORY\
REQUESTS_CA_BUNDLE\
SDL_AUDIODRIVER\
SLURM_CPUS_PER_TASK\
TOKENIZERS_PARALLELISM\
TORCHINDUCTOR_CACHE_DIR\
TORCHINDUCTOR_COMPILE_THREADS\
TORCHINDUCTOR_MAX_AUTOTUNE\
TORCHINDUCTOR_MAX_AUTOTUNE_GEMM\
TORCHINDUCTOR_AUTOTUNE_ATTN\
TORCHINDUCTOR_FORCE_FALLBACK_CUDNN\
TORCHINDUCTOR_FX_GRAPH_CACHE\
TORCHINDUCTOR_LOCAL_SCALAR_NUMEXPR\
TORCHINDUCTOR_TRITON_MAX_MMA\
TORCHINDUCTOR_TRITON_MAX_K\
TORCHINDUCTOR_TRITON_TILE_LIMIT\
TORCHINDUCTOR_BENCHMARK_EAGER\
TORCHDYNAMO_DISABLE\
TORCH_LOG_TARGET\
TRANSFORMERS_CACHE\
TRANSFORMERS_OFFLINE\
UV_HTTP_TIMEOUT\
UV_INDEX_URL\
UV_EXTRA_INDEX_URL\
UV_NO_CACHE\
UV_PYTHON\
UV_PRERELEASE\
XLA_FLAGS\
XLA_PYTHON_CLIENT_ALLOCATOR\
XLA_PYTHON_CLIENT_MEM_FRACTION\
XLA_PYTHON_CLIENT_PREALLOCATE\
XLA_PYTHON_CLIENT_DEVICE_ORDER\
XLA_PYTHON_CLIENT_DEBUG_RAM_PROBLEMS\
XLA_PYTHON_CLIENT_DONT_USE_MEGASTREAM\
"

{
    printf '# Auto-generated by cvenv.  Do not edit.\n'
    printf '# Environment variable snapshot saved on %s.\n' "$(date 2>/dev/null || echo unknown)"

    local _cv_var _cv_val
    # Save allow-listed variables that are actually set.
    for _cv_var in $_cv_env_allow; do
        eval "local _cv_val=\"\${${_cv_var}:-}\""
        if [ -n "$_cv_val" ]; then
            printf "export %s=%s\n" "$_cv_var" "$(printf '%q' "$_cv_val")"
        fi
    done

    # Save any CV_USER_* variables.
    local _cv_uvar
    for _cv_uvar in $(compgen -v 2>/dev/null | grep '^CV_USER_' || true); do
        eval "local _cv_uval=\"\${${_cv_uvar}:-}\""
        if [ -n "$_cv_uval" ]; then
            printf "export %s=%s\n" "$_cv_uvar" "$(printf '%q' "$_cv_uval")"
        fi
    done
} > "$env_file" 2>/dev/null || {
    _cv_log "WARNING: could not write env-var snapshot: $env_file"
    return 0
}
]==], "")

set_shell_function("_cv_restore_env_vars", [==[
# Source the env-var snapshot file (if present) to restore variables that
# were saved when the venv was last compressed.  Called after decompression
# and after activation so the restored values are available immediately.
#
# Variables that are already set in the current shell take precedence:
# the snapshot only fills in variables that are unset or empty, so a user
# can override a saved value by exporting it before activating.
local venv_dir="$1"
local venv_subdir="${2:-}"
local env_file="${venv_dir}${venv_subdir}/.cvenv-envvars.sh"

[ -f "$env_file" ] || return 0

# Read the file line by line and only apply exports for variables that
# are not already set, so the current environment wins.
local _cv_line _cv_name _cv_rest
while IFS= read -r _cv_line || [ -n "$_cv_line" ]; do
    case "$_cv_line" in
        ''|\#*) continue ;;
        export\ *)
            _cv_rest="${_cv_line#export }"
            _cv_name="${_cv_rest%%=*}"
            # Only restore if not already set.
            eval "local _cv_current=\"\${${_cv_name}:-}\""
            if [ -z "$_cv_current" ]; then
                eval "$_cv_line"
            fi
            ;;
    esac
done < "$env_file"
]==], "")

set_shell_function("_cv_write_dummy_activate", [==[
# After deactivation, leave a stub <venv>/bin/activate so that
# "source myvenv/bin/activate" works the same as in a standard Python
# venv, even though the expanded environment has been archived and
# removed from scratch.  The stub is a minimal placeholder; the cvenv
# "source" wrapper detects it (via the CVENV_STUB marker) and runs the
# full decompress -> activate -> propagate flow as if the file did not
# exist.
local venv_name="$1"
local archive_dir="$2"
local link_path="$3"
local venv_subdir="${4:-}"
local activate_path="${link_path}${venv_subdir}/bin/activate"

# Only the writer node creates the stub.
[ "${CV_IS_WRITER:-1}" = "1" ] || return 0

# Don't create a stub if there's no archive to restore from.
local tarball="${archive_dir}/${venv_name}${CV_BACKEND_EXT}"
[ -f "$tarball" ] || return 0

mkdir -p "$(dirname "$activate_path")" 2>/dev/null || return 0

cat > "$activate_path" <<'STUB'
# CVENV_STUB
# This is a placeholder generated by cvenv.  The real venv has been
# archived. If the cvenv
# module is not loaded, load it first:
#   module load cvenv
#   source <venv>/bin/activate
STUB
chmod +x "$activate_path" 2>/dev/null || true
]==], "")

set_shell_function("_cv_augment_ld_path", [==[
# Save the current LD_LIBRARY_PATH and append CRAY_LD_LIBRARY_PATH (and
# optionally an extra path such as $CONDA_PREFIX/lib for conda envs) so
# that Python extensions can dlopen Cray MPI/accelerator libraries at
# runtime.  On Cray systems CRAY_LD_LIBRARY_PATH is maintained by the
# module system but is not automatically merged into LD_LIBRARY_PATH for
# dynamically-linked payloads.
#
local _extra="${1:-}"
if [ -z "${_CV_LD_LIBRARY_PATH_BACKUP+x}" ]; then
    _CV_LD_LIBRARY_PATH_BACKUP="${LD_LIBRARY_PATH:-}"
fi
if [ -z "${_CV_PKG_CONFIG_PATH_BACKUP+x}" ]; then
    _CV_PKG_CONFIG_PATH_BACKUP="${PKG_CONFIG_PATH:-}"
fi
if [ -n "${CRAY_LD_LIBRARY_PATH:-}" ]; then
    case ":${LD_LIBRARY_PATH:-}:" in
        *":$CRAY_LD_LIBRARY_PATH:"*) ;;
        *)
            if [ -n "${LD_LIBRARY_PATH:-}" ]; then
                LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$CRAY_LD_LIBRARY_PATH"
            else
                LD_LIBRARY_PATH="$CRAY_LD_LIBRARY_PATH"
            fi
            ;;
    esac
fi
if [ -n "$_extra" ]; then
    case ":${LD_LIBRARY_PATH:-}:" in
        *":$_extra:"*) ;;
        *)
            if [ -n "${LD_LIBRARY_PATH:-}" ]; then
                LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$_extra"
            else
                LD_LIBRARY_PATH="$_extra"
            fi
            ;;
    esac
fi
[ -n "${LD_LIBRARY_PATH:-}" ] && export LD_LIBRARY_PATH

# Also add the corresponding pkgconfig directory to PKG_CONFIG_PATH so
# that pkg-config can find .pc files installed in the conda env / venv.
local _pkg_cfg=""
if [ -n "$_extra" ] && [ -d "${_extra}/pkgconfig" ]; then
    _pkg_cfg="${_extra}/pkgconfig"
elif [ -n "${_CV_ACTIVE_DIR:-}" ]; then
    local _pc_dir
    for _pc_dir in "${_CV_ACTIVE_DIR}${_CV_ACTIVE_VENV_SUBDIR:-}/lib/pkgconfig" \
                   "${_CV_ACTIVE_DIR}/lib/pkgconfig"; do
        if [ -d "$_pc_dir" ]; then
            _pkg_cfg="$_pc_dir"
            break
        fi
    done
fi
if [ -n "$_pkg_cfg" ]; then
    case ":${PKG_CONFIG_PATH:-}:" in
        *":$_pkg_cfg:"*) ;;
        *)
            if [ -n "${PKG_CONFIG_PATH:-}" ]; then
                PKG_CONFIG_PATH="$_pkg_cfg:$PKG_CONFIG_PATH"
            else
                PKG_CONFIG_PATH="$_pkg_cfg"
            fi
            export PKG_CONFIG_PATH
            ;;
    esac
fi
]==], "")

set_shell_function("_cv_restore_ld_path", [==[
# Restore LD_LIBRARY_PATH and PKG_CONFIG_PATH to their pre-activation state.
if [ -n "${_CV_LD_LIBRARY_PATH_BACKUP+x}" ]; then
    if [ -n "$_CV_LD_LIBRARY_PATH_BACKUP" ]; then
        LD_LIBRARY_PATH="$_CV_LD_LIBRARY_PATH_BACKUP"
        export LD_LIBRARY_PATH
    else
        unset LD_LIBRARY_PATH
    fi
    unset _CV_LD_LIBRARY_PATH_BACKUP
fi
if [ -n "${_CV_PKG_CONFIG_PATH_BACKUP+x}" ]; then
    if [ -n "$_CV_PKG_CONFIG_PATH_BACKUP" ]; then
        PKG_CONFIG_PATH="$_CV_PKG_CONFIG_PATH_BACKUP"
        export PKG_CONFIG_PATH
    else
        unset PKG_CONFIG_PATH
    fi
    unset _CV_PKG_CONFIG_PATH_BACKUP
fi
]==], "")

set_shell_function("_cv_inject_ld_path", [==[
# Inject CRAY_LD_LIBRARY_PATH merging into a venv's bin/activate script.
# This is a belt-and-suspenders approach: even if the cvenv "source" shell
# function is not invoked (e.g. the user runs ". env/bin/activate" or the
local venv_dir="$1"
local venv_subdir="${2:-}"
local activate="${venv_dir}${venv_subdir}/bin/activate"

[ -f "$activate" ] || return 0

# Skip if already injected.
if grep -q 'CV_CRAY_LD_INJECTED' "$activate" 2>/dev/null; then
    return 0
fi

chmod u+w "$activate" 2>/dev/null || true

# Build the injection block.  We use a temp file and sed to insert it
# after the "export PATH" line in the activate script.
local _cv_inject_tmp
_cv_inject_tmp=$(mktemp) || return 0
cat > "$_cv_inject_tmp" <<'CVINJECT'
# CV_CRAY_LD_INJECTED
# --- cvenv: merge CRAY_LD_LIBRARY_PATH into LD_LIBRARY_PATH ---
if [ -n "${CRAY_LD_LIBRARY_PATH:-}" ]; then
    _CV_OLD_LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"
    case ":${LD_LIBRARY_PATH:-}:" in
        *":${CRAY_LD_LIBRARY_PATH}:"*) ;;
        *)
            if [ -n "${LD_LIBRARY_PATH:-}" ]; then
                LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:${CRAY_LD_LIBRARY_PATH}"
            else
                LD_LIBRARY_PATH="${CRAY_LD_LIBRARY_PATH}"
            fi
            export LD_LIBRARY_PATH
            ;;
    esac
fi
# --- cvenv: add venv lib/pkgconfig to PKG_CONFIG_PATH ---
_CV_VENV_PKGCFG="${VIRTUAL_ENV:-}/lib/pkgconfig"
if [ -d "$_CV_VENV_PKGCFG" ]; then
    _CV_OLD_PKG_CONFIG_PATH="${PKG_CONFIG_PATH:-}"
    case ":${PKG_CONFIG_PATH:-}:" in
        *":${_CV_VENV_PKGCFG}:"*) ;;
        *)
            if [ -n "${PKG_CONFIG_PATH:-}" ]; then
                PKG_CONFIG_PATH="${_CV_VENV_PKGCFG}:${PKG_CONFIG_PATH}"
            else
                PKG_CONFIG_PATH="${_CV_VENV_PKGCFG}"
            fi
            export PKG_CONFIG_PATH
            ;;
    esac
fi
# --- end cvenv ---
CVINJECT

# Insert the injection block after the first "export PATH" line.
local _cv_activate_tmp
_cv_activate_tmp=$(mktemp) || { rm -f "$_cv_inject_tmp"; return 0; }

# Try to insert after "export PATH" (standard venv activate).
if grep -q '^export PATH$' "$activate" 2>/dev/null; then
    sed '/^export PATH$/r '"$_cv_inject_tmp" "$activate" > "$_cv_activate_tmp"
elif grep -q '^export VIRTUAL_ENV$' "$activate" 2>/dev/null; then
    # Fallback: insert after "export VIRTUAL_ENV".
    sed '/^export VIRTUAL_ENV$/r '"$_cv_inject_tmp" "$activate" > "$_cv_activate_tmp"
else
    # Last resort: append at end of file.
    cat "$activate" "$_cv_inject_tmp" > "$_cv_activate_tmp"
fi

# Now inject the restore block into the deactivate function.
# Insert it right before "unset -f deactivate" inside deactivate().
if grep -q 'unset -f deactivate' "$_cv_activate_tmp" 2>/dev/null; then
    local _cv_restore_tmp
    _cv_restore_tmp=$(mktemp) || { rm -f "$_cv_inject_tmp" "$_cv_activate_tmp"; return 0; }
    cat > "$_cv_restore_tmp" <<'CVRESTORE'
    # --- cvenv: restore LD_LIBRARY_PATH ---
    if [ -n "${_CV_OLD_LD_LIBRARY_PATH+x}" ]; then
        if [ -n "$_CV_OLD_LD_LIBRARY_PATH" ]; then
            LD_LIBRARY_PATH="$_CV_OLD_LD_LIBRARY_PATH"
            export LD_LIBRARY_PATH
        else
            unset LD_LIBRARY_PATH
        fi
        unset _CV_OLD_LD_LIBRARY_PATH
    fi
    # --- cvenv: restore PKG_CONFIG_PATH ---
    if [ -n "${_CV_OLD_PKG_CONFIG_PATH+x}" ]; then
        if [ -n "$_CV_OLD_PKG_CONFIG_PATH" ]; then
            PKG_CONFIG_PATH="$_CV_OLD_PKG_CONFIG_PATH"
            export PKG_CONFIG_PATH
        else
            unset PKG_CONFIG_PATH
        fi
        unset _CV_OLD_PKG_CONFIG_PATH
    fi
    # --- end cvenv ---
CVRESTORE
    sed '/unset -f deactivate/r '"$_cv_restore_tmp" "$_cv_activate_tmp" > "$_cv_inject_tmp"
    mv "$_cv_inject_tmp" "$activate"
    rm -f "$_cv_restore_tmp"
else
    mv "$_cv_activate_tmp" "$activate"
fi

rm -f "$_cv_inject_tmp" "$_cv_activate_tmp"
]==], "")



set_shell_function("_cv_patch_nccl", [==[
# Patch RPATH/RUNPATH of .so files that depend on libnccl so they find
# the NCCL library from the module-provided LD_LIBRARY_PATH at runtime.
# Called after pip/uv install, before compression.
local venv_dir="$1"
local venv_subdir="${2:-}"

# Only run if patchelf is available.
command -v patchelf >/dev/null 2>&1 || return 0

# Only run if LD_LIBRARY_PATH contains libnccl.
local nccl_lib_dir=""
local IFS=:
local dir
for dir in ${LD_LIBRARY_PATH:-}; do
    [ -z "$dir" ] && dir="."
    if compgen -G "$dir/libnccl.so*" > /dev/null 2>&1; then
        nccl_lib_dir="$dir"
        break
    fi
done
[ -n "$nccl_lib_dir" ] || return 0

local site_packages="${venv_dir}${venv_subdir}/lib/python"*/site-packages
[ -d "$site_packages" ] 2>/dev/null || {
    # Glob might not have expanded; try explicit search.
    site_packages=$(find "${venv_dir}${venv_subdir}/lib" -type d -name site-packages 2>/dev/null | head -1)
}
[ -n "$site_packages" ] || return 0

#_cv_log "Patching NCCL RPATH in $site_packages (NCCL from $nccl_lib_dir)"

local f
while IFS= read -r -d '' f; do
    # Only patch .so files that actually depend on libnccl.so*.
    if ! readelf -d "$f" 2>/dev/null | \
        grep -qE 'Shared library: \[libnccl\.so(\.[^]]+)?\]'; then
        continue
    fi

    local old_rpath
    old_rpath=$(
        readelf -d "$f" 2>/dev/null | \
        sed -n 's/.*\(RPATH\|RUNPATH\).*: \[\(.*\)\]/\2/p'
    )

    local new_rpath
    if [ -n "$old_rpath" ]; then
        new_rpath="$nccl_lib_dir:$old_rpath"
    else
        new_rpath="$nccl_lib_dir"
    fi

    _cv_log "  Patching: $(basename "$f")  RPATH: $new_rpath"
    patchelf --set-rpath "$new_rpath" "$f" 2>/dev/null || \
        _cv_log "  WARNING: patchelf failed on $f"
done < <(find "$site_packages" -type f \( -name '*.so' -o -name '*.so.*' \) -print0 2>/dev/null)
]==], "")

set_shell_function("_cv_write_readme", [==[
# Write a README file next to the archive so the user knows which Lmod
# modules were loaded when the venv was created/last modified, and how
# to reload them before reactivating the environment.
local venv_name="$1"
local archive_dir="${2:-$(_cv_archive_dir)}"
local readme="${archive_dir}/${venv_name}.README.md"

# Only the writer node should write the README.
[ "${CV_IS_WRITER:-1}" = "1" ] || return 0

mkdir -p "$archive_dir" 2>/dev/null || return 0

# Collect loaded Lmod modules from the environment.
local loaded_modules="${LOADEDMODULES:-}"
local module_files="${_LMFILES_:-}"
local has_modules=0
local module_lines=""
if [ -n "$loaded_modules" ]; then
    has_modules=1
    local IFS=':'
    local mod
    for mod in $loaded_modules; do
        [ -n "$mod" ] || continue
        module_lines="${module_lines}module load ${mod}\n"
    done
    unset IFS
fi

# Determine the backend type and venv subdirectory for the instructions.
# Use multiple signals: _CV_ACTIVE_* variables from activation, CONDA_PREFIX
# for an active conda env, and filesystem inspection for initial creation.
local backend_type="python venv"
local venv_subdir="${_CV_ACTIVE_VENV_SUBDIR:-}"
local venv_base="${CV_JOB_SCRATCH:-}/${venv_name}"

# Conda environments are identified by the conda-meta/ directory, which
# every conda env contains regardless of whether bin/conda is present
# (prefix-based envs may lack bin/conda).  Also check CONDA_PREFIX for an
# active conda env, and the _CV_ACTIVE_DIR as a last resort.
local _cv_is_conda=0
if [ -d "${venv_base}/conda-meta" ]; then
    _cv_is_conda=1
elif [ -n "${CONDA_PREFIX:-}" ] && [ "${CONDA_PREFIX:-}" = "${venv_base}" ]; then
    _cv_is_conda=1
elif [ -n "${_CV_ACTIVE_DIR:-}" ] && [ -d "${_CV_ACTIVE_DIR}/conda-meta" ]; then
    _cv_is_conda=1
fi

if [ "$_cv_is_conda" = "1" ]; then
    backend_type="conda environment"
    venv_subdir=""
elif [ -n "${CV_UV:-}" ]; then
    # uv init creates a project directory with a .venv subdirectory.
    if [ -f "${venv_base}/pyproject.toml" ] && [ -d "${venv_base}/.venv" ]; then
        backend_type="uv project"
        venv_subdir="/.venv"
    # uv venv creates a bare .venv (venv_name would be ".venv").
    elif [ "$venv_name" = ".venv" ] && [ -d "${venv_base}" ]; then
        backend_type="uv venv"
        venv_subdir=""
    fi
fi

_cv_log "README detection: backend=${backend_type} venv_base=${venv_base} conda_prefix=${CONDA_PREFIX:-} active_dir=${_CV_ACTIVE_DIR:-} is_conda=${_cv_is_conda}"

# Build the activate command for the reactivation section.
local activate_cmd=""
if [ "$backend_type" = "conda environment" ]; then
    activate_cmd="conda activate ${venv_name}"
else
    if [ -n "$venv_subdir" ]; then
        activate_cmd="source ${venv_name}${venv_subdir}/bin/activate"
    else
        activate_cmd="source ${venv_name}/bin/activate"
    fi
fi

# Build the README content.
{
    printf '# %s\n\n' "$venv_name"
    printf 'This file was auto-generated by **cvenv**.\n'
    printf 'Those Lmod modules that were loaded when the %s was last saved,\n' "$backend_type"
    printf 'so you can reproduce the environment on reactivation.\n\n'

    printf '## Archive\n\n'
    printf -- '- Archive file: `%s%s`\n' "$venv_name" "${CV_BACKEND_EXT:-}"
    printf -- '- Archive directory: `%s`\n' "$archive_dir"
    printf -- '- Backend: %s\n' "$backend_type"
    printf -- '- Generated: %s\n' "$(date 2>/dev/null || echo unknown)"
    printf '\n'

    printf '## Loaded modules\n\n'
    if [ "$has_modules" = "1" ]; then
        printf 'The following Lmod modules were loaded when this %s was last saved:\n\n' "$backend_type"
        printf '```bash\n'
        printf '%b' "$module_lines"
        printf '```\n\n'
    else
        printf 'No Lmod modules were detected (LOADEDMODULES was unset).\n\n'
    fi

    printf '## Reactivation\n\n'
    printf 'To reactivate this %s in a new job:\n\n' "$backend_type"
    printf '```bash\n'
    if [ "$has_modules" = "1" ]; then
        printf '%b' "$module_lines"
    fi
    printf 'cd %s\n' "$archive_dir"
    printf '%s\n' "$activate_cmd"
    printf '```\n\n'

    printf '## Notes\n\n'
    printf -- '- Load the modules listed above **before** loading `cvenv` and activating the environment.\n'
    printf -- '- `module load cvenv` must precede activation so the cvenv wrapper functions are available.\n'
    printf -- '- Module versions must match (or be compatible with) those used when the environment was created.\n'
    printf -- '- Plain `srun` commands should work on every node.\n'
    printf -- '- Run `deactivate` (or `conda deactivate` for conda environments) before leaving the job to save any changes back to the archive.\n'
} > "$readme" 2>/dev/null || {
    _cv_log "WARNING: could not write README: $readme"
    return 0
}

_cv_log "Wrote README: $readme"
]==], "")

set_shell_function("_cv_compress_venv", [==[
local venv_dir="$1"
local archive_dir="${2:-$(_cv_archive_dir)}"
local venv_name tarball tmp rc

venv_name=$(basename "$venv_dir") || return 1
tarball="${archive_dir}/${venv_name}${CV_BACKEND_EXT}"
tmp="${tarball}.tmp.$$"

if [ ! -d "$venv_dir" ]; then
    _cv_log "ERROR: environment directory does not exist: $venv_dir"
    return 1
fi

# In multi-node allocations only the head node (SLURM_NODEID 0) may write
# the shared archive.  Non-writer nodes skip compression to avoid corrupting
# the archive with concurrent writes.
if [ "${CV_IS_WRITER:-1}" = "0" ]; then
    _cv_log "Read-only node (SLURM_NODEID!=0); skipping compression of $venv_name"
    return 0
fi

mkdir -p "$archive_dir" || return 1
printf '%s\n' "$venv_dir" > "$venv_dir/.cvenv-prefix"
_cv_save_env_vars "$venv_dir" ""
_cv_log "Compressing $venv_name -> $tarball"

set -o pipefail
tar -cf - -C "$(dirname "$venv_dir")" "$venv_name" \
    | eval "$CV_BACKEND_COMPRESS" > "$tmp"
rc=$?
set +o pipefail

if [ "$rc" -ne 0 ]; then
    _cv_log "ERROR: compression failed"
    rm -f "$tmp"
    return "$rc"
fi

mv -f "$tmp" "$tarball" || {
    rm -f "$tmp"
    return 1
}
_cv_log "Compression complete"
_cv_write_readme "$venv_name" "$archive_dir"
]==], "")

set_shell_function("_cv_relocate_venv", [==[
local target="$1"
local marker="$target/.cvenv-prefix"
local old_prefix file

[ -f "$marker" ] || return 0
old_prefix=$(cat "$marker")
[ -n "$old_prefix" ] || return 0
[ "$old_prefix" = "$target" ] && return 0

_cv_log "Relocating environment prefix: $old_prefix -> $target"

while IFS= read -r -d '' file; do
    # Files copied from a read-only software tree (venv --copies) may
    # retain read-only permissions; make them writable before rewriting.
    chmod u+w "$file" 2>/dev/null || true
    OLD_PREFIX="$old_prefix" NEW_PREFIX="$target" python3 - "$file" <<'PY'
import os
import pathlib
import sys

p = pathlib.Path(sys.argv[1])
data = p.read_bytes()
old = os.environ["OLD_PREFIX"].encode()
new = os.environ["NEW_PREFIX"].encode()
if old in data:
    p.write_bytes(data.replace(old, new))
PY
done < <(grep -IlZR -- "$old_prefix" "$target/bin" 2>/dev/null || true)

printf '%s\n' "$target" > "$marker"
]==], "")

set_shell_function("_cv_decompress_venv", [==[
local venv_name="$1"
local archive_dir="${2:-$(_cv_archive_dir)}"
local tarball="${archive_dir}/${venv_name}${CV_BACKEND_EXT}"
local target="${CV_JOB_SCRATCH}/${venv_name}"
local rc

# Detect an already-expanded environment.  venvs have bin/activate; conda
# envs have bin/conda (and bin/python) but may lack a venv-style activate.
if [ -d "$target" ] && { [ -f "$target/bin/activate" ] || [ -f "$target/bin/conda" ] || [ -f "$target/bin/python" ]; }; then
    _cv_log "$venv_name is already expanded at $target"
    _cv_relocate_venv "$target"
    _cv_restore_env_vars "$target" ""
    return $?
fi
if [ -d "$target" ]; then
    command rm -rf "$target"
fi
if [ ! -f "$tarball" ]; then
    _cv_log "ERROR: archive not found: $tarball"
    return 1
fi

mkdir -p "$CV_JOB_SCRATCH" || return 1
_cv_log "Decompressing $tarball -> $target"
set -o pipefail
eval "$CV_BACKEND_DECOMPRESS \"$tarball\"" | tar -xf - -C "$CV_JOB_SCRATCH"
rc=$?
set +o pipefail

if [ "$rc" -ne 0 ]; then
    _cv_log "ERROR: decompression failed"
    command rm -rf "$target"
    return "$rc"
fi

_cv_relocate_venv "$target" || return 1
_cv_inject_ld_path "$target"
_cv_restore_env_vars "$target" ""
_cv_log "Decompression complete"
]==], "")

set_shell_function("_cv_patch_deactivate", [==[
local venv_name="$1"
local venv_dir="$2"
local archive_dir="$3"
local link_path="$4"
local venv_subdir="${5:-}"

eval "$(declare -f deactivate | sed '1s/^deactivate[[:space:]]*()/_cv_venv_deactivate()/')"

_CV_ACTIVE_NAME="$venv_name"
_CV_ACTIVE_DIR="$venv_dir"
_CV_ACTIVE_ARCHIVE_DIR="$archive_dir"
_CV_ACTIVE_LINK="$link_path"
_CV_ACTIVE_VENV_SUBDIR="$venv_subdir"
export _CV_ACTIVE_NAME _CV_ACTIVE_DIR _CV_ACTIVE_ARCHIVE_DIR _CV_ACTIVE_LINK _CV_ACTIVE_VENV_SUBDIR

deactivate() {
    local rc=0
    if [ "${CVENV_RO:-0}" = "1" ]; then
        _cv_log "CVENV_RO set; skipping recompression for ${_CV_ACTIVE_NAME}"
    else
        _cv_log "Saving ${_CV_ACTIVE_NAME} before deactivation"
        _cv_compress_venv "$_CV_ACTIVE_DIR" "$_CV_ACTIVE_ARCHIVE_DIR" || rc=$?
        if [ "$rc" -ne 0 ]; then
            _cv_log "ERROR: archive was not updated; expanded environment was retained"
            return "$rc"
        fi
    fi

    [ -L "$_CV_ACTIVE_LINK" ] && command rm -f "$_CV_ACTIVE_LINK"
    _cv_venv_deactivate
    _cv_restore_ld_path
    unset -f _cv_venv_deactivate
    command rm -rf "$_CV_ACTIVE_DIR"
    _cv_scratch_cleanup
    _cv_write_dummy_activate "$_CV_ACTIVE_NAME" "$_CV_ACTIVE_ARCHIVE_DIR" "$_CV_ACTIVE_LINK" "$_CV_ACTIVE_VENV_SUBDIR"
    unset _CV_ACTIVE_NAME _CV_ACTIVE_DIR _CV_ACTIVE_ARCHIVE_DIR _CV_ACTIVE_LINK _CV_ACTIVE_VENV_SUBDIR
    unset _CV_AUTO_ACTIVATED
    unset CVENV_RO
    _cv_log "Environment archived and scratch copy removed"
}
]==], "")

set_shell_function("_cv_python_wrapper", [==[
local name="$1"
local fallback="$2"
shift 2

local interpreter
interpreter=$(type -P "$name" 2>/dev/null) || interpreter=""
[ -n "$interpreter" ] || interpreter="$fallback"
[ -n "$interpreter" ] || {
    _cv_log "ERROR: no '$name' interpreter available"
    return 127
}

if [ "${1:-}" = "-m" ] && [ "${2:-}" = "venv" ]; then
    shift 2
    if [ "$#" -lt 1 ]; then
        _cv_log "ERROR: no virtual-environment path specified"
        return 2
    fi

    local requested="${!#}"
    local venv_name target archive_dir tarball link_path
    venv_name=$(basename "${requested%/}")
    if [ -z "$venv_name" ] || [ "$venv_name" = "." ] || [ "$venv_name" = ".." ]; then
        _cv_log "ERROR: invalid environment path: $requested"
        return 2
    fi

    archive_dir=$(_cv_archive_dir) || return 1
    archive_dir=$(cd "$archive_dir" 2>/dev/null && pwd -P) || {
        _cv_log "ERROR: archive directory does not exist: $archive_dir"
        return 1
    }
    link_path="$PWD/$requested"
    tarball="${archive_dir}/${venv_name}${CV_BACKEND_EXT}"
    target="${CV_JOB_SCRATCH}/${venv_name}"

    if [ -e "$requested" ] && [ ! -L "$requested" ]; then
        _cv_log "ERROR: path already exists and is not a cvenv symlink: $requested"
        return 1
    fi

    if [ -f "$tarball" ]; then
        _cv_decompress_venv "$venv_name" "$archive_dir" || return 1
    else
        mkdir -p "$CV_JOB_SCRATCH" || return 1
        command rm -rf "$target"
        _cv_log "Creating environment in job scratch: $target"

        local -a args=("$@")
        unset 'args[${#args[@]}-1]'
        "$interpreter" -m venv --copies "${args[@]}" "$target" || {
            _cv_log "ERROR: virtual-environment creation failed"
            command rm -rf "$target"
            return 1
        }
        printf '%s\n' "$target" > "$target/.cvenv-prefix"
    fi

    _cv_patch_nccl "$target" ""
    _cv_inject_ld_path "$target" ""
    mkdir -p "$(dirname "$link_path")" || return 1
    ln -sfn "$target" "$link_path" || return 1
    _cv_compress_venv "$target" "$archive_dir" || _cv_log "WARNING: initial compression failed; will retry on deactivate"
    _cv_log "Ready: $requested -> $target"
    _cv_log "Run: source $requested/bin/activate"
    return 0
fi

if [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/$name" ]; then
    "$VIRTUAL_ENV/bin/$name" "$@"
elif [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
    "$VIRTUAL_ENV/bin/python" "$@"
elif [ -n "${CONDA_PREFIX:-}" ] && [ -x "$CONDA_PREFIX/bin/$name" ]; then
    "$CONDA_PREFIX/bin/$name" "$@"
elif [ -n "${CONDA_PREFIX:-}" ] && [ -x "$CONDA_PREFIX/bin/python" ]; then
    "$CONDA_PREFIX/bin/python" "$@"
else
    "$interpreter" "$@"
fi
]==], "")

set_shell_function("python", [==[
_cv_python_wrapper "python" "$CV_ORIGINAL_PYTHON" "$@"
]==], "")

set_shell_function("python3", [==[
_cv_python_wrapper "python3" "$CV_ORIGINAL_PYTHON3" "$@"
]==], "")


-- conda: create a named environment in scratch.
set_shell_function("_cv_conda_create", [==[
local requested="$1"
shift

if [ -z "$requested" ]; then
    _cv_log "ERROR: no environment name specified"
    return 2
fi

local venv_name target archive_dir tarball link_path
venv_name=$(basename "${requested%/}")
if [ -z "$venv_name" ] || [ "$venv_name" = "." ] || [ "$venv_name" = ".." ]; then
    _cv_log "ERROR: invalid environment name: $requested"
    return 2
fi

archive_dir=$(_cv_archive_dir) || return 1
archive_dir=$(cd "$archive_dir" 2>/dev/null && pwd -P) || {
    _cv_log "ERROR: archive directory does not exist: $archive_dir"
    return 1
}
link_path="$PWD/$venv_name"
tarball="${archive_dir}/${venv_name}${CV_BACKEND_EXT}"
target="${CV_JOB_SCRATCH}/${venv_name}"

if [ -e "$venv_name" ] && [ ! -L "$venv_name" ]; then
    _cv_log "ERROR: path already exists and is not a cvenv symlink: $venv_name"
    return 1
fi

if [ -f "$tarball" ]; then
    _cv_decompress_venv "$venv_name" "$archive_dir" || return 1
else
    mkdir -p "$CV_JOB_SCRATCH" || return 1
    command rm -rf "$target"
    _cv_log "Creating conda environment in job scratch: $target"
    "$CV_CONDA" create --prefix "$target" "$@" -y || {
        _cv_log "ERROR: conda create failed"
        command rm -rf "$target"
        return 1
    }
    printf '%s\n' "$target" > "$target/.cvenv-prefix"
fi

_cv_patch_nccl "$target" ""
mkdir -p "$(dirname "$link_path")" || return 1
ln -sfn "$target" "$link_path" || return 1
_cv_compress_venv "$target" "$archive_dir" || _cv_log "WARNING: initial compression failed; will retry on deactivate"
_cv_log "Ready: $venv_name -> $target"
_cv_log "Run: conda activate $venv_name"
return 0
]==], "")

-- conda: create an environment from environment.yml in scratch.
set_shell_function("_cv_conda_env_create", [==[
local env_file=""
local requested=""
local -a passthrough=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        -f|--file)
            shift
            env_file="${1:-}"
            ;;
        -n|--name)
            shift
            requested="${1:-}"
            ;;
        -p|--prefix)
            shift
            requested="${1:-}"
            ;;
        -*)
            passthrough+=("$1")
            ;;
        *)
            if [ -z "$env_file" ] && [ -f "$1" ]; then
                env_file="$1"
            elif [ -z "$requested" ]; then
                requested="$1"
            else
                passthrough+=("$1")
            fi
            ;;
    esac
    shift
done

if [ -z "$env_file" ]; then
    env_file="environment.yml"
fi
if [ ! -f "$env_file" ]; then
    _cv_log "ERROR: environment file not found: $env_file"
    return 1
fi

# Derive the environment name: -n/--name wins, then the name field in the
# YAML file, then the basename of the file (without extension).
if [ -z "$requested" ]; then
    requested=$(grep -E '^[[:space:]]*name:' "$env_file" 2>/dev/null | head -1 | sed 's/^[[:space:]]*name:[[:space:]]*//; s/[[:space:]]*$//; s/^"\(.*\)"$/\1/; s/^'\''\(.*\)'\''$/\1/')
fi
if [ -z "$requested" ]; then
    requested=$(basename "$env_file")
    requested="${requested%.*}"
fi

local venv_name target archive_dir tarball link_path
venv_name=$(basename "${requested%/}")
if [ -z "$venv_name" ] || [ "$venv_name" = "." ] || [ "$venv_name" = ".." ]; then
    _cv_log "ERROR: invalid environment name: $requested"
    return 2
fi

archive_dir=$(_cv_archive_dir) || return 1
archive_dir=$(cd "$archive_dir" 2>/dev/null && pwd -P) || {
    _cv_log "ERROR: archive directory does not exist: $archive_dir"
    return 1
}
link_path="$PWD/$venv_name"
tarball="${archive_dir}/${venv_name}${CV_BACKEND_EXT}"
target="${CV_JOB_SCRATCH}/${venv_name}"

if [ -e "$venv_name" ] && [ ! -L "$venv_name" ]; then
    _cv_log "ERROR: path already exists and is not a cvenv symlink: $venv_name"
    return 1
fi

if [ -f "$tarball" ]; then
    _cv_decompress_venv "$venv_name" "$archive_dir" || return 1
else
    mkdir -p "$CV_JOB_SCRATCH" || return 1
    command rm -rf "$target"
    _cv_log "Creating conda environment from $env_file in job scratch: $target"
    "$CV_CONDA" env create -f "$env_file" --prefix "$target" "${passthrough[@]}" -y || {
        _cv_log "ERROR: conda env create failed"
        command rm -rf "$target"
        return 1
    }
    printf '%s\n' "$target" > "$target/.cvenv-prefix"
fi

_cv_patch_nccl "$target" ""
mkdir -p "$(dirname "$link_path")" || return 1
ln -sfn "$target" "$link_path" || return 1
_cv_compress_venv "$target" "$archive_dir" || _cv_log "WARNING: initial compression failed; will retry on deactivate"
_cv_log "Ready: $venv_name -> $target"
_cv_log "Run: conda activate $venv_name"
return 0
]==], "")

-- conda: patch conda's deactivate so it archives the environment.
set_shell_function("_cv_conda_patch_deactivate", [==[
local venv_name="$1"
local venv_dir="$2"
local archive_dir="$3"
local link_path="$4"

_CV_ACTIVE_NAME="$venv_name"
_CV_ACTIVE_DIR="$venv_dir"
_CV_ACTIVE_ARCHIVE_DIR="$archive_dir"
_CV_ACTIVE_LINK="$link_path"
_CV_ACTIVE_VENV_SUBDIR=""
export _CV_ACTIVE_NAME _CV_ACTIVE_DIR _CV_ACTIVE_ARCHIVE_DIR _CV_ACTIVE_LINK _CV_ACTIVE_VENV_SUBDIR

# Override the shell-level deactivate function.  When the user runs
# "conda deactivate", the cvenv conda wrapper calls this function directly.
# It archives the environment, then runs "conda shell.bash deactivate" to
# let conda clean up its own env vars (CONDA_PREFIX, PATH, etc.).
deactivate() {
    local rc=0
    if [ "${CVENV_RO:-0}" = "1" ]; then
        _cv_log "CVENV_RO set; skipping recompression for ${_CV_ACTIVE_NAME}"
    else
        _cv_log "Saving ${_CV_ACTIVE_NAME} before deactivation"
        _cv_compress_venv "$_CV_ACTIVE_DIR" "$_CV_ACTIVE_ARCHIVE_DIR" || rc=$?
        if [ "$rc" -ne 0 ]; then
            _cv_log "ERROR: archive was not updated; expanded environment was retained"
            return "$rc"
        fi
    fi

    [ -L "$_CV_ACTIVE_LINK" ] && command rm -f "$_CV_ACTIVE_LINK"

    # Let conda clean up its own environment variables.
    eval "$("$CV_CONDA" shell.bash deactivate)"

    # Restore PS1 in case conda's deactivate lost it.
    if [ -n "${_CV_PS1_BACKUP+x}" ]; then
        PS1="$_CV_PS1_BACKUP"
        export PS1
        unset _CV_PS1_BACKUP
    fi

    # Restore LD_LIBRARY_PATH to its pre-activation state.
    _cv_restore_ld_path

    command rm -rf "$_CV_ACTIVE_DIR"
    _cv_scratch_cleanup
    _cv_write_dummy_activate "$_CV_ACTIVE_NAME" "$_CV_ACTIVE_ARCHIVE_DIR" "$_CV_ACTIVE_LINK" ""
    unset _CV_ACTIVE_NAME _CV_ACTIVE_DIR _CV_ACTIVE_ARCHIVE_DIR _CV_ACTIVE_LINK _CV_ACTIVE_VENV_SUBDIR
    unset _CV_AUTO_ACTIVATED
    unset CVENV_RO
    _cv_log "Environment archived and scratch copy removed"
}
]==], "")

-- conda: main wrapper.
set_shell_function("conda", [==[
# Locate conda if not detected at module load time.
if [ -z "${CV_CONDA:-}" ]; then
    CV_CONDA=$(type -P conda 2>/dev/null)
    if [ -z "$CV_CONDA" ]; then
        _cv_log "ERROR: conda is not available"
        return 127
    fi
fi

# Activation/deactivation uses "conda shell.bash activate/deactivate"
# (the binary, not the shell function) to avoid infinite recursion.
# Other subcommands are passed to the conda binary directly.
local _cv_conda_cmd="${1:-}"

case "$_cv_conda_cmd" in
    create)
        shift
        local requested=""
        local -a passthrough=()
        while [ "$#" -gt 0 ]; do
            case "$1" in
                -n|--name)
                    shift
                    requested="${1:-}"
                    ;;
                -p|--prefix)
                    shift
                    requested="${1:-}"
                    ;;
                -*)
                    passthrough+=("$1")
                    ;;
                *)
                    if [ -z "$requested" ]; then
                        requested="$1"
                    else
                        passthrough+=("$1")
                    fi
                    ;;
            esac
            shift
        done
        if [ -z "$requested" ]; then
            _cv_log "ERROR: conda create requires an environment name (-n/--name)"
            return 2
        fi
        _cv_conda_create "$requested" "${passthrough[@]}"
        return $?
        ;;
    env)
        local _cv_conda_subcmd="${2:-}"
        case "$_cv_conda_subcmd" in
            create)
                shift 2
                _cv_conda_env_create "$@"
                return $?
                ;;
            *)
                "$CV_CONDA" "$@"
                return $?
                ;;
        esac
        ;;
    activate)
        shift
        local requested="${1:-}"
        if [ -z "$requested" ]; then
            _cv_log "ERROR: conda activate requires an environment name"
            return 2
        fi
        local venv_name archive_dir target tarball link_path
        venv_name=$(basename "${requested%/}")
        archive_dir=$(_cv_archive_dir) || return 1
        archive_dir=$(cd "$archive_dir" 2>/dev/null && pwd -P) || return 1
        target="${CV_JOB_SCRATCH}/${venv_name}"
        link_path="$PWD/$venv_name"
        tarball="${archive_dir}/${venv_name}${CV_BACKEND_EXT}"

        # If a stale symlink exists (target is truly dead), remove it so we
        # can decompress/relink fresh.
        if [ -L "$requested" ]; then
            local _cv_link_target
            _cv_link_target=$(readlink -f "$requested" 2>/dev/null) || _cv_link_target=""
            if [ -z "$_cv_link_target" ] || [ ! -d "$_cv_link_target" ]; then
                _cv_log "Removing stale symlink: $requested -> $(readlink "$requested" 2>/dev/null)"
                command rm -f "$requested"
            fi
        fi

        # A conda environment is recognised by bin/conda or bin/python.
        # Remove a stub directory left by a previous deactivation.
        if [ -d "$link_path" ] && [ ! -L "$link_path" ] && \
            [ -f "${link_path}/bin/activate" ] && \
            grep -q 'CVENV_STUB' "${link_path}/bin/activate" 2>/dev/null; then
            command rm -rf "$link_path"
        fi
        if [ -d "$target" ] && { [ -f "$target/bin/conda" ] || [ -f "$target/bin/python" ]; }; then
            mkdir -p "$(dirname "$link_path")" || return 1
            ln -sfn "$target" "$link_path" || return 1
        elif [ -f "$tarball" ]; then
            _cv_decompress_venv "$venv_name" "$archive_dir" || return 1
            mkdir -p "$(dirname "$link_path")" || return 1
            ln -sfn "$target" "$link_path" || return 1
        else
            _cv_log "ERROR: no archive or scratch environment found for $venv_name"
            _cv_log "       looked for: $tarball"
            _cv_log "       and scratch: $target"
            return 1
        fi

        # Propagate the environment to all nodes in the allocation so that
        # plain "srun <cmd>" works on every node.
        _cv_propagate_nodes "$venv_name" "$archive_dir" ""

        # Activate via "conda shell.bash activate" which outputs shell code
        # to eval.  This avoids calling the conda shell function (which would
        # re-enter the cvenv wrapper and recurse infinitely).
        local rc
        _CV_PS1_BACKUP="$PS1"
        eval "$("$CV_CONDA" shell.bash activate "$target")"
        rc=$?
        [ "$rc" -eq 0 ] || { unset _CV_PS1_BACKUP; return "$rc"; }

        # Merge CRAY_LD_LIBRARY_PATH and conda env libs into LD_LIBRARY_PATH.
        if [ -n "${CONDA_PREFIX:-}" ] && [ -d "$CONDA_PREFIX/lib" ]; then
            _cv_augment_ld_path "$CONDA_PREFIX/lib"
        else
            _cv_augment_ld_path
        fi

        _cv_restore_env_vars "$target" ""

        _cv_conda_patch_deactivate "$venv_name" "$target" "$archive_dir" "$link_path"
        return 0
        ;;
    deactivate)
        if declare -f deactivate >/dev/null 2>&1 && [ -n "${_CV_ACTIVE_DIR:-}" ]; then
            deactivate
            return $?
        fi
        eval "$("$CV_CONDA" shell.bash deactivate)"
        return $?
        ;;
    install|remove|uninstall|update|upgrade)
        local rc
        "$CV_CONDA" "$@"
        rc=$?
        if [ "$rc" -eq 0 ] && [ -n "${_CV_ACTIVE_DIR:-}" ] && \
           [ "${CONDA_PREFIX:-}" = "$_CV_ACTIVE_DIR" ]; then
            _cv_patch_nccl "$_CV_ACTIVE_DIR" ""
            _cv_log "Saving environment changes after conda $_cv_conda_cmd"
            _cv_compress_venv "$_CV_ACTIVE_DIR" "$_CV_ACTIVE_ARCHIVE_DIR" || return $?
            _cv_propagate_nodes "$_CV_ACTIVE_NAME" "$_CV_ACTIVE_ARCHIVE_DIR" "" 1
        fi
        return "$rc"
        ;;
    *)
        "$CV_CONDA" "$@"
        return $?
        ;;
esac
]==], "")


-- uv: bare venv creation.
set_shell_function("_cv_uv_venv", [==[
local requested="$1"
shift

if [ -z "$requested" ]; then
    _cv_log "ERROR: no virtual-environment path specified"
    return 2
fi

local venv_name target archive_dir tarball link_path
venv_name=$(basename "${requested%/}")
if [ -z "$venv_name" ] || [ "$venv_name" = "." ] || [ "$venv_name" = ".." ]; then
    _cv_log "ERROR: invalid environment path: $requested"
    return 2
fi

archive_dir=$(_cv_archive_dir) || return 1
archive_dir=$(cd "$archive_dir" 2>/dev/null && pwd -P) || {
    _cv_log "ERROR: archive directory does not exist: $archive_dir"
    return 1
}
link_path="$PWD/$requested"
tarball="${archive_dir}/${venv_name}${CV_BACKEND_EXT}"
target="${CV_JOB_SCRATCH}/${venv_name}"

if [ -e "$requested" ] && [ ! -L "$requested" ]; then
    _cv_log "ERROR: path already exists and is not a cvenv symlink: $requested"
    return 1
fi

if [ -f "$tarball" ]; then
    _cv_decompress_venv "$venv_name" "$archive_dir" || return 1
else
    mkdir -p "$CV_JOB_SCRATCH" || return 1
    command rm -rf "$target"
    _cv_log "Creating environment in job scratch: $target"
    "$CV_UV" venv "$@" "$target" || {
        _cv_log "ERROR: virtual-environment creation failed"
        command rm -rf "$target"
        return 1
    }
    printf '%s\n' "$target" > "$target/.cvenv-prefix"
fi

_cv_patch_nccl "$target" ""
_cv_inject_ld_path "$target" ""
mkdir -p "$(dirname "$link_path")" || return 1
ln -sfn "$target" "$link_path" || return 1
_cv_compress_venv "$target" "$archive_dir" || _cv_log "WARNING: initial compression failed; will retry on deactivate"
unset _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR
_cv_log "Ready: $requested -> $target"
_cv_log "Run: source $requested/bin/activate"
return 0
]==], "")

-- uv: project creation.
set_shell_function("_cv_uv_init", [==[
local requested="$1"
shift

# uv init with no path initialises a project named after the current
# directory, mirroring native "uv init" behaviour.
if [ -z "$requested" ] || [ "$requested" = "." ]; then
    requested=$(basename "$PWD")
fi

local proj_name target archive_dir tarball link_path
proj_name=$(basename "${requested%/}")
if [ -z "$proj_name" ] || [ "$proj_name" = "." ] || [ "$proj_name" = ".." ]; then
    _cv_log "ERROR: invalid project path: $requested"
    return 2
fi

archive_dir=$(_cv_archive_dir) || return 1
archive_dir=$(cd "$archive_dir" 2>/dev/null && pwd -P) || {
    _cv_log "ERROR: archive directory does not exist: $archive_dir"
    return 1
}
# Resolve the link path whether requested is relative or absolute.
case "$requested" in
    /*) link_path="$requested" ;;
    *)  link_path="$PWD/$requested" ;;
esac
tarball="${archive_dir}/${proj_name}${CV_BACKEND_EXT}"
target="${CV_JOB_SCRATCH}/${proj_name}"

if [ -e "$requested" ] && [ ! -L "$requested" ]; then
    _cv_log "ERROR: path already exists and is not a cvenv symlink: $requested"
    return 1
fi

if [ -f "$tarball" ]; then
    _cv_decompress_venv "$proj_name" "$archive_dir" || return 1
else
    mkdir -p "$CV_JOB_SCRATCH" || return 1
    command rm -rf "$target"
    _cv_log "Creating uv project in job scratch: $target"
    "$CV_UV" init "$@" "$target" || {
        _cv_log "ERROR: uv init failed"
        command rm -rf "$target"
        return 1
    }
    printf '%s\n' "$target" > "$target/.cvenv-prefix"
    _cv_log "Creating .venv in project: $target/.venv"
    ( cd "$target" && "$CV_UV" venv .venv ) || {
        _cv_log "ERROR: venv creation failed for uv project"
        return 1
    }
fi

_cv_patch_nccl "$target" "/.venv"
_cv_inject_ld_path "$target" "/.venv"
mkdir -p "$(dirname "$link_path")" || return 1
ln -sfn "$target" "$link_path" || return 1
_cv_compress_venv "$target" "$archive_dir" || _cv_log "WARNING: initial compression failed; will retry on deactivate"
_cv_log "Ready: $requested -> $target"
_cv_log "Run: source $requested/.venv/bin/activate"
return 0
]==], "")

set_shell_function("_cv_uv_auto_activate", [==[
# Auto-activate a cvenv-managed .venv found by walking up from $PWD.
{ [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; } && return 0

local search_dir="$PWD"
local venv_dir=""
while [ "$search_dir" != "/" ]; do
    if [ -f "$search_dir/.venv/bin/activate" ]; then
        venv_dir="$search_dir/.venv"
        break
    fi
    search_dir=$(dirname "$search_dir")
done
[ -n "$venv_dir" ] || return 0

# If the activate file is a cvenv stub, the venv was archived on
# deactivation.  Use the source wrapper to decompress and activate.
if grep -q 'CVENV_STUB' "$venv_dir/bin/activate" 2>/dev/null; then
    source "$venv_dir/bin/activate" || return 0
    # source wrapper handled everything (decompress, activate, patch).
    return 0
fi

local target=""
if [ -L "$venv_dir" ]; then
    target=$(readlink -f "$venv_dir" 2>/dev/null) || target=""
fi
# Only activate cvenv-managed venvs (symlink into job scratch).
[ -n "$target" ] || return 0
case "$target" in
    "${CV_JOB_SCRATCH}"/*) ;;
    *) return 0 ;;
esac

local venv_name archive_dir link_path venv_subdir
archive_dir=$(_cv_archive_dir) || return 0
archive_dir=$(cd "$archive_dir" 2>/dev/null && pwd -P) || return 0
link_path="$venv_dir"

# Distinguish bare "uv venv" (.venv) from "uv init <proj>" (<proj>/.venv).
if [ "$(basename "$target")" = ".venv" ]; then
    local parent
    parent=$(dirname "$target")
    if [ "$parent" = "$CV_JOB_SCRATCH" ]; then
        # bare "uv venv"
        venv_name=".venv"
        venv_subdir=""
    else
        # "uv init <proj>": venv under /.venv
        venv_name=$(basename "$parent")
        target="$parent"
        venv_subdir="/.venv"
    fi
else
    venv_name=$(basename "$target")
    venv_subdir=""
fi

builtin source "$venv_dir/bin/activate" || return 0
_cv_augment_ld_path
_cv_restore_env_vars "$target" "$venv_subdir"

if [ "${VIRTUAL_ENV:-}" = "${target}${venv_subdir}" ]; then
    _cv_patch_deactivate "$venv_name" "$target" "$archive_dir" "$link_path" "$venv_subdir"
    unset _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR
    # Mark as auto-activated so cd auto-deactivates on leave.
    _CV_AUTO_ACTIVATED=1
    export _CV_AUTO_ACTIVATED
    _cv_log "Auto-activated $venv_dir for uv"
fi
return 0
]==], "")

set_shell_function("_cv_uv_discover_expand", [==[
# Walk up to find and expand a .venv archive so uv's own discovery finds it.
{ [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; } && return 0

local search_dir="$PWD"
while [ "$search_dir" != "/" ]; do
    if [ -e "$search_dir/.venv" ]; then
        return 0
    fi
    local tarball_dir
    if [ -n "${CV_ARCHIVE_DIR:-}" ]; then
        tarball_dir="$CV_ARCHIVE_DIR"
    else
        tarball_dir="$search_dir"
    fi
    local found_tarball="${tarball_dir}/.venv${CV_BACKEND_EXT}"
    if [ -f "$found_tarball" ]; then
        local target="${CV_JOB_SCRATCH}/.venv"
        if [ -d "$target" ]; then
            # scratch slot in use
            :
        else
            _cv_decompress_venv ".venv" "$tarball_dir" || return 1
        fi
        ln -sfn "$target" "$search_dir/.venv"
        _CV_EXPANDED_LINK="$search_dir/.venv"
        _CV_EXPANDED_DIR="$target"
        _CV_EXPANDED_ARCHIVE_DIR="$tarball_dir"
        export _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR
        return 0
    fi
    search_dir=$(dirname "$search_dir")
done
return 0
]==], "")

set_shell_function("_cv_uv_run_expand", [==[
# Expand a uv-init project archive so uv run can use the scratch venv.
{ [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; } && return 0

local run_dir="$PWD"
while [ "$run_dir" != "/" ] && [ ! -f "$run_dir/pyproject.toml" ]; do
    run_dir=$(dirname "$run_dir")
done
[ -f "$run_dir/pyproject.toml" ] || return 0

local proj_name archive_dir tarball target
proj_name=$(basename "$run_dir")
archive_dir=$(_cv_archive_dir) || true
[ -n "$archive_dir" ] || archive_dir="$PWD"
tarball="${archive_dir}/${proj_name}${CV_BACKEND_EXT}"
target="${CV_JOB_SCRATCH}/${proj_name}"

# venv already reachable
if [ -d "$run_dir/.venv" ]; then
    return 0
fi

# Decompress and (re)create the project symlink.
if [ -f "$tarball" ]; then
    _cv_decompress_venv "$proj_name" "$archive_dir" || return 1
    local link_target="$run_dir"
    # If inside the project, symlink from ../<proj_name>.
    case "$run_dir" in
        "$PWD"|"$PWD/")
            link_target="$(dirname "$PWD")/$proj_name"
            ;;
    esac
    ln -sfn "$target" "$link_target"
    _CV_EXPANDED_LINK="$link_target"
    _CV_EXPANDED_DIR="$target"
    _CV_EXPANDED_ARCHIVE_DIR="$archive_dir"
    export _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR
fi
return 0
]==], "")

-- uv: main wrapper.
set_shell_function("uv", [==[
# Ensure UV_CACHE_DIR is set.
if [ -z "${UV_CACHE_DIR:-}" ]; then
    export UV_CACHE_DIR="${CV_JOB_SCRATCH}-uv-cache"
fi
mkdir -p "$UV_CACHE_DIR" 2>/dev/null

# Locate uv if not detected at module load time.
if [ -z "${CV_UV:-}" ]; then
    CV_UV=$(type -P uv 2>/dev/null)
    if [ -z "$CV_UV" ]; then
        _cv_log "ERROR: uv is not available"
        return 127
    fi
fi

local _cv_uv_cmd="${1:-}"

# Only venv-consuming subcommands get auto-expansion; others pass through.
case "$_cv_uv_cmd" in
    pip|add|remove|sync|run|tree|tool|export|lock|python|x|venv|init) ;;
    *)
        if [ -z "${CV_UV:-}" ]; then
            CV_UV=$(type -P uv 2>/dev/null)
        fi
        "$CV_UV" "$@"
        return $?
        ;;
esac

# Auto-expand a .venv archive in $PWD if no venv (or conda env) is active.
if [ -z "${VIRTUAL_ENV:-}" ] && [ -z "${CONDA_PREFIX:-}" ] && [ "$_cv_uv_cmd" != "venv" ] && [ "$_cv_uv_cmd" != "init" ]; then
    # Clean up stale expansion if its symlink is gone, but never remove a
    # scratch dir that $PWD/.venv still points to (it may be a fresh venv).
    if [ -n "${_CV_EXPANDED_LINK:-}" ] && [ ! -e "$_CV_EXPANDED_LINK" ]; then
        local _cv_pwd_target=""
        [ -L "$PWD/.venv" ] && _cv_pwd_target=$(readlink -f "$PWD/.venv" 2>/dev/null) || true
        if [ -z "$_cv_pwd_target" ] || [ "$_cv_pwd_target" != "$_CV_EXPANDED_DIR" ]; then
            command rm -rf "$_CV_EXPANDED_DIR"
        fi
        unset _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR
    fi
    if [ ! -e "$PWD/.venv" ]; then
        local _cv_tarball_dir
        if [ -n "${CV_ARCHIVE_DIR:-}" ]; then
            _cv_tarball_dir="$CV_ARCHIVE_DIR"
        else
            _cv_tarball_dir="$PWD"
        fi
        local _cv_found_tarball="${_cv_tarball_dir}/.venv${CV_BACKEND_EXT}"
        if [ -f "$_cv_found_tarball" ]; then
            _cv_decompress_venv ".venv" "$_cv_tarball_dir" || return 1
            ln -sfn "${CV_JOB_SCRATCH}/.venv" "$PWD/.venv"
            # Track for cd/pushd/popd cleanup.
            _CV_EXPANDED_LINK="$PWD/.venv"
            _CV_EXPANDED_DIR="${CV_JOB_SCRATCH}/.venv"
            _CV_EXPANDED_ARCHIVE_DIR="$_cv_tarball_dir"
            export _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR
        fi
    fi
fi

# Auto-activate a local .venv for mutating uv commands and uv run.
if [ -z "${VIRTUAL_ENV:-}" ] && [ -z "${CONDA_PREFIX:-}" ]; then
    local _cv_auto_deactivate=0
    case "$_cv_uv_cmd" in
        pip)
            local _cv_uv_subcmd="${2:-}"
            # Expand a parent .venv archive for uv's own discovery.
            _cv_uv_discover_expand
            case "$_cv_uv_subcmd" in
                install|uninstall) _cv_uv_auto_activate ;;
            esac
            ;;
        add|remove|sync) _cv_uv_auto_activate ;;
        run)
            # Expand project archive before activation.
            _cv_uv_run_expand
            _cv_uv_auto_activate
            ;;
    esac
    # Mark for auto-deactivation after the command if we auto-activated.
    if [ -n "${_CV_AUTO_ACTIVATED:-}" ] && [ -n "${VIRTUAL_ENV:-}" ]; then
        _cv_auto_deactivate=1
    fi
fi

# uv venv <path> -> create a bare venv in scratch.
if [ "$_cv_uv_cmd" = "venv" ]; then
    shift
    local requested=""
    local -a passthrough=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -*)
                passthrough+=("$1")
                ;;
            *)
                if [ -z "$requested" ]; then
                    requested="$1"
                else
                    passthrough+=("$1")
                fi
                ;;
        esac
        shift
    done
    [ -n "$requested" ] || requested=".venv"
    _cv_uv_venv "$requested" "${passthrough[@]}"
    return $?
fi

# uv init <path> -> create a project (with .venv) in scratch.
if [ "$_cv_uv_cmd" = "init" ]; then
    shift
    local requested=""
    local -a passthrough=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -*)
                passthrough+=("$1")
                ;;
            *)
                if [ -z "$requested" ]; then
                    requested="$1"
                else
                    passthrough+=("$1")
                fi
                ;;
        esac
        shift
    done
    [ -n "$requested" ] || requested="."
    _cv_uv_init "$requested" "${passthrough[@]}"
    return $?
fi

# Pass through to real uv.
local rc
"$CV_UV" "$@"
rc=$?

if [ "$rc" -eq 0 ] && [ -n "${_CV_ACTIVE_DIR:-}" ]; then
    if [ "$VIRTUAL_ENV" = "${_CV_ACTIVE_DIR}${_CV_ACTIVE_VENV_SUBDIR:-}" ]; then
        local _cv_save=0
        case "$_cv_uv_cmd" in
            pip)
                case "${2:-}" in
                    install|uninstall) _cv_save=1 ;;
                esac
                ;;
            add|remove|sync) _cv_save=1 ;;
        esac
        if [ "$_cv_save" -eq 1 ]; then
            if [ "${_cv_auto_deactivate:-0}" = "1" ]; then
                # deactivate() below will archive; skip the redundant save.
                :
            else
                _cv_patch_nccl "$_CV_ACTIVE_DIR" "${_CV_ACTIVE_VENV_SUBDIR:-}"
                _cv_log "Saving environment changes after uv $_cv_uv_cmd ${2:-}"
                _cv_compress_venv "$_CV_ACTIVE_DIR" "$_CV_ACTIVE_ARCHIVE_DIR" || return $?
                _cv_propagate_nodes "$_CV_ACTIVE_NAME" "$_CV_ACTIVE_ARCHIVE_DIR" "${_CV_ACTIVE_VENV_SUBDIR:-}" 1
            fi
        fi
    fi
fi

# Auto-deactivate if we auto-activated for this command (success only).
if [ "$rc" -eq 0 ] && [ "${_cv_auto_deactivate:-0}" = "1" ] && [ -n "${VIRTUAL_ENV:-}" ]; then
    _cv_log "uv $_cv_uv_cmd finished; auto-deactivating ${_CV_ACTIVE_NAME:-venv}"
    # uv run does not install packages directly; skip recompression on
    # exit unless the user disabled CVENV_RO.  Mutating commands (add,
    # remove, sync, pip install) already forced a save above.
    if [ "$_cv_uv_cmd" = "run" ] && [ "${CVENV_RO:-1}" != "0" ]; then
        CVENV_RO=1
        export CVENV_RO
    fi
    deactivate
fi
return "$rc"
]==], "")

-- cd/pushd/popd: auto-deactivate when leaving the venv directory.
set_shell_function("cd", [==[
local _cv_prev="$PWD"
builtin cd "$@" || return $?
# Clean up expanded venv when leaving its directory.
if [ -n "${_CV_EXPANDED_LINK:-}" ]; then
    local _cv_exp_root
    _cv_exp_root=$(dirname "$_CV_EXPANDED_LINK")
    if [ "$PWD" != "$_cv_exp_root" ]; then
        if [ -d "$_CV_EXPANDED_DIR" ]; then
            _cv_log "Left $_cv_exp_root; archiving expanded .venv"
            _cv_compress_venv "$_CV_EXPANDED_DIR" "$_CV_EXPANDED_ARCHIVE_DIR" || true
        else
            _cv_log "Left $_cv_exp_root; scratch venv already removed"
        fi
        [ -L "$_CV_EXPANDED_LINK" ] && command rm -f "$_CV_EXPANDED_LINK"
        command rm -rf "$_CV_EXPANDED_DIR" 2>/dev/null || true
        _cv_scratch_cleanup
        unset _CV_EXPANDED_LINK _CV_EXPANDED_DIR _CV_EXPANDED_ARCHIVE_DIR
    fi
fi
if [ -n "${_CV_AUTO_ACTIVATED:-}" ] && [ -n "${_CV_ACTIVE_LINK:-}" ] && \
   { [ -n "${VIRTUAL_ENV:-}" ] || [ -n "${CONDA_PREFIX:-}" ]; }; then
    local _cv_venv_root
    _cv_venv_root=$(dirname "$_CV_ACTIVE_LINK")
    if [ "$PWD" != "$_cv_venv_root" ]; then
        _cv_log "Left $_cv_venv_root; auto-deactivating ${_CV_ACTIVE_NAME}"
        deactivate
    fi
fi
return 0
]==], "")

set_shell_function("pushd", [==[
local _cv_prev="$PWD"
builtin pushd "$@" || return $?
# Clean up expanded venv when leaving its directory.
if [ -n "${_CV_EXPANDED_LINK:-}" ]; then
    local _cv_exp_root
    _cv_exp_root=$(dirname "$_CV_EXPANDED_LINK")
    if [ "$PWD" != "$_cv_exp_root" ]; then
        if [ -d "$_CV_EXPANDED_DIR" ]; then
            _cv_log "Left $_cv_exp_root; archiving expanded .venv"
            _cv_compress_venv "$_CV_EXPANDED_DIR" "$_CV_EXPANDED_ARCHIVE_DIR" || true
        else
            _cv_log "Left $_cv_exp_root; scratch venv already removed"
        fi
